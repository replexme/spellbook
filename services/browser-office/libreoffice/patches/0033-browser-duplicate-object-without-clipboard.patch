+CPPUNIT_TEST_FIXTURE(SdUiImpressTest, testSpellbookDuplicateObjectUsesOneNativeUndo)
+{
+    createSdImpressDocModelOnly();
+    auto pDocument = dynamic_cast<SdXImpressDocument*>(mxComponent.get());
+    CPPUNIT_ASSERT(pDocument);
+    SdDrawDocument* pDrawDocument = pDocument->GetDoc();
+    SdPage* pPage = pDrawDocument->GetSdPage(0, PageKind::Standard);
+    CPPUNIT_ASSERT(pPage);
+    uno::Reference<drawing::XDrawPagesSupplier> xPagesSupplier(mxComponent,
+                                                               uno::UNO_QUERY_THROW);
+    uno::Reference<drawing::XShapes> xShapes(xPagesSupplier->getDrawPages()->getByIndex(0),
+                                             uno::UNO_QUERY_THROW);
+    uno::Reference<lang::XMultiServiceFactory> xFactory(mxComponent, uno::UNO_QUERY_THROW);
+    uno::Reference<drawing::XShape> xShape(
+        xFactory->createInstance("com.sun.star.drawing.RectangleShape"), uno::UNO_QUERY_THROW);
+    xShape->setPosition(awt::Point(1000, 1000));
+    xShape->setSize(awt::Size(4000, 2000));
+    xShapes->add(xShape);
+    uno::Reference<beans::XPropertySet> xProperties(xShape, uno::UNO_QUERY_THROW);
+    xProperties->setPropertyValue("Name", uno::Any(u"Box"_ustr));
+    xProperties->setPropertyValue("FillColor", uno::Any(sal_Int32(0x4F46E5)));
+    SdrObject* pSource = SdrObject::getSdrObjectFromXShape(xShape);
+    CPPUNIT_ASSERT(pSource);
+    const size_t nCount = pPage->GetObjCount();
+    const size_t nSourceOrder = pSource->GetOrdNum();
+
+    auto* pUndoManager = pDrawDocument->GetDocSh()->GetUndoManager();
+    pUndoManager->Clear();
+    // The browser runtime has no system clipboard, so Copy and Paste
+    // inserted nothing there.
+    pDrawDocument->BegUndo("Browser duplicate");
+    xProperties->setPropertyValue("SpellbookDuplicateObject", uno::Any(true));
+    pDrawDocument->EndUndo();
+
+    CPPUNIT_ASSERT_EQUAL(size_t(1), pUndoManager->GetUndoActionCount());
+    CPPUNIT_ASSERT_EQUAL(nCount + 1, pPage->GetObjCount());
+    SdrObject* pCopy = pPage->GetObj(nSourceOrder + 1);
+    CPPUNIT_ASSERT(pCopy && pCopy != pSource);
+    CPPUNIT_ASSERT(pCopy->GetName() != pSource->GetName());
+    CPPUNIT_ASSERT(pCopy->GetSnapRect() == pSource->GetSnapRect());
+    uno::Reference<beans::XPropertySet> xCopy(pCopy->getUnoShape(), uno::UNO_QUERY_THROW);
+    CPPUNIT_ASSERT_EQUAL(sal_Int32(0x4F46E5), xCopy->getPropertyValue("FillColor").get<sal_Int32>());
+
+    pUndoManager->Undo();
+    CPPUNIT_ASSERT_EQUAL(nCount, pPage->GetObjCount());
+    pUndoManager->Redo();
+    CPPUNIT_ASSERT_EQUAL(nCount + 1, pPage->GetObjCount());
+}
