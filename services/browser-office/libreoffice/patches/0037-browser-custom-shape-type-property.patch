+CPPUNIT_TEST_FIXTURE(SdUiImpressTest, testSpellbookCustomShapeTypeIsObservable)
+{
+    createSdImpressDocModelOnly();
+    uno::Reference<drawing::XDrawPagesSupplier> xPagesSupplier(mxComponent,
+                                                               uno::UNO_QUERY_THROW);
+    uno::Reference<drawing::XShapes> xShapes(xPagesSupplier->getDrawPages()->getByIndex(0),
+                                             uno::UNO_QUERY_THROW);
+    uno::Reference<lang::XMultiServiceFactory> xFactory(mxComponent, uno::UNO_QUERY_THROW);
+    uno::Reference<drawing::XShape> xRectangle(
+        xFactory->createInstance("com.sun.star.drawing.RectangleShape"), uno::UNO_QUERY_THROW);
+    xShapes->add(xRectangle);
+    uno::Reference<drawing::XShape> xShape(
+        xFactory->createInstance("com.sun.star.drawing.CustomShape"), uno::UNO_QUERY_THROW);
+    xShapes->add(xShape);
+    uno::Reference<beans::XPropertySet> xProperties(xShape, uno::UNO_QUERY_THROW);
+
+    // Not a custom shape, and a custom shape without geometry: no type.
+    CPPUNIT_ASSERT_EQUAL(OUString(), uno::Reference<beans::XPropertySet>(
+                                         xRectangle, uno::UNO_QUERY_THROW)
+                                         ->getPropertyValue("SpellbookCustomShapeType")
+                                         .get<OUString>());
+    CPPUNIT_ASSERT_EQUAL(OUString(),
+                         xProperties->getPropertyValue("SpellbookCustomShapeType").get<OUString>());
+
+    // Every custom shape reports its type, not only WordArt.
+    xProperties->setPropertyValue(
+        "CustomShapeGeometry",
+        uno::Any(comphelper::InitPropertySequence({ { "Type", uno::Any(u"ooxml-rect"_ustr) } })));
+    CPPUNIT_ASSERT_EQUAL(u"ooxml-rect"_ustr,
+                         xProperties->getPropertyValue("SpellbookCustomShapeType").get<OUString>());
+    CPPUNIT_ASSERT_EQUAL(OUString(),
+                         xProperties->getPropertyValue("SpellbookFontworkShapeType").get<OUString>());
+}
