{
  "name": "spellbook",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted AI workspace for editing existing documents in their native format.",
  "license": "MPL-2.0",
  "packageManager": "pnpm@10.26.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "browser-office:fetch": "node services/browser-office/fetch-runtime.mjs",
    "browser-office:build": "node services/browser-office/build-harness.mjs",
    "browser-office:engine:verify": "node services/browser-office/libreoffice/verify-source.mjs",
    "browser-office:prepare": "pnpm browser-office:fetch && pnpm browser-office:build",
    "browser-office:serve": "pnpm browser-office:prepare && node services/browser-office/server.mjs",
    "browser-office:verify": "pnpm browser-office:prepare && node services/browser-office/verify-harness.mjs",
    "browser-office:verify:product": "pnpm browser-office:prepare && node services/browser-office/verify-product-bridge.mjs",
    "browser-office:verify:native-conformance": "pnpm browser-office:prepare && node services/browser-office/verify-native-conformance.mjs",
    "browser-office:verify:candidate-powerpoint": "dotnet build services/document-worker/tools/Spellbook.Document.Tool/Spellbook.Document.Tool.csproj --configuration Release && node services/browser-office/verify-candidate-powerpoint.mjs",
    "browser-office:promote:candidate": "node services/browser-office/candidate-promotion.mjs",
    "browser-office:verify:powerpoint": "pnpm browser-office:verify && node services/browser-office/verify-powerpoint.mjs",
    "corpus:discover": "node scripts/create-corpus-manifest.mjs",
    "corpus:fetch-public": "node scripts/fetch-public-corpus.mjs",
    "corpus:roundtrip-public": "node scripts/evaluate-public-roundtrip.mjs",
    "corpus:evaluate": "node scripts/evaluate-render-corpus.mjs",
    "corpus:compare": "node scripts/compare-render-reports.mjs",
    "corpus:analyze-differences": "python3 scripts/analyze-render-differences.py",
    "corpus:compare-structures": "python3 scripts/compare-render-structures.py",
    "corpus:review-structures": "python3 scripts/build-structure-regression-montages.py",
    "corpus:references:powerpoint": "node scripts/export-powerpoint-references.mjs",
    "corpus:recompare": "node scripts/recompare-render-report.mjs",
    "connector:build": "pnpm --filter @spellbook/ai-connector build",
    "connector:package:macos": "node scripts/build-macos-connector.mjs",
    "connector:start": "pnpm connector:build && node --env-file-if-exists=.env scripts/start-local-connector.mjs",
    "connector:verify:claude": "pnpm connector:build && node scripts/verify-claude-code-connector.mjs",
    "docker:cleanup": "node scripts/cleanup-local-docker.mjs",
    "office:engine:audit": "node services/office-editor/libreoffice/audit-all.mjs",
    "office:engine:admit": "node services/office-editor/libreoffice/admit-source-candidate.mjs",
    "office:engine:build": "bash services/office-editor/libreoffice/build-engine.sh",
    "office:engine:verify-patches": "bash services/office-editor/libreoffice/verify-patch.sh",
    "office:conformance:plan": "node scripts/native-mutation-conformance.mjs",
    "office:conformance:run": "node scripts/native-mutation-conformance-runner.mjs",
    "office:conformance:merge": "node scripts/merge-native-conformance-reports.mjs",
    "office:editor:corpus": "node scripts/evaluate-office-editor-corpus.mjs",
    "office:runtime:build": "bash services/office-editor/libreoffice/build-runtime.sh",
    "office:runtime:build:candidate": "bash services/office-editor/libreoffice/build-candidate-runtime.sh",
    "office:runtime:promote": "node scripts/promote-native-runtime-evidence.mjs",
    "office:runtime:validate": "node scripts/write-office-runtime-validation.mjs",
    "dev": "pnpm --filter @spellbook/web dev",
    "format:check": "prettier --check .",
    "test": "pnpm test:boundary && pnpm test:docs && pnpm test:contracts && pnpm test:harness && pnpm test:office && pnpm -r --if-present test && dotnet test services/document-worker/Spellbook.Document.Worker.slnx --configuration Release",
    "test:boundary": "node scripts/check-public-boundary.mjs",
    "test:docs": "node scripts/check-docs.mjs",
    "test:contracts": "node scripts/validate-contracts.mjs",
    "test:harness": "node --test scripts/*.test.mjs",
    "test:office": "pnpm --filter @spellbook/ai-connector build && node --test services/office-editor/*.test.mjs services/office-editor/libreoffice/*.test.mjs services/office-session-spike/*.test.mjs services/browser-office/*.test.mjs services/browser-office/libreoffice/*.test.mjs && node scripts/test-office-gateway.mjs",
    "test:e2e": "pnpm --filter @spellbook/web test:e2e",
    "test:selfhost": "pnpm --filter @spellbook/web test:selfhost",
    "typecheck": "pnpm -r --if-present typecheck",
    "verify": "pnpm test && pnpm typecheck && pnpm build",
    "selfhost:doctor": "node scripts/selfhost-doctor.mjs",
    "selfhost:setup": "node scripts/selfhost-setup.mjs",
    "selfhost:backup": "node scripts/selfhost-backup.mjs",
    "selfhost:verify:storage-pressure": "node scripts/verify-storage-pressure.mjs",
    "selfhost:verify:worker-storage-pressure": "node scripts/verify-document-worker-storage-pressure.mjs",
    "selfhost:restore": "node scripts/selfhost-restore.mjs",
    "selfhost:up": "node scripts/selfhost-up.mjs",
    "selfhost:down": "docker compose --profile wopi --profile browser down",
    "browser-office:verify:distribution": "node services/browser-office/distribution-check.mjs",
    "browser-office:onlyoffice:bundle": "node services/browser-office/onlyoffice/build-workspace.mjs",
    "browser-office:onlyoffice:serve": "node services/browser-office/onlyoffice/serve-workspace.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@xmldom/xmldom": "0.9.12",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "postject": "1.0.0-alpha.6",
    "prettier": "3.6.2"
  }
}
