+std::vector<uno::Reference<xml::dom::XElement>>
+lcl_spellbookDiagramChildren(const uno::Reference<xml::dom::XNode>& xParent,
+                             const OUString& rNamespace, const OUString& rLocalName)
+{
+    std::vector<uno::Reference<xml::dom::XElement>> aChildren;
+    for (uno::Reference<xml::dom::XNode> xChild = xParent->getFirstChild(); xChild.is();
+         xChild = xChild->getNextSibling())
+    {
+        if (xChild->getNodeType() == xml::dom::NodeType_ELEMENT_NODE
+            && xChild->getNamespaceURI() == rNamespace && xChild->getLocalName() == rLocalName)
+            aChildren.emplace_back(xChild, uno::UNO_QUERY);
+    }
+    return aChildren;
+}
+
+uno::Reference<xml::dom::XElement>
+lcl_spellbookDiagramChild(const uno::Reference<xml::dom::XNode>& xParent,
+                          const OUString& rNamespace, const OUString& rLocalName)
+{
+    const auto aChildren = lcl_spellbookDiagramChildren(xParent, rNamespace, rLocalName);
+    return aChildren.empty() ? uno::Reference<xml::dom::XElement>() : aChildren.front();
+}
+
+OUString lcl_spellbookDiagramTypeName(svx::diagram::TypeConstant eType)
+{
+    switch (eType)
+    {
+        case svx::diagram::TypeConstant::XML_doc:
+            return u"doc"_ustr;
+        case svx::diagram::TypeConstant::XML_node:
+            return u"node"_ustr;
+        case svx::diagram::TypeConstant::XML_asst:
+            return u"asst"_ustr;
+        case svx::diagram::TypeConstant::XML_parTrans:
+            return u"parTrans"_ustr;
+        case svx::diagram::TypeConstant::XML_sibTrans:
+            return u"sibTrans"_ustr;
+        case svx::diagram::TypeConstant::XML_pres:
+            return u"pres"_ustr;
+        case svx::diagram::TypeConstant::XML_parOf:
+            return u"parOf"_ustr;
+        case svx::diagram::TypeConstant::XML_presOf:
+            return u"presOf"_ustr;
+        case svx::diagram::TypeConstant::XML_presParOf:
+            return u"presParOf"_ustr;
+        default:
+            return OUString();
+    }
+}
+
+// Model data the engine adds has no ids for connections or transition
+// points. Derive stable GUIDs so every save of the same diagram is identical.
+OUString lcl_spellbookDerivedDiagramId(const OUString& rKey)
+{
+    const OString aKey = OUStringToOString(rKey, RTL_TEXTENCODING_UTF8);
+    const std::vector<unsigned char> aHash = comphelper::Hash::calculateHash(
+        reinterpret_cast<const unsigned char*>(aKey.getStr()), aKey.getLength(),
+        comphelper::HashType::SHA1);
+    static constexpr char aHexDigits[] = "0123456789ABCDEF";
+    OStringBuffer aId("{");
+    for (size_t nByte = 0; nByte < 16; ++nByte)
+    {
+        if (nByte == 4 || nByte == 6 || nByte == 8 || nByte == 10)
+            aId.append('-');
+        aId.append(aHexDigits[aHash[nByte] >> 4]);
+        aId.append(aHexDigits[aHash[nByte] & 0xF]);
+    }
+    aId.append('}');
+    return OStringToOUString(aId.makeStringAndClear(), RTL_TEXTENCODING_ASCII_US);
+}
+
+OUString lcl_spellbookDiagramConnectionId(const svx::diagram::Connection& rConnection)
+{
+    if (!rConnection.msModelId.isEmpty())
+        return rConnection.msModelId;
+    const OUString aKey = OUString::number(static_cast<sal_Int32>(rConnection.mnXMLType)) + "|"
+                          + rConnection.msSourceId + "|" + rConnection.msDestId + "|"
+                          + OUString::number(rConnection.mnSourceOrder);
+    return lcl_spellbookDerivedDiagramId(aKey);
+}
+
+// The imported model keeps a node's text as the first run of its first
+// paragraph (oox::drawingml::TextBody::toString).
+OUString lcl_spellbookDiagramPointText(const uno::Reference<xml::dom::XElement>& xPoint)
+{
+    const auto xText
+        = lcl_spellbookDiagramChild(xPoint, gaSpellbookDiagramNamespace, u"t"_ustr);
+    if (!xText.is())
+        return OUString();
+    const auto xParagraph
+        = lcl_spellbookDiagramChild(xText, gaSpellbookDrawingNamespace, u"p"_ustr);
+    if (!xParagraph.is())
+        return OUString();
+    const auto xRun = lcl_spellbookDiagramChild(xParagraph, gaSpellbookDrawingNamespace, u"r"_ustr);
+    if (!xRun.is())
+        return OUString();
+    const auto xRunText = lcl_spellbookDiagramChild(xRun, gaSpellbookDrawingNamespace, u"t"_ustr);
+    if (!xRunText.is())
+        return OUString();
+    OUStringBuffer aText;
+    for (uno::Reference<xml::dom::XNode> xChild = xRunText->getFirstChild(); xChild.is();
+         xChild = xChild->getNextSibling())
+        if (xChild->getNodeType() == xml::dom::NodeType_TEXT_NODE)
+            aText.append(xChild->getNodeValue());
+    return aText.makeStringAndClear();
+}
+
+// A node's text in the model is one run. Keep the first paragraph's and first
+// run's properties so the node keeps its formatting.
+void lcl_setSpellbookDiagramPointText(const uno::Reference<xml::dom::XDocument>& xDocument,
+                                      const uno::Reference<xml::dom::XElement>& xPoint,
+                                      const OUString& rText)
+{
+    uno::Reference<xml::dom::XNode> xParagraphProperties;
+    uno::Reference<xml::dom::XNode> xRunProperties;
+    uno::Reference<xml::dom::XElement> xText
+        = lcl_spellbookDiagramChild(xPoint, gaSpellbookDiagramNamespace, u"t"_ustr);
+    if (xText.is())
+    {
+        const auto aParagraphs
+            = lcl_spellbookDiagramChildren(xText, gaSpellbookDrawingNamespace, u"p"_ustr);
+        if (!aParagraphs.empty())
+        {
+            if (const auto xProperties = lcl_spellbookDiagramChild(
+                    aParagraphs.front(), gaSpellbookDrawingNamespace, u"pPr"_ustr);
+                xProperties.is())
+                xParagraphProperties = xProperties->cloneNode(true);
+            if (const auto xRun = lcl_spellbookDiagramChild(
+                    aParagraphs.front(), gaSpellbookDrawingNamespace, u"r"_ustr);
+                xRun.is())
+                if (const auto xProperties = lcl_spellbookDiagramChild(
+                        xRun, gaSpellbookDrawingNamespace, u"rPr"_ustr);
+                    xProperties.is())
+                    xRunProperties = xProperties->cloneNode(true);
+        }
+        for (const auto& xParagraph : aParagraphs)
+            xText->removeChild(xParagraph);
+    }
+    else
+    {
+        xText = xDocument->createElementNS(gaSpellbookDiagramNamespace, u"dgm:t"_ustr);
+        xText->appendChild(
+            xDocument->createElementNS(gaSpellbookDrawingNamespace, u"a:bodyPr"_ustr));
+        xText->appendChild(
+            xDocument->createElementNS(gaSpellbookDrawingNamespace, u"a:lstStyle"_ustr));
+        // dgm:t precedes the point's optional dgm:extLst.
+        if (const auto xExtensions
+            = lcl_spellbookDiagramChild(xPoint, gaSpellbookDiagramNamespace, u"extLst"_ustr);
+            xExtensions.is())
+            xPoint->insertBefore(xText, xExtensions);
+        else
+            xPoint->appendChild(xText);
+    }
+    const uno::Reference<xml::dom::XElement> xParagraph
+        = xDocument->createElementNS(gaSpellbookDrawingNamespace, u"a:p"_ustr);
+    if (xParagraphProperties.is())
+        xParagraph->appendChild(xParagraphProperties);
+    if (!rText.isEmpty())
+    {
+        const uno::Reference<xml::dom::XElement> xRun
+            = xDocument->createElementNS(gaSpellbookDrawingNamespace, u"a:r"_ustr);
+        if (xRunProperties.is())
+            xRun->appendChild(xRunProperties);
+        const uno::Reference<xml::dom::XElement> xRunText
+            = xDocument->createElementNS(gaSpellbookDrawingNamespace, u"a:t"_ustr);
+        xRunText->appendChild(xDocument->createTextNode(rText));
+        xRun->appendChild(xRunText);
+        xParagraph->appendChild(xRun);
+    }
+    xText->appendChild(xParagraph);
+}
+
+uno::Reference<xml::dom::XElement>
+lcl_createSpellbookDiagramPoint(const uno::Reference<xml::dom::XDocument>& xDocument,
+                                const OUString& rId, const OUString& rType,
+                                const OUString& rConnectionId)
+{
+    const uno::Reference<xml::dom::XElement> xPoint
+        = xDocument->createElementNS(gaSpellbookDiagramNamespace, u"dgm:pt"_ustr);
+    xPoint->setAttribute(u"modelId"_ustr, rId);
+    if (!rType.isEmpty() && rType != "node")
+        xPoint->setAttribute(u"type"_ustr, rType);
+    if (!rConnectionId.isEmpty())
+        xPoint->setAttribute(u"cxnId"_ustr, rConnectionId);
+    return xPoint;
+}
+
+void lcl_appendSpellbookDiagramPoint(const uno::Reference<xml::dom::XDocument>& xDocument,
+                                     const uno::Reference<xml::dom::XElement>& xPointList,
+                                     const svx::diagram::Point& rPoint, bool bTextPoint,
+                                     const OUString& rText)
+{
+    const uno::Reference<xml::dom::XElement> xPoint = lcl_createSpellbookDiagramPoint(
+        xDocument, rPoint.msModelId, lcl_spellbookDiagramTypeName(rPoint.mnXMLType),
+        rPoint.msCnxId);
+    const uno::Reference<xml::dom::XElement> xProperties
+        = xDocument->createElementNS(gaSpellbookDiagramNamespace, u"dgm:prSet"_ustr);
+    if (!rPoint.msPresentationAssociationId.isEmpty())
+        xProperties->setAttribute(u"presAssocID"_ustr, rPoint.msPresentationAssociationId);
+    if (!rPoint.msPresentationLayoutName.isEmpty())
+        xProperties->setAttribute(u"presName"_ustr, rPoint.msPresentationLayoutName);
+    if (!rPoint.msPresentationLayoutStyleLabel.isEmpty())
+        xProperties->setAttribute(u"presStyleLbl"_ustr, rPoint.msPresentationLayoutStyleLabel);
+    if (rPoint.mnLayoutStyleIndex >= 0)
+        xProperties->setAttribute(u"presStyleIdx"_ustr,
+                                  OUString::number(rPoint.mnLayoutStyleIndex));
+    if (rPoint.mnLayoutStyleCount >= 0)
+        xProperties->setAttribute(u"presStyleCnt"_ustr,
+                                  OUString::number(rPoint.mnLayoutStyleCount));
+    xPoint->appendChild(xProperties);
+    xPoint->appendChild(
+        xDocument->createElementNS(gaSpellbookDiagramNamespace, u"dgm:spPr"_ustr));
+    if (bTextPoint)
+        lcl_setSpellbookDiagramPointText(xDocument, xPoint, rText);
+    xPointList->appendChild(xPoint);
+}
+
+// PowerPoint gives every parent-child connection its own transition points;
+// a node the engine added has none.
+OUString lcl_appendSpellbookDiagramTransition(
+    const uno::Reference<xml::dom::XDocument>& xDocument,
+    const uno::Reference<xml::dom::XElement>& xPointList, const OUString& rConnectionId,
+    const OUString& rType)
+{
+    const OUString aId = lcl_spellbookDerivedDiagramId(rConnectionId + "|" + rType);
+    const uno::Reference<xml::dom::XElement> xPoint
+        = lcl_createSpellbookDiagramPoint(xDocument, aId, rType, rConnectionId);
+    xPoint->appendChild(
+        xDocument->createElementNS(gaSpellbookDiagramNamespace, u"dgm:prSet"_ustr));
+    xPoint->appendChild(
+        xDocument->createElementNS(gaSpellbookDiagramNamespace, u"dgm:spPr"_ustr));
+    lcl_setSpellbookDiagramPointText(xDocument, xPoint, OUString());
+    xPointList->appendChild(xPoint);
+    return aId;
+}
+
+void lcl_appendSpellbookDiagramConnection(
+    const uno::Reference<xml::dom::XDocument>& xDocument,
+    const uno::Reference<xml::dom::XElement>& xPointList,
+    const uno::Reference<xml::dom::XElement>& xConnectionList,
+    const svx::diagram::Connection& rConnection, const OUString& rId)
+{
+    const uno::Reference<xml::dom::XElement> xConnection
+        = xDocument->createElementNS(gaSpellbookDiagramNamespace, u"dgm:cxn"_ustr);
+    xConnection->setAttribute(u"modelId"_ustr, rId);
+    const OUString aType = lcl_spellbookDiagramTypeName(rConnection.mnXMLType);
+    if (!aType.isEmpty() && aType != "parOf")
+        xConnection->setAttribute(u"type"_ustr, aType);
+    xConnection->setAttribute(u"srcId"_ustr, rConnection.msSourceId);
+    xConnection->setAttribute(u"destId"_ustr, rConnection.msDestId);
+    xConnection->setAttribute(u"srcOrd"_ustr, OUString::number(rConnection.mnSourceOrder));
+    xConnection->setAttribute(u"destOrd"_ustr, OUString::number(rConnection.mnDestOrder));
+    OUString aParentTransition = rConnection.msParTransId;
+    OUString aSiblingTransition = rConnection.msSibTransId;
+    if (rConnection.mnXMLType == svx::diagram::TypeConstant::XML_parOf)
+    {
+        if (aParentTransition.isEmpty())
+            aParentTransition = lcl_appendSpellbookDiagramTransition(xDocument, xPointList, rId,
+                                                                      u"parTrans"_ustr);
+        if (aSiblingTransition.isEmpty())
+            aSiblingTransition = lcl_appendSpellbookDiagramTransition(xDocument, xPointList, rId,
+                                                                       u"sibTrans"_ustr);
+    }
+    if (!aParentTransition.isEmpty())
+        xConnection->setAttribute(u"parTransId"_ustr, aParentTransition);
+    if (!aSiblingTransition.isEmpty())
+        xConnection->setAttribute(u"sibTransId"_ustr, aSiblingTransition);
+    if (!rConnection.msPresId.isEmpty())
+        xConnection->setAttribute(u"presId"_ustr, rConnection.msPresId);
+    xConnectionList->appendChild(xConnection);
+}
