 namespace oox::drawingml {
 
+namespace {
+
+// PowerPoint keeps one language per run. The export writes it from the locale
+// of the script the run's own text belongs to (DrawingML::GetScriptType), so
+// the import has to read it back into that same locale. Reading it only into
+// the locale of the language's own script loses, for example, a Korean
+// language set on Latin text: the next save would write the document default
+// back over it.
+sal_Int16 lclGetTextScriptType(const OUString& rText)
+{
+    if (rText.isEmpty())
+        return css::i18n::ScriptType::LATIN;
+    static css::uno::Reference<css::i18n::XBreakIterator> xBreakIterator
+        = css::i18n::BreakIterator::create(comphelper::getProcessComponentContext());
+    sal_Int16 nScriptType = xBreakIterator->getScriptType(rText, 0);
+    if (nScriptType == css::i18n::ScriptType::WEAK)
+    {
+        const sal_Int32 nPosition = xBreakIterator->nextScript(rText, 0, nScriptType);
+        if (nPosition < rText.getLength())
+            nScriptType = xBreakIterator->getScriptType(rText, nPosition);
+    }
+    return nScriptType == css::i18n::ScriptType::WEAK ? css::i18n::ScriptType::LATIN
+                                                      : nScriptType;
+}
