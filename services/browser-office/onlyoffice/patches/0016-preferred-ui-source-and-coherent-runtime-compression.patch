@@ -0,0 +1,131 @@
+// SPDX-License-Identifier: AGPL-3.0-only
+import fs from 'node:fs';
+import path from 'node:path';
+import { execFileSync } from 'node:child_process';
+import { createHash } from 'node:crypto';
+import { patchPreferredUiSource } from './patch-preferred-ui-source.mjs';
+import { compressRuntimeAsset } from './runtime-compressed-assets.mjs';
+import { uiBuildInputPaths, verifyUiRebuildEvidence } from './ui-rebuild-evidence.mjs';
+
+const root = path.resolve(import.meta.dirname, '..');
+const materials = path.resolve(process.env.ONLYOFFICE_LICENSE_MATERIALS_DIR || path.join(root, '.temp/licensing'));
+const lock = JSON.parse(fs.readFileSync(path.join(root, 'runtime-source-lock.json'), 'utf8'));
+const source = lock.sources.find((value) => value.id === lock.uiRebuild.sourceId);
+const archive = path.join(materials, 'upstream', source.archive);
+const sha = (file) => createHash('sha256').update(fs.readFileSync(file)).digest('hex');
+if (sha(archive) !== source.archiveSha256) throw new Error('Preferred UI archive changed');
+const dependencies = lock.uiRebuild.dependencySourceIds.map((id) => {
+  const value = lock.sources.find((source) => source.id === id);
+  if (!value || sha(path.join(materials, 'upstream', value.archive)) !== value.archiveSha256)
+    throw new Error('Preferred UI dependency archive changed: ' + id);
+  return value;
+});
+const temporary = fs.mkdtempSync(path.join(materials, 'ui-rebuild-'));
+const log = fs.openSync(path.join(materials, 'ui-rebuild.log'), 'w');
+const evidenceFile = path.join(materials, 'ui-rebuild-evidence.json');
+fs.rmSync(evidenceFile, { force: true });
+const inputs = () => uiBuildInputPaths().map((name) => ({ path: name, sha256: sha(path.join(root, name)) }));
+const originalInputs = inputs();
+const env = {
+  ...process.env,
+  APP_COPYRIGHT: lock.uiRebuild.compileCopyright,
+  PRODUCT_VERSION: '0.0.0',
+  BUILD_NUMBER: '0',
+  PUBLISHER_URL: 'https://www.onlyoffice.com/',
+  npm_config_workspaces: 'false',
+};
+const run = (command, args, cwd = temporary) =>
+  execFileSync(command, args, {
+    cwd,
+    env,
+    stdio: ['ignore', log, log],
+    timeout: 3600000,
+  });
+try {
+  run('tar', ['-xzf', archive]);
+  for (const dependency of dependencies) run('tar', ['-xzf', path.join(materials, 'upstream', dependency.archive)]);
+  patchPreferredUiSource(temporary, path.join(root, 'source-overrides'));
+  const build = path.join(temporary, 'web-apps/build');
+  run('npm', ['ci', '--ignore-scripts', '--no-audit', '--no-fund'], build);
+  // The locked image plugin's local tool must exist; never skip image tasks.
+  run('npm', ['rebuild', 'optipng-bin'], build);
+  run(process.execPath, ['-e', `require('grunt').tasks(${JSON.stringify(lock.uiRebuild.tasks)})`], build);
+  const deployed = path.join(temporary, 'web-apps/deploy/web-apps');
+  const api = path.join(deployed, 'apps/api/documents/api.js');
+  fs.renameSync(api, path.join(path.dirname(api), 'api-orig.js'));
+  fs.copyFileSync(path.join(root, 'source-overrides/browser-api.js'), api);
+  fs.copyFileSync(
+    path.join(temporary, 'vendor/requirejs/require.js'),
+    path.join(deployed, 'vendor/requirejs/require.js'),
+  );
+  for (const name of lock.uiRebuild.newlineOutputs) {
+    const file = path.join(deployed, name);
+    if (!fs.readFileSync(file, 'utf8').endsWith('\n')) fs.appendFileSync(file, '\n');
+  }
+  run(process.execPath, [
+    path.join(root, 'scripts/patch-onlyoffice-print-fallback.mjs'),
+    path.join(temporary, 'web-apps/deploy'),
+  ]);
+  const outputs = [];
+  const walk = (directory, relative = 'web-apps') => {
+    for (const entry of fs.readdirSync(directory, { withFileTypes: true })) {
+      const name = relative + '/' + entry.name;
+      const file = path.join(directory, entry.name);
+      if (entry.isDirectory()) walk(file, name);
+      else if (!entry.isFile()) throw new Error('Non-file UI asset: ' + name);
+      else {
+        const rebuilt = path.join(temporary, 'web-apps/deploy', name);
+        if (name.endsWith('.br')) {
+          const plain = rebuilt.slice(0, -3);
+          if (!fs.existsSync(plain)) throw new Error('Preferred source lacks compression input: ' + name);
+          fs.writeFileSync(rebuilt, compressRuntimeAsset(fs.readFileSync(plain)));
+        }
+        const digest = sha(file);
+        if (!fs.existsSync(rebuilt) || sha(rebuilt) !== digest) {
+          const original = fs.readFileSync(file),
+            candidate = fs.existsSync(rebuilt) ? fs.readFileSync(rebuilt) : Buffer.alloc(0);
+          let first = 0;
+          while (first < Math.min(original.length, candidate.length) && original[first] === candidate[first]) first++;
+          fs.writeFileSync(
+            path.join(materials, 'ui-rebuild-failure.json'),
+            JSON.stringify(
+              {
+                path: name,
+                firstDifference: first,
+                expectedSha256: digest,
+                rebuiltSha256: candidate.length ? sha(rebuilt) : null,
+                expectedContext: original.subarray(Math.max(0, first - 60), first + 180).toString(),
+                rebuiltContext: candidate.subarray(Math.max(0, first - 60), first + 180).toString(),
+              },
+              null,
+              2,
+            ),
+          );
+          if (fs.existsSync(rebuilt)) fs.copyFileSync(rebuilt, path.join(materials, 'ui-rebuild-failed-output'));
+          throw new Error('UI rebuild differs: ' + name);
+        }
+        outputs.push({ path: name, sha256: digest, exactMatch: true });
+      }
+    }
+  };
+  walk(path.join(root, 'dist/web-apps'));
+  outputs.sort((a, b) => a.path.localeCompare(b.path));
+  const evidence = {
+    schemaVersion: 1,
+    status: 'deployed-ui-assets-reproduced',
+    sourceCommit: source.commit,
+    sourceArchiveSha256: source.archiveSha256,
+    dependencies: dependencies.map(({ id, archiveSha256 }) => ({ id, archiveSha256 })),
+    buildRuntime: { node: process.versions.node, brotli: process.versions.brotli },
+    buildInputs: originalInputs,
+    outputs,
+  };
+  verifyUiRebuildEvidence(lock, evidence, inputs(), outputs);
+  fs.writeFileSync(evidenceFile, JSON.stringify(evidence, null, 2) + '\n');
+  process.stdout.write(
+    `Reproduced all ${outputs.length} deployed UI assets from preferred source. Full editor reproduction remains unverified.\n`,
+  );
+} finally {
+  fs.closeSync(log);
+  fs.rmSync(temporary, { recursive: true, force: true });
+}
