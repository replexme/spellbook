{
  "contractVersion": "1.0",
  "formats": [
    {
      "id": "pptx",
      "label": "PowerPoint presentation",
      "availability": "beta",
      "extensions": [".pptx"],
      "mimeTypes": [
        "application/vnd.openxmlformats-officedocument.presentationml.presentation"
      ],
      "maxBytes": 52428800,
      "editor": { "kind": "browser" },
      "semantics": {
        "unit": "slide",
        "rootCollection": "slides",
        "outputKind": "editable_pptx"
      }
    },
    {
      "id": "idml",
      "label": "InDesign document (IDML)",
      "availability": "experimental",
      "extensions": [".idml"],
      "mimeTypes": ["application/vnd.adobe.indesign-idml-package"],
      "maxBytes": 52428800,
      "editor": { "kind": "browser" },
      "semantics": {
        "unit": "page",
        "rootCollection": "pages",
        "outputKind": "editable_idml"
      }
    },
    {
      "id": "docx",
      "label": "Word document",
      "availability": "planned",
      "extensions": [".docx"],
      "mimeTypes": [
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
      ],
      "maxBytes": 52428800,
      "editor": { "kind": "none" },
      "semantics": {
        "unit": "section",
        "rootCollection": "document",
        "outputKind": "editable_docx"
      }
    },
    {
      "id": "spellbook",
      "label": "Spellbook page-layout document",
      "availability": "planned",
      "extensions": [".spellbook"],
      "mimeTypes": ["application/vnd.spellbook.document+zip"],
      "maxBytes": 104857600,
      "editor": { "kind": "native" },
      "semantics": {
        "unit": "page",
        "rootCollection": "pages",
        "outputKind": "editable_spellbook"
      }
    }
  ]
}
