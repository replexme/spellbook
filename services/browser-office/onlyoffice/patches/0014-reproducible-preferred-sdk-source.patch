diff --git a/scripts/fetch-git-source-archive.mjs b/scripts/fetch-git-source-archive.mjs
new file mode 100644
index 0000000..5d6fa54
--- /dev/null
+++ b/scripts/fetch-git-source-archive.mjs
@@ -0,0 +1,33 @@
+// SPDX-License-Identifier: AGPL-3.0-only
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import { execFileSync } from 'node:child_process';
+import { createHash } from 'node:crypto';
+import { createGzip } from 'node:zlib';
+import { pipeline } from 'node:stream/promises';
+
+// Export only the preferred SDK source, not the upstream repository's fonts.
+export async function fetchGitSourceArchive(source, output) {
+  if (!/^[a-f0-9]{40}$/.test(source.commit) || !/^[a-f0-9]{40}$/.test(source.tree) || source.sourcePath !== 'sdkjs')
+    throw new Error('Pinned SDK commit, tree and subtree required');
+  const temporary = fs.mkdtempSync(path.join(os.tmpdir(), 'office-sdk-source-'));
+  const git = (...args) => execFileSync('git', args, { cwd: temporary, encoding: 'utf8', timeout: 300000, maxBuffer: 8 * 1024 * 1024 });
+  const pending = output + '.pending';
+  try {
+    git('init', '--quiet');
+    git('remote', 'add', 'origin', source.sourceUrl);
+    git('fetch', '--quiet', '--filter=blob:none', '--depth=1', 'origin', source.commit);
+    if (git('rev-parse', 'FETCH_HEAD').trim() !== source.commit || git('rev-parse', source.commit + ':' + source.sourcePath).trim() !== source.tree)
+      throw new Error('Preferred SDK source identity mismatch');
+    const tar = path.join(temporary, 'source.tar');
+    git('archive', '--format=tar', '--output=' + tar, source.commit, source.sourcePath);
+    await pipeline(fs.createReadStream(tar), createGzip({ level: 9 }), fs.createWriteStream(pending, { flags: 'wx' }));
+    const sha = createHash('sha256').update(fs.readFileSync(pending)).digest('hex');
+    if (sha !== source.archiveSha256) throw new Error('Preferred SDK archive hash mismatch');
+    fs.renameSync(pending, output);
+  } finally {
+    fs.rmSync(pending, { force: true });
+    fs.rmSync(temporary, { recursive: true, force: true });
+  }
+}
