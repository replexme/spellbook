+// SPDX-License-Identifier: AGPL-3.0-only
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import { brotliDecompressSync } from 'node:zlib';
+import test from 'node:test';
+import { compressRuntimeAsset, syncRuntimeCompressedAssets } from './runtime-compressed-assets.mjs';
+const temporary = (run) => {
+  const root = fs.mkdtempSync(path.join(os.tmpdir(), 'runtime-compression-'));
+  try {
+    run(root);
+  } finally {
+    fs.rmSync(root, { recursive: true, force: true });
+  }
+};
+const pair = (root, name, raw, compressedRaw = raw) => {
+  const file = path.join(root, name);
+  fs.mkdirSync(path.dirname(file), { recursive: true });
+  fs.writeFileSync(file, raw);
+  fs.writeFileSync(file + '.br', compressRuntimeAsset(Buffer.from(compressedRaw)));
+  return file;
+};
+test('final reviewed font replacement cannot retain old compressed font metadata', () =>
+  temporary((root) => {
+    const f = pair(root, 'sdkjs/common/AllFonts.js', 'reviewed Arabic font list', 'old fonts');
+    assert.deepEqual(syncRuntimeCompressedAssets(root), { pairs: 1, updated: 1 });
+    assert.equal(brotliDecompressSync(fs.readFileSync(f + '.br')).toString(), 'reviewed Arabic font list');
+    assert.deepEqual(syncRuntimeCompressedAssets(root), { pairs: 1, updated: 0 });
+  }));
+test('patched UI compression reproduces exactly from its current source', () =>
+  temporary((root) => {
+    const f = pair(root, 'web-apps/main.js', 'new application hook', 'old application');
+    syncRuntimeCompressedAssets(root);
+    assert.deepEqual(fs.readFileSync(f + '.br'), compressRuntimeAsset(fs.readFileSync(f)));
+  }));
+test('verified non-UI encoding retains its current bytes', () =>
+  temporary((root) => {
+    const f = pair(root, 'sdkjs/slide/sdk-all.js', 'valid SDK');
+    const before = fs.readFileSync(f + '.br');
+    assert.deepEqual(syncRuntimeCompressedAssets(root), { pairs: 1, updated: 0 });
+    assert.deepEqual(fs.readFileSync(f + '.br'), before);
+  }));
+test('orphan compressed asset is rejected', () =>
+  temporary((root) => {
+    fs.writeFileSync(path.join(root, 'orphan.js.br'), compressRuntimeAsset(Buffer.from('orphan')));
+    assert.throws(() => syncRuntimeCompressedAssets(root), /counterpart/);
+  }));
