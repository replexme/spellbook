+// SPDX-License-Identifier: AGPL-3.0-only
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import vm from 'node:vm';
+import { patchFieldCacheHistory, unpatchFieldCacheHistory } from './patch-onlyoffice-field-cache-history.mjs';
+
+const draw = 'if(slide){this.lastRecalcSlideIndex=slide.num;this.cSld.refreshAllContentsFields(true)}else{this.lastRecalcSlideIndex=-1;this.cSld.refreshAllContentsFields(true)}';
+const source = 'MasterSlide.prototype.drawNoPlaceholders=function(graphics,slide){' + draw + '};' +
+  Array.from({length:5},(_,i)=>`MasterSlide.prototype.draw${i}=function(graphics,slide){${draw}};`).join('') +
+  'CPresentationField.prototype.private_CalculateContent=function(){AscFormat.ExecuteNoHistory(function(){var sStr=this.private_GetString();this.Content.length=0;this.AddText(sStr,-1);},this,[])};CPresentationField.prototype.GetFieldType=function(){};';
+
+function fixture({group=true, depth=1, reject=false}={}) {
+  const changes=[];
+  const history={TurnOffHistory:depth,UndoRedoInProgress:false,TurnOn(){this.TurnOffHistory--},TurnOff(){this.TurnOffHistory++},CanAddChanges(){return this.TurnOffHistory===0},Add(change){if(reject)throw new Error('native history rejected');changes.push(change)}};
+  const dfh={changesFactory:{},drawingsChangesMap:{},CChangesDrawingsDouble2:class{constructor(object,type,old,next){Object.assign(this,{object,type,old,next})}}};
+  class MasterSlide {}
+  class CPresentationField {}
+  const context={Asc:{editor:{isGroupActions:()=>group}},AscCommon:{History:history},AscFormat:{},AscDFH:dfh,MasterSlide,CPresentationField};
+  vm.runInNewContext(patchFieldCacheHistory(source),context);
+  return {context,history,changes,dfh};
+}
+
+test('patch is reversible and idempotent and refuses changed native boundaries',()=>{
+  const patched=patchFieldCacheHistory(source);
+  assert.equal(unpatchFieldCacheHistory(patched),source);
+  assert.equal(patchFieldCacheHistory(patched),patched);
+  assert.throws(()=>patchFieldCacheHistory(source.replace('this.Content.length=0;','this.Content.splice(0);')),/calculation changed/);
+  assert.throws(()=>patchFieldCacheHistory(source.replace('draw4=function','drawNoPlaceholders=function')),/drawing boundary changed/);
+});
+
+test('native context history retains negative indices and restores no-history depth',()=>{
+  const {context,history,changes,dfh}=fixture();
+  const object={lastRecalcSlideIndex:-1,getObjectType:()=>1118<<16};
+  context.AscFormat.spellbookSetFieldContext(object,0);
+  assert.equal(object.lastRecalcSlideIndex,0);
+  assert.equal(history.TurnOffHistory,1);
+  assert.equal(changes.length,1);
+  const change=changes[0];
+  assert.equal(change.old,-1);
+  dfh.drawingsChangesMap[change.type](object,change.old);
+  assert.equal(object.lastRecalcSlideIndex,-1);
+});
+
+test('ordinary paint and unchanged context do not add history; failures restore depth',()=>{
+  const normal=fixture({group:false});
+  normal.context.AscFormat.spellbookSetFieldContext({lastRecalcSlideIndex:-1},0);
+  assert.equal(normal.changes.length,0);
+  const same=fixture();
+  same.context.AscFormat.spellbookSetFieldContext({lastRecalcSlideIndex:0},0);
+  assert.equal(same.changes.length,0);
+  const failed=fixture({depth:2,reject:true});
+  const object={lastRecalcSlideIndex:-1,getObjectType:()=>1119<<16};
+  assert.throws(()=>failed.context.AscFormat.spellbookSetFieldContext(object,0),/native history rejected/);
+  assert.equal(failed.history.TurnOffHistory,2);
+  assert.equal(object.lastRecalcSlideIndex,-1);
+});
+
+test('existing history type collisions fail before modifying the render context',()=>{
+  const {context,dfh}=fixture();
+  const type=(1118<<16)|65500;
+  dfh.changesFactory[type]=dfh.CChangesDrawingsDouble2;
+  dfh.drawingsChangesMap[type]=()=>{};
+  const object={lastRecalcSlideIndex:-1,getObjectType:()=>1118<<16};
+  assert.throws(()=>context.AscFormat.spellbookSetFieldContext(object,0),/history_collision/);
+  assert.equal(object.lastRecalcSlideIndex,-1);
+});
