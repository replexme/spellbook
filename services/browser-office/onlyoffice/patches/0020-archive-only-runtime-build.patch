new file mode 100644
index 0000000..fdddae4
--- /dev/null
+++ b/scripts/wrapper-source-files.mjs
@@ -0,0 +1,45 @@
+// SPDX-License-Identifier: AGPL-3.0-only
+import fs from 'node:fs';
+import path from 'node:path';
+import { execFileSync } from 'node:child_process';
+
+export const WRAPPER_SOURCE_MANIFEST = 'wrapper-source-files.json';
+export const isWrapperSourceFile = (file) =>
+  typeof file === 'string' && file.length > 0 &&
+  !path.isAbsolute(file) && !file.split(/[\\/]/).some((part) => part === '..' || part === '.' || part === '') &&
+  !/^(?:public\/(?:sdkjs|web-apps|wasm|fonts|fixtures|dictionaries)\/|artifacts\/)/.test(file);
+
+export function wrapperSourceFiles(root) {
+  const manifest = path.join(root, WRAPPER_SOURCE_MANIFEST);
+  let files;
+  if (fs.existsSync(manifest)) {
+    files = JSON.parse(fs.readFileSync(manifest, 'utf8'));
+    if (!Array.isArray(files) || files.some((file) => !isWrapperSourceFile(file)))
+      throw new Error('Invalid wrapper source manifest');
+  } else {
+    const top = execFileSync('git', ['rev-parse', '--show-toplevel'], { cwd: root, encoding: 'utf8' }).trim();
+    if (fs.realpathSync(top) !== fs.realpathSync(root)) throw new Error('Wrapper source requires its own repository or packaged manifest');
+    files = execFileSync('git', ['ls-files', '-z'], { cwd: root, encoding: 'utf8', maxBuffer: 32 * 1024 * 1024 })
+      .split('\0').filter(isWrapperSourceFile);
+  }
+  return [...new Set(files)].filter((file) => {
+    if (!fs.existsSync(path.join(root, file))) throw new Error('Missing wrapper source: ' + file);
+    if (!fs.lstatSync(path.join(root, file)).isFile()) throw new Error('Non-file wrapper source: ' + file);
+    return file !== WRAPPER_SOURCE_MANIFEST;
+  }).sort();
+}
+
+export function packageWrapperSource(root, archive, materials, files = wrapperSourceFiles(root)) {
+  const staged = fs.mkdtempSync(path.join(materials, 'wrapper-source-'));
+  try {
+    for (const file of files) {
+      const target = path.join(staged, file);
+      fs.mkdirSync(path.dirname(target), { recursive: true });
+      fs.copyFileSync(path.join(root, file), target);
+    }
+    fs.writeFileSync(path.join(staged, WRAPPER_SOURCE_MANIFEST), JSON.stringify(files, null, 2) + '\n');
+    const fileList = path.join(materials, 'wrapper-source-files.txt');
+    fs.writeFileSync(fileList, [...files, WRAPPER_SOURCE_MANIFEST].join('\0') + '\0');
+    execFileSync('tar', ['-czf', archive, '-C', staged, '--null', '-T', fileList]);
+  } finally { fs.rmSync(staged, { recursive: true, force: true }); }
+}
