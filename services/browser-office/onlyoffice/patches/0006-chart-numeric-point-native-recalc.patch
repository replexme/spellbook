+++ b/test/unit/chart-point-recalc.test.ts
@@ -0,0 +1,38 @@
+import { readFileSync } from 'node:fs';
+import vm from 'node:vm';
+import { describe, expect, it } from 'vitest';
+import { patchChartPointRecalc } from '../../scripts/patch-onlyoffice-chart-point-recalc.mjs';
+
+const source = readFileSync('public/sdkjs/slide/sdk-all.js', 'utf8');
+function point(text: string, chart: unknown) {
+  class NumericPoint {
+    getChartSpace() { return chart; }
+  }
+  const context = vm.createContext({ CNumericPoint: NumericPoint, AscDFH: { historyitem_NumericPoint_SetVal: 123 } });
+  const start = text.indexOf('CNumericPoint.prototype.Refresh_RecalcData=');
+  if (start >= 0) vm.runInContext(text.slice(start, text.indexOf('CNumericPoint.prototype.fillObject=', start)), context);
+  return new NumericPoint() as NumericPoint & { Refresh_RecalcData?: (data: { Type: number }) => void };
+}
+
+describe('numeric chart point history invalidation', () => {
+  it('reproduces the missing native history hook', () => {
+    expect(point(source, null).Refresh_RecalcData).toBeUndefined();
+  });
+  it('invalidates the owning chart through its existing native data lifecycle', () => {
+    let updates = 0;
+    const value = point(patchChartPointRecalc(source), { onDataUpdateRecalc() { updates++; } });
+    // The native history calls this hook on apply, Undo and Redo.
+    for (let i = 0; i < 3; i++) value.Refresh_RecalcData!({ Type: 123 });
+    expect(updates).toBe(3);
+    value.Refresh_RecalcData!({ Type: 456 });
+    expect(updates).toBe(3);
+  });
+  it('allows detached points and refuses changed or duplicate boundaries', () => {
+    const patched = patchChartPointRecalc(source);
+    expect(() => point(patched, null).Refresh_RecalcData!({ Type: 123 })).not.toThrow();
+    expect(patchChartPointRecalc(patched)).toBe(patched);
+    expect(() => patchChartPointRecalc('unknown')).toThrow();
+    expect(() => patchChartPointRecalc(source + source)).toThrow();
+    expect(() => patchChartPointRecalc(source.replace('CNumericPoint.prototype.fillObject=', 'CNumericPoint.prototype.Refresh_RecalcData='))).toThrow();
+  });
+});
