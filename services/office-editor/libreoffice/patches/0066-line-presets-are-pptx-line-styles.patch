+void setPresetLineDash(const uno::Reference<XPropertySet>& rxShape,
+                       const uno::Reference<lang::XMultiServiceFactory>& rxModelFactory,
+                       std::u16string_view rPreset)
+{
+    PropertySet aShape(rxShape);
+    if (rPreset == u"solid")
+    {
+        aShape.setProperty(PROP_LineStyle, LineStyle_SOLID);
+        return;
+    }
+    const sal_Int32 nPresetDash = lclGetPresetToken(
+        rPreset, { { u"dot", XML_dot },
+                   { u"dash", XML_dash },
+                   { u"dashDot", XML_dashDot },
+                   { u"lgDash", XML_lgDash },
+                   { u"lgDashDot", XML_lgDashDot },
+                   { u"lgDashDotDot", XML_lgDashDotDot },
+                   { u"sysDot", XML_sysDot },
+                   { u"sysDash", XML_sysDash },
+                   { u"sysDashDot", XML_sysDashDot },
+                   { u"sysDashDotDot", XML_sysDashDotDot } });
+    // The dash follows the line's cap as import reads a:ln/@cap.
+    LineCap eLineCap = LineCap_BUTT;
+    aShape.getProperty(eLineCap, PROP_LineCap);
+    LineDash aLineDash;
+    aLineDash.Style = lclGetDashStyle(eLineCap == LineCap_ROUND    ? XML_rnd
+                                      : eLineCap == LineCap_SQUARE ? XML_sq
+                                                                   : XML_flat);
+    lclConvertPresetDash(aLineDash, nPresetDash);
+    lclIncludeLineCapInDash(aLineDash, eLineCap, true);
+    ModelObjectHelper aModelObjectHelper(rxModelFactory);
+    ShapePropertyMap aPropMap(aModelObjectHelper);
+    aPropMap.setProperty(ShapeProperty::LineDash, aLineDash);
+    aPropMap.setProperty(ShapeProperty::LineStyle, LineStyle_DASH);
+    aShape.setProperties(aPropMap);
+}
+
+void setPresetLineArrow(const uno::Reference<XPropertySet>& rxShape,
+                        const uno::Reference<lang::XMultiServiceFactory>& rxModelFactory,
+                        bool bLineEnd, std::u16string_view rPreset)
+{
+    if (rPreset == u"none")
+    {
+        rxShape->setPropertyValue(bLineEnd ? u"LineEnd"_ustr : u"LineStart"_ustr,
+                                  cpo::uno::Any(PolyPolygonBezierCoords()));
+        return;
+    }
+    sal_Int32 nIndex = 0;
+    const std::u16string_view aType = o3tl::getToken(rPreset, 0, ' ', nIndex);
+    const std::u16string_view aWidth = o3tl::getToken(rPreset, 0, ' ', nIndex);
+    const std::u16string_view aLength = o3tl::getToken(rPreset, 0, ' ', nIndex);
+    if (nIndex != -1)
+        throw lang::IllegalArgumentException(u"Unknown PowerPoint line preset"_ustr, nullptr, 0);
+    LineArrowProperties aArrow;
+    aArrow.moArrowType = lclGetPresetToken(aType, { { u"triangle", XML_triangle },
+                                                    { u"stealth", XML_stealth },
+                                                    { u"diamond", XML_diamond },
+                                                    { u"oval", XML_oval },
+                                                    { u"arrow", XML_arrow } });
+    const std::initializer_list<std::pair<std::u16string_view, sal_Int32>> aSizes
+        = { { u"sm", XML_sm }, { u"med", XML_med }, { u"lg", XML_lg } };
+    aArrow.moArrowWidth = lclGetPresetToken(aWidth, aSizes);
+    aArrow.moArrowLength = lclGetPresetToken(aLength, aSizes);
+    PropertySet aShape(rxShape);
+    sal_Int32 nLineWidth = 0;
+    aShape.getProperty(nLineWidth, PROP_LineWidth);
+    ModelObjectHelper aModelObjectHelper(rxModelFactory);
+    ShapePropertyMap aPropMap(aModelObjectHelper);
+    lclPushMarkerProperties(aPropMap, aArrow, nLineWidth, bLineEnd);
+    aShape.setProperties(aPropMap);
+}
