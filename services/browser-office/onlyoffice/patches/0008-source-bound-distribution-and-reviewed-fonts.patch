+++ b/scripts/build-license-materials.mjs
@@ -0,0 +1,134 @@
+// SPDX-License-Identifier: AGPL-3.0-only
+import fs from 'node:fs';
+import path from 'node:path';
+import { createHash } from 'node:crypto';
+import { execFileSync } from 'node:child_process';
+import { verifyOnlyOfficeFontAssets } from './verify-onlyoffice-font-assets.mjs';
+
+const root = path.resolve(import.meta.dirname, '..');
+const dist = path.join(root, 'dist');
+const materials = path.resolve(process.env.ONLYOFFICE_LICENSE_MATERIALS_DIR || path.join(root, '.temp/licensing'));
+const fonts = path.join(materials, 'font-assets');
+const lock = JSON.parse(fs.readFileSync(path.join(root, 'runtime-source-lock.json'), 'utf8'));
+const sha = (file) => createHash('sha256').update(fs.readFileSync(file)).digest('hex');
+if (verifyOnlyOfficeFontAssets(fonts).fontSet !== 'redistributable')
+  throw new Error('Distribution requires reviewed redistributable fonts');
+if (sha(path.join(dist, 'wasm/x2t/x2t.wasm')) !== lock.x2tWasmSha256)
+  throw new Error('Converter bytes do not match the source-bound release');
+
+// Validate everything before replacing font assets or writing release metadata.
+for (const source of lock.sources) {
+  if (sha(path.join(materials, 'upstream', source.archive)) !== source.archiveSha256)
+    throw new Error('Source archive identity changed: ' + source.id);
+}
+const fontManifest = JSON.parse(fs.readFileSync(path.join(fonts, 'onlyoffice-browser-font-assets.json'), 'utf8'));
+fs.rmSync(path.join(dist, 'fonts'), { recursive: true, force: true });
+for (const file of [
+  fontManifest.allFonts,
+  fontManifest.fontSelection,
+  'server/FileConverter/bin/AllFonts.js',
+  'onlyoffice-browser-font-assets.json',
+  'onlyoffice-browser-font-source-map.json',
+  'font-licenses.json',
+  ...fontManifest.fonts,
+  ...fontManifest.fontThumbnails,
+]) {
+  const destination = path.join(dist, file);
+  fs.mkdirSync(path.dirname(destination), { recursive: true });
+  fs.copyFileSync(path.join(fonts, file), destination);
+}
+const sourceDir = path.join(dist, 'sources');
+fs.mkdirSync(sourceDir, { recursive: true });
+for (const source of lock.sources)
+  fs.copyFileSync(path.join(materials, 'upstream', source.archive), path.join(sourceDir, source.archive));
+fs.copyFileSync(path.join(root, 'LICENSE'), path.join(dist, 'LICENSE-AGPL-3.0.txt'));
+const tracked = execFileSync('git', ['ls-files', '-z'], { cwd: root, encoding: 'utf8', maxBuffer: 32 * 1024 * 1024 })
+  .split('\0')
+  .filter(
+    (file) =>
+      file &&
+      fs.existsSync(path.join(root, file)) &&
+      !/^(?:public\/(?:sdkjs|web-apps|wasm|fonts|fixtures)\/|artifacts\/)/.test(file),
+  );
+const fileList = path.join(materials, 'wrapper-source-files.txt');
+fs.writeFileSync(fileList, tracked.join('\0') + '\0');
+execFileSync('tar', ['-czf', path.join(sourceDir, 'browser-office-source.tar.gz'), '--null', '-T', fileList], {
+  cwd: root,
+});
+fs.writeFileSync(
+  path.join(dist, 'NOTICE.txt'),
+  'Browser Office Editor: AGPL-3.0; local modifications included in sources/browser-office-source.tar.gz.\n' +
+    'ONLYOFFICE 9.3.0.140: Copyright Ascensio System SIA 2010-2024. AGPL-3.0 with upstream additional terms; original logo retained.\n' +
+    'ONLYOFFICE GUI illustrations, icons and technical writing: CC-BY-SA-4.0. See the bundled upstream sources and https://creativecommons.org/licenses/by-sa/4.0/ .\n' +
+    'Fonts: OFL-1.1, unchanged font bytes. Complete individual copyright and license notices: font-licenses.json.\n',
+);
+fs.writeFileSync(
+  path.join(sourceDir, 'BUILD.md'),
+  '# Build materials\n\nThe browser-office archive includes local modifications, package lockfiles and bin/build.sh. Use Node 20.19+ and the declared package manager; install locked dependencies. Copy distributed font bytes to their font-licenses.json inputFile names, with those same hashes and notices in the input permission manifest. Run the included font generator with --license-manifest and output .temp/licensing/font-assets. Run npm run build: it fetches/verifies the pinned source archives and converter release, builds the editor/library and packages the legal materials.\n\n' +
+    'SDKJS and web-apps preferred source and build_tools are bundled at the pinned commits in distribution-manifest.json. Follow their build instructions for upstream editor assets; apply the browser-office scripts/patch-onlyoffice-*.mjs through bin/build.sh.\n\n' +
+    'x2t-source.tar.gz includes the modified ONLYOFFICE core, Dockerfile, build.sh and dependencies/build instructions for v9.3.0+4. Run its ./build.sh locally. Published x2t WASM SHA-256 is bound in runtime-source-lock.json.\n\n' +
+    'Font source locations, hashes and full OFL notices are in font-licenses.json. The reviewed generator runs allfontsgen with system-font scanning disabled. Provide these exact input bytes with the permission manifest to generate-onlyoffice-font-assets.mjs.\n\n' +
+    'Source packaging and release-byte identity are checked here. Rebuilding the entire upstream editor to reproduce its shipped bytes has not been performed by this packaging step.\n',
+);
+const files = [];
+function scan(directory = dist) {
+  for (const entry of fs.readdirSync(directory, { withFileTypes: true })) {
+    const file = path.join(directory, entry.name);
+    if (entry.isDirectory()) scan(file);
+    else if (entry.isFile() && entry.name !== 'distribution-manifest.json')
+      files.push({ path: path.relative(dist, file).replaceAll(path.sep, '/'), sha256: sha(file) });
+    else if (!entry.isFile()) throw new Error('Distribution must not contain symlinks: ' + file);
+  }
+}
+const links = lock.sources
+  .map((source) => `<li>${source.id}: <a href="sources/${source.archive}">Download source</a></li>`)
+  .join('');
+fs.writeFileSync(
+  path.join(dist, 'licensing.html'),
+  `<!doctype html><html lang="en"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Office licenses and source</title><body style="font-family:system-ui;max-width:56rem;margin:2rem auto;padding:0 1rem"><h1>Office licenses and source</h1><p>This editor uses ONLYOFFICE under AGPL-3.0. Copyright Ascensio System SIA 2010-2024. Distributed without warranty. You may use, modify and redistribute it under its license terms.</p><p><a href="LICENSE-AGPL-3.0.txt">Full AGPL license</a> · <a href="NOTICE.txt">Third-party notices</a> · <a href="font-licenses.json">Font copyright and licenses</a></p><h2>Source for this distribution</h2><ul><li><a href="sources/browser-office-source.tar.gz">Browser editor and local modifications</a></li>${links}<li><a href="sources/BUILD.md">Build instructions</a></li></ul><p><a href="distribution-manifest.json">Exact source commits and distributed file hashes</a></p></body></html>`,
+);
+scan();
+fs.writeFileSync(
+  path.join(dist, 'distribution-manifest.json'),
+  JSON.stringify(
+    {
+      schemaVersion: 1,
+      engine: 'onlyoffice',
+      sdkVersion: lock.sdkVersion,
+      x2tVersion: lock.x2tVersion,
+      sourceMaterialsPackaged: true,
+      upstreamEditorRebuildVerified: false,
+      sources: [
+        ...lock.sources,
+        {
+          id: 'browser-office',
+          archive: 'browser-office-source.tar.gz',
+          archiveSha256: sha(path.join(sourceDir, 'browser-office-source.tar.gz')),
+        },
+      ],
+      files,
+    },
+    null,
+    2,
+  ) + '\n',
+);
+console.log(
+  'Packaged reviewed fonts, license notices and pinned source/build materials. Upstream editor byte reproducibility remains unverified.',
+);
+
+// A core + type CDN deployment must carry the same legal/source/font assets.
+const corePack = path.join(root, '.onlyoffice-runtime-asset-packs/core');
+if (fs.existsSync(corePack)) {
+  for (const file of [...files.map((entry) => entry.path), 'distribution-manifest.json']) {
+    if (
+      /^(?:sdkjs\/(?:word|cell|slide)\/|web-apps\/apps\/(?:documenteditor|spreadsheeteditor|presentationeditor)\/)/.test(
+        file,
+      )
+    )
+      continue;
+    const destination = path.join(corePack, file);
+    fs.mkdirSync(path.dirname(destination), { recursive: true });
+    fs.rmSync(destination, { force: true });
+    fs.linkSync(path.join(dist, file), destination);
+  }
+}
diff --git a/scripts/fetch-license-materials.mjs b/scripts/fetch-license-materials.mjs
new file mode 100644
index 0000000..d0bd2e5
--- /dev/null
+++ b/scripts/fetch-license-materials.mjs
@@ -0,0 +1,37 @@
+// SPDX-License-Identifier: AGPL-3.0-only
+import fs from 'node:fs';
+import path from 'node:path';
+import { createHash } from 'node:crypto';
+import { execFileSync } from 'node:child_process';
+import { verifyOnlyOfficeFontAssets } from './verify-onlyoffice-font-assets.mjs';
+
+const root = path.resolve(import.meta.dirname, '..');
+const output = path.resolve(process.env.ONLYOFFICE_LICENSE_MATERIALS_DIR || path.join(root, '.temp/licensing'));
+const upstream = path.join(output, 'upstream');
+const lock = JSON.parse(fs.readFileSync(path.join(root, 'runtime-source-lock.json'), 'utf8'));
+if (verifyOnlyOfficeFontAssets(path.join(output, 'font-assets')).fontSet !== 'redistributable')
+  throw new Error('Build requires reviewed redistributable font assets');
+fs.mkdirSync(upstream, { recursive: true });
+const sha = (bytes) => createHash('sha256').update(bytes).digest('hex');
+async function obtain(url, file, expected) {
+  if (fs.existsSync(file) && sha(fs.readFileSync(file)) === expected) return;
+  const response = await fetch(url);
+  if (!response.ok) throw new Error('Source download failed: ' + url);
+  const bytes = Buffer.from(await response.arrayBuffer());
+  if (sha(bytes) !== expected) throw new Error('Source/release hash mismatch: ' + url);
+  fs.writeFileSync(file, bytes);
+}
+for (const source of lock.sources)
+  await obtain(source.sourceUrl, path.join(upstream, source.archive), source.archiveSha256);
+const release = path.join(upstream, 'x2t-release.tar.gz');
+await obtain(
+  'https://github.com/agentbridges-ai/onlyoffice-x2t-wasm/releases/download/v9.3.0%2B4/onlyoffice-x2t-wasm-v9.3.0%2B4.tar.gz',
+  release,
+  '94dd84fa067ebed4fde5763bd5592cb506ac61c3cd3c54cec84953535fb6c5c5',
+);
+for (const file of ['x2t.js', 'x2t.js.br', 'x2t.wasm', 'x2t.wasm.br']) {
+  const bytes = execFileSync('tar', ['-xOf', release, './' + file], { maxBuffer: 64 * 1024 * 1024 });
+  if (file === 'x2t.wasm' && sha(bytes) !== lock.x2tWasmSha256) throw new Error('Converter hash mismatch');
+  fs.writeFileSync(path.join(root, 'public/wasm/x2t', file), bytes);
+}
+console.log('Verified pinned source archives and converter release. Generate reviewed font assets before building.');
