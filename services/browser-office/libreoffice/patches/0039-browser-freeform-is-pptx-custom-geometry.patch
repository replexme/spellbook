+// Gives a custom shape the geometry PPTX import creates for a freeform
+// (a:custGeom): one path through the points, which lie in the shape's own box,
+// closed or open. The browser bridge cannot write CustomShapeGeometry itself.
+void applySpellbookFreeform(SvxShape& rShape, bool bClosed, const uno::Any& rValue)
+{
+    uno::Sequence<uno::Sequence<awt::Point>> aPolygons;
+    const auto* pCustomShape = dynamic_cast<const SdrObjCustomShape*>(rShape.GetSdrObject());
+    if (!pCustomShape || !(rValue >>= aPolygons) || aPolygons.getLength() != 1
+        || aPolygons[0].getLength() < 2)
+        throw lang::IllegalArgumentException(u"Invalid freeform geometry"_ustr, nullptr, 0);
+    const awt::Size aSize = rShape.getSize();
+    std::vector<drawing::EnhancedCustomShapeParameterPair> aCoordinates;
+    for (const awt::Point& rPoint : aPolygons[0])
+    {
+        if (rPoint.X < 0 || rPoint.Y < 0 || rPoint.X > aSize.Width || rPoint.Y > aSize.Height)
+            throw lang::IllegalArgumentException(u"Freeform point outside its box"_ustr, nullptr,
+                                                  0);
+        drawing::EnhancedCustomShapeParameterPair aPair;
+        aPair.First.Value <<= rPoint.X;
+        aPair.First.Type = drawing::EnhancedCustomShapeParameterType::NORMAL;
+        aPair.Second.Value <<= rPoint.Y;
+        aPair.Second.Type = drawing::EnhancedCustomShapeParameterType::NORMAL;
+        aCoordinates.push_back(aPair);
+    }
+    std::vector<drawing::EnhancedCustomShapeSegment> aSegments{
+        { drawing::EnhancedCustomShapeSegmentCommand::MOVETO, 1 },
+        { drawing::EnhancedCustomShapeSegmentCommand::LINETO,
+          static_cast<sal_Int16>(aPolygons[0].getLength() - 1) }
+    };
+    if (bClosed)
+        aSegments.push_back({ drawing::EnhancedCustomShapeSegmentCommand::CLOSESUBPATH, 0 });
+    aSegments.push_back({ drawing::EnhancedCustomShapeSegmentCommand::ENDSUBPATH, 0 });
+    const uno::Sequence<beans::PropertyValue> aPath(comphelper::InitPropertySequence(
+        { { "Coordinates", uno::Any(comphelper::containerToSequence(aCoordinates)) },
+          { "Segments", uno::Any(comphelper::containerToSequence(aSegments)) },
+          { "SubViewSize", uno::Any(uno::Sequence<awt::Size>{ aSize }) } }));
+    rShape._setPropertyValue(
+        u"CustomShapeGeometry"_ustr,
+        uno::Any(comphelper::InitPropertySequence(
+            { { "Type", uno::Any(u"ooxml-non-primitive"_ustr) },
+              { "ViewBox", uno::Any(awt::Rectangle(0, 0, aSize.Width, aSize.Height)) },
+              { "Path", uno::Any(aPath) } })));
+}
 }
 
