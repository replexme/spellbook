diff --git a/scripts/runtime-dictionaries.mjs b/scripts/runtime-dictionaries.mjs
new file mode 100644
index 0000000..8c4c76f
--- /dev/null
+++ b/scripts/runtime-dictionaries.mjs
@@ -0,0 +1,54 @@
+// SPDX-License-Identifier: AGPL-3.0-only
+import fs from 'node:fs';
+import path from 'node:path';
+import { DEFAULT_DICTIONARIES } from './build-onlyoffice-runtime-assets.mjs';
+
+// Derive advertised capabilities and engine paths from the selected real assets.
+// Document language metadata is never changed to a different installed locale.
+export function materializeRuntimeDictionaries(sourceRoot, targetRoot, locales = DEFAULT_DICTIONARIES) {
+  const profile = {};
+  for (const locale of locales) {
+    if (!/^[A-Za-z0-9_]+$/.test(locale) || Object.hasOwn(profile, locale))
+      throw new Error('Invalid or duplicate runtime dictionary locale: ' + locale);
+    const directory = path.join(sourceRoot, 'dictionaries', locale);
+    const output = path.join(targetRoot, 'dictionaries', locale);
+    const copy = (name, target = name) => {
+      const source = path.join(directory, name);
+      if (!fs.statSync(source).isFile()) throw new Error('Dictionary must be a regular file: ' + source);
+      fs.mkdirSync(output, { recursive: true });
+      fs.copyFileSync(source, path.join(output, target));
+    };
+    copy(locale + '.aff');
+    copy(locale + '.dic');
+    const canonical = 'hyph_' + locale + '.dic';
+    const legacy = locale + '_hyph.dic';
+    const hyphen = fs.existsSync(path.join(directory, canonical)) ? canonical
+      : fs.existsSync(path.join(directory, legacy)) ? legacy : null;
+    if (hyphen) copy(hyphen, canonical);
+    profile[locale] = { hyphen: Boolean(hyphen) };
+  }
+  return profile;
+}
+
+export function configureRuntimeDictionaries(common, profile) {
+  if (!common || typeof common.spellcheckGetLanguages !== 'function')
+    throw new Error('Native dictionary language provider is unavailable');
+  const original = common.spellcheckGetLanguages;
+  if (original.__onlyOfficeBrowserRuntimeDictionaries) return;
+  function installedLanguages() {
+    const available = original(), selected = {};
+    for (const id of Object.keys(available)) {
+      const language = available[id];
+      if (Object.hasOwn(profile, language.name))
+        selected[id] = { ...language, hyphen: language.hyphen && profile[language.name].hyphen };
+    }
+    return selected;
+  }
+  installedLanguages.__onlyOfficeBrowserRuntimeDictionaries = true;
+  common.spellcheckGetLanguages = installedLanguages;
+}
+
+export function renderDictionaryBootstrap(profile) {
+  return 'window.__onlyOfficeBrowserConfigureDictionaries = function (common) { (' +
+    configureRuntimeDictionaries.toString() + ')(common, ' + JSON.stringify(profile) + '); };';
+}
diff --git a/scripts/runtime-dictionaries.test.mjs b/scripts/runtime-dictionaries.test.mjs
new file mode 100644
index 0000000..bbbac5e
--- /dev/null
+++ b/scripts/runtime-dictionaries.test.mjs
@@ -0,0 +1,45 @@
+// SPDX-License-Identifier: AGPL-3.0-only
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import vm from 'node:vm';
+import { test } from 'node:test';
+import { materializeRuntimeDictionaries, configureRuntimeDictionaries, renderDictionaryBootstrap } from './runtime-dictionaries.mjs';
+
+test('selected spell and hyphen resources use the exact native request path', () => {
+  const root = fs.mkdtempSync(path.join(os.tmpdir(), 'office-dictionaries-'));
+  try {
+    const source = path.join(root, 'source/dictionaries/en_US');
+    fs.mkdirSync(source, { recursive: true });
+    fs.writeFileSync(path.join(source, 'en_US.aff'), 'SET UTF-8');
+    fs.writeFileSync(path.join(source, 'en_US.dic'), '1\nword');
+    fs.writeFileSync(path.join(source, 'en_US_hyph.dic'), 'UTF-8\n.wo1rd');
+    const profile = materializeRuntimeDictionaries(path.join(root, 'source'), path.join(root, 'dist'));
+    assert.deepEqual(profile, { en_US: { hyphen: true } });
+    assert.equal(fs.readFileSync(path.join(root, 'dist/dictionaries/en_US/hyph_en_US.dic'), 'utf8'), 'UTF-8\n.wo1rd');
+    assert.throws(() => materializeRuntimeDictionaries(path.join(root, 'source'), path.join(root, 'dist'), ['en_GB']));
+    assert.throws(() => materializeRuntimeDictionaries(path.join(root, 'source'), path.join(root, 'dist'), ['../outside']), /Invalid/);
+  } finally { fs.rmSync(root, { recursive: true, force: true }); }
+});
+
+test('native language capabilities exclude uninstalled dictionaries without relabeling document languages', () => {
+  const original = { 1033: { name: 'en_US', hyphen: true }, 2057: { name: 'en_GB', hyphen: true }, 1042: { name: 'ko_KR', hyphen: false } };
+  const common = { spellcheckGetLanguages: () => original };
+  configureRuntimeDictionaries(common, { en_US: { hyphen: false } });
+  assert.deepEqual(common.spellcheckGetLanguages(), { 1033: { name: 'en_US', hyphen: false } });
+  assert.equal(original[2057].name, 'en_GB');
+  assert.equal(original[1033].hyphen, true);
+  const configured = common.spellcheckGetLanguages;
+  configureRuntimeDictionaries(common, { en_US: { hyphen: false } });
+  assert.equal(common.spellcheckGetLanguages, configured);
+  assert.throws(() => configureRuntimeDictionaries({}, {}), /provider/);
+});
+
+test('compiled inline bootstrap executes without Node dependencies', () => {
+  const context = { window: {} };
+  vm.runInNewContext(renderDictionaryBootstrap({ en_US: { hyphen: true } }), context);
+  const common = { spellcheckGetLanguages: () => ({ 1033: { name: 'en_US', hyphen: true }, 2057: { name: 'en_GB', hyphen: true } }) };
+  context.window.__onlyOfficeBrowserConfigureDictionaries(common);
+  assert.deepEqual(Object.keys(common.spellcheckGetLanguages()), ['1033']);
+});
