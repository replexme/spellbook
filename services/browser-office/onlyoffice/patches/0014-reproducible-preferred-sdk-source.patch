new file mode 100644
index 0000000..05362f5
--- /dev/null
+++ b/scripts/sdk-rebuild-evidence.test.mjs
@@ -0,0 +1,41 @@
+// SPDX-License-Identifier: AGPL-3.0-only
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { sdkBuildInputPaths, verifySdkRebuildEvidence as verify } from './sdk-rebuild-evidence.mjs';
+const lock = { sources: [{ id: 'sdk', commit: 'commit', tree: 'tree', archiveSha256: 'archive' }], sdkRebuild: { sourceId: 'sdk', patchScripts: ['scripts/patch.mjs'], baseOutputs: [{ path: 'base.js', sha256: 'base' }], patchedOutputs: [{ path: 'patched.js', sha256: 'patched' }] } };
+const inputs = () => sdkBuildInputPaths(lock).map((path) => ({ path, sha256: 'unchanged' }));
+const verifySdkRebuildEvidence = (lock, receipt, current = inputs()) => verify(lock, receipt, current);
+const receipt = () => ({ schemaVersion: 1, status: 'sdk-js-and-local-patches-reproduced', sourceCommit: 'commit', sourceTree: 'tree', sourceArchiveSha256: 'archive', buildInputs: inputs(), baseOutputs: [{ path: 'base.js', sha256: 'base', exactMatch: true }], patchedOutputs: [{ path: 'patched.js', sha256: 'patched', exactMatch: true }] });
+test('SDK reproduction never certifies the entire editor', () => {
+  assert.deepEqual(verifySdkRebuildEvidence(lock, receipt()), { sdkJavaScriptRebuildVerified: true, upstreamEditorRebuildVerified: false });
+});
+for (const field of ['sourceCommit', 'sourceTree', 'sourceArchiveSha256', 'status']) test('rejects changed ' + field, () => {
+  const evidence = receipt(); evidence[field] = 'changed';
+  assert.throws(() => verifySdkRebuildEvidence(lock, evidence), /rebuild evidence/);
+});
+for (const kind of ['baseOutputs', 'patchedOutputs']) {
+  test('rejects missing or duplicate ' + kind, () => {
+    const evidence = receipt(); evidence[kind] = [];
+    assert.throws(() => verifySdkRebuildEvidence(lock, evidence), /outputs/);
+    evidence[kind] = [receipt()[kind][0], receipt()[kind][0]];
+    assert.throws(() => verifySdkRebuildEvidence(lock, evidence), /outputs/);
+  });
+  test('rejects mismatched or unverified ' + kind, () => {
+    for (const field of ['path', 'sha256', 'exactMatch']) {
+      const evidence = receipt(); evidence[kind][0][field] = 'changed';
+      assert.throws(() => verifySdkRebuildEvidence(lock, evidence), /output mismatch/);
+    }
+  });
+}
+test('rejects rebuild source changes after successful SDK compilation', () => {
+  for (const input of inputs()) {
+    const current = inputs(); current.find((file) => file.path === input.path).sha256 = 'changed';
+    assert.throws(() => verifySdkRebuildEvidence(lock, receipt(), current), /source changed/);
+  }
+});
+test('rejects incomplete or duplicate SDK build-source readback', () => {
+  const evidence = receipt(); evidence.buildInputs.pop();
+  assert.throws(() => verifySdkRebuildEvidence(lock, evidence), /source identity/);
+  const duplicate = receipt(); duplicate.buildInputs[1] = duplicate.buildInputs[0];
+  assert.throws(() => verifySdkRebuildEvidence(lock, duplicate), /source identity/);
+});
