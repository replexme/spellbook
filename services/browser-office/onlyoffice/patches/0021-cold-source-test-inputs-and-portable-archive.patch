diff --git a/test/helpers/base-slide-sdk.ts b/test/helpers/base-slide-sdk.ts
new file mode 100644
index 0000000..befca10
--- /dev/null
+++ b/test/helpers/base-slide-sdk.ts
@@ -0,0 +1,18 @@
+import fs from 'node:fs';
+import path from 'node:path';
+import { createHash } from 'node:crypto';
+
+// The same unmodified bytes reproduce the original defect and test its fix.
+// An extracted source archive obtains these bytes from the pinned SDK build.
+export function readPinnedBaseSlideSdk(): string {
+  const relative = 'sdkjs/slide/sdk-all.js';
+  const materials = process.env.ONLYOFFICE_LICENSE_MATERIALS_DIR || '.temp/licensing';
+  const rebuilt = path.join(materials, 'sdk-base-runtime', relative);
+  const file = fs.existsSync(rebuilt) ? rebuilt : path.join('public', relative);
+  const bytes = fs.readFileSync(file);
+  const lock = JSON.parse(fs.readFileSync('runtime-source-lock.json', 'utf8'));
+  const expected = lock.sdkRebuild.baseOutputs.find((output: { path: string }) => output.path === relative);
+  if (createHash('sha256').update(bytes).digest('hex') !== expected?.sha256)
+    throw new Error('Regression tests require the exact pinned pre-patch slide SDK');
+  return bytes.toString('utf8');
+}
