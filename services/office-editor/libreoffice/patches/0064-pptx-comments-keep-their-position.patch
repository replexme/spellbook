+CPPUNIT_TEST_FIXTURE(SdUiImpressTest, testPptxCommentKeepsItsPosition)
+{
+    createSdImpressDoc();
+    uno::Reference<drawing::XDrawPagesSupplier> xPagesSupplier(mxComponent,
+                                                               uno::UNO_QUERY_THROW);
+    uno::Reference<office::XAnnotationAccess> xAccess(
+        xPagesSupplier->getDrawPages()->getByIndex(0), uno::UNO_QUERY_THROW);
+    uno::Reference<office::XAnnotation> xAnnotation(xAccess->createAndInsertAnnotation());
+    xAnnotation->setAuthor(u"Spellbook AI"_ustr);
+    xAnnotation->setInitials(u"AI"_ustr);
+    xAnnotation->setPosition(geometry::RealPoint2D(8.0, 8.0));
+    xAnnotation->getTextRange()->setString(u"Spellbook comment"_ustr);
+
+    // The threaded comment part, read in preference to the older one, keeps
+    // no position, and reading the older one rounded it to 15.87 mm steps.
+    saveAndReload(TestFilter::PPTX);
+    uno::Reference<drawing::XDrawPagesSupplier> xReloaded(mxComponent, uno::UNO_QUERY_THROW);
+    xAccess.set(xReloaded->getDrawPages()->getByIndex(0), uno::UNO_QUERY_THROW);
+    uno::Reference<office::XAnnotationEnumeration> xAnnotations(
+        xAccess->createAnnotationEnumeration());
+    CPPUNIT_ASSERT(xAnnotations->hasMoreElements());
+    xAnnotation = xAnnotations->nextElement();
+    CPPUNIT_ASSERT_EQUAL(u"AI"_ustr, xAnnotation->getInitials());
+    // One PPTX master unit is 1/576 inch, 0.044 mm.
+    CPPUNIT_ASSERT_DOUBLES_EQUAL(8.0, xAnnotation->getPosition().X, 0.05);
+    CPPUNIT_ASSERT_DOUBLES_EQUAL(8.0, xAnnotation->getPosition().Y, 0.05);
+    CPPUNIT_ASSERT(!xAnnotations->hasMoreElements());
+}
