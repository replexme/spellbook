diff --git a/scripts/rebuild-preferred-sdk.mjs b/scripts/rebuild-preferred-sdk.mjs
new file mode 100644
index 0000000..0c2be16
--- /dev/null
+++ b/scripts/rebuild-preferred-sdk.mjs
@@ -0,0 +1,74 @@
+// SPDX-License-Identifier: AGPL-3.0-only
+import fs from 'node:fs';
+import path from 'node:path';
+import { execFileSync, spawnSync } from 'node:child_process';
+import { createHash } from 'node:crypto';
+import { sdkBuildInputPaths, verifySdkRebuildEvidence } from './sdk-rebuild-evidence.mjs';
+
+const root = path.resolve(import.meta.dirname, '..');
+const materials = path.resolve(process.env.ONLYOFFICE_LICENSE_MATERIALS_DIR || path.join(root, '.temp/licensing'));
+const lock = JSON.parse(fs.readFileSync(path.join(root, 'runtime-source-lock.json'), 'utf8'));
+const source = lock.sources.find((value) => value.id === lock.sdkRebuild.sourceId);
+const archive = path.join(materials, 'upstream', source.archive);
+const sha = (file) => createHash('sha256').update(fs.readFileSync(file)).digest('hex');
+const readBuildInputs = () => sdkBuildInputPaths(lock).map((name) => ({ path: name, sha256: sha(path.join(root, name)) }));
+if (sha(archive) !== source.archiveSha256) throw new Error('Preferred SDK archive changed');
+if (process.platform === 'darwin' && !process.env.JAVA_HOME) throw new Error('Set JAVA_HOME to an installed JDK for background SDK compilation');
+const temporary = fs.mkdtempSync(path.join(materials, 'sdk-rebuild-'));
+const log = fs.openSync(path.join(materials, 'sdk-rebuild.log'), 'w');
+const evidenceFile = path.join(materials, 'sdk-rebuild-evidence.json');
+// A failed rebuild must never retain a previously successful receipt.
+fs.rmSync(evidenceFile, { force: true });
+const env = {
+  ...process.env,
+  APP_COPYRIGHT: lock.sdkRebuild.appCopyright,
+  PRODUCT_VERSION: '0.0.0',
+  BUILD_NUMBER: '0',
+  COMPANY_NAME: 'onlyoffice',
+  PUBLISHER_URL: 'https://www.onlyoffice.com/',
+  JAVA_TOOL_OPTIONS: '-XX:ActiveProcessorCount=1 -Xmx2048m',
+  PATH: (process.env.JAVA_HOME ? path.join(process.env.JAVA_HOME, 'bin') + path.delimiter : '') + process.env.PATH,
+};
+const run = (command, args, cwd = temporary) => execFileSync(command, args, { cwd, env, stdio: ['ignore', log, log], timeout: 3600000 });
+const evidence = { schemaVersion: 1, status: 'running', sourceCommit: source.commit, sourceTree: source.tree, sourceArchiveSha256: source.archiveSha256, startedAt: new Date().toISOString(), baseOutputs: [], patchedOutputs: [], scope: 'Six SDK JavaScript files and local presentation SDK patches only. Excludes web-apps, auxiliary WASM engines and x2t reproduction.' };
+evidence.buildInputs = readBuildInputs();
+try {
+  run('tar', ['-xzf', archive]);
+  const sdk = path.join(temporary, 'sdkjs');
+  const build = path.join(sdk, 'build');
+  evidence.dependencyLockSha256 = sha(path.join(build, 'npm-shrinkwrap.json'));
+  run('npm', ['ci', '--ignore-scripts', '--no-audit', '--no-fund'], build);
+  evidence.nodeVersion = process.version;
+  const java = spawnSync('java', ['-version'], { env, encoding: 'utf8', timeout: 10000 });
+  if (java.error || java.status !== 0) throw new Error('Installed JDK required');
+  evidence.javaVersion = (java.stderr + java.stdout).trim();
+  // The upstream shrinkwrap does not include grunt-cli; invoke the locked
+  // Grunt library directly instead of relying on an unpinned global command.
+  const entry = path.join(build, 'run-sdk-build.cjs');
+  fs.writeFileSync(entry, 'require("./node_modules/grunt").tasks(' + JSON.stringify(lock.sdkRebuild.tasks) + ',' + JSON.stringify({ level: lock.sdkRebuild.level }) + ');\n');
+  run(process.execPath, [entry], build);
+  for (const expected of lock.sdkRebuild.baseOutputs) {
+    const actual = sha(path.join(sdk, 'deploy', expected.path));
+    if (actual !== expected.sha256 || sha(path.join(root, 'public', expected.path)) !== expected.sha256) throw new Error('SDK base output mismatch: ' + expected.path);
+    evidence.baseOutputs.push({ ...expected, exactMatch: true });
+  }
+  const generated = path.join(temporary, 'dist');
+  fs.cpSync(path.join(sdk, 'deploy/sdkjs'), path.join(generated, 'sdkjs'), { recursive: true });
+  run(process.execPath, [path.join(root, 'scripts/apply-local-sdk-patches.mjs'), generated]);
+  for (const expected of lock.sdkRebuild.patchedOutputs) {
+    if (sha(path.join(generated, expected.path)) !== expected.sha256) throw new Error('Patched SDK output mismatch: ' + expected.path);
+    evidence.patchedOutputs.push({ ...expected, exactMatch: true });
+  }
+  evidence.status = 'sdk-js-and-local-patches-reproduced';
+  verifySdkRebuildEvidence(lock, evidence, readBuildInputs());
+} catch (error) {
+  evidence.status = 'failed';
+  evidence.error = String(error.message ?? error);
+  process.exitCode = 1;
+} finally {
+  evidence.finishedAt = new Date().toISOString();
+  fs.writeFileSync(evidenceFile, JSON.stringify(evidence, null, 2) + '\n');
+  fs.closeSync(log);
+  fs.rmSync(temporary, { recursive: true, force: true });
+}
+console.log(JSON.stringify(evidence));
diff --git a/scripts/sdk-rebuild-evidence.mjs b/scripts/sdk-rebuild-evidence.mjs
new file mode 100644
index 0000000..b93b318
--- /dev/null
+++ b/scripts/sdk-rebuild-evidence.mjs
@@ -0,0 +1,29 @@
+// SPDX-License-Identifier: AGPL-3.0-only
+export const sdkBuildInputPaths = (lock) => [
+  'runtime-source-lock.json', 'scripts/rebuild-preferred-sdk.mjs', 'scripts/sdk-rebuild-evidence.mjs', 'scripts/apply-local-sdk-patches.mjs', ...lock.sdkRebuild.patchScripts,
+];
+export function verifySdkRebuildEvidence(lock, evidence, currentInputs) {
+  const source = lock.sources.find((value) => value.id === lock.sdkRebuild?.sourceId);
+  if (!source || evidence?.schemaVersion !== 1 || evidence.status !== 'sdk-js-and-local-patches-reproduced' || evidence.sourceCommit !== source.commit || evidence.sourceTree !== source.tree || evidence.sourceArchiveSha256 !== source.archiveSha256)
+    throw new Error('Matching preferred-source SDK rebuild evidence required');
+  for (const kind of ['baseOutputs', 'patchedOutputs']) {
+    const expected = lock.sdkRebuild[kind];
+    const actual = evidence[kind];
+    if (!expected?.length || actual?.length !== expected.length || new Set(actual.map((value) => value.path)).size !== actual.length)
+      throw new Error('Incomplete or duplicate SDK rebuild outputs: ' + kind);
+    for (const file of expected) {
+      const verified = actual.find((value) => value.path === file.path);
+      if (verified?.exactMatch !== true || verified.sha256 !== file.sha256)
+        throw new Error('SDK rebuild output mismatch: ' + file.path);
+    }
+  }
+  const paths = sdkBuildInputPaths(lock);
+  if (evidence.buildInputs?.length !== paths.length || currentInputs?.length !== paths.length || new Set(evidence.buildInputs.map((file) => file.path)).size !== paths.length)
+    throw new Error('Complete SDK build source identity required');
+  for (const name of paths) {
+    const original = evidence.buildInputs.find((file) => file.path === name);
+    const current = currentInputs.find((file) => file.path === name);
+    if (!original || !current || original.sha256 !== current.sha256) throw new Error('SDK build source changed: ' + name);
+  }
+  return { sdkJavaScriptRebuildVerified: true, upstreamEditorRebuildVerified: false };
+}
