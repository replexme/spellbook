+CPPUNIT_TEST_FIXTURE(SdUiImpressTest, testSpellbookPptxRunLanguageStaysWithItsText)
+{
+    createSdImpressDocModelOnly();
+    uno::Reference<drawing::XDrawPagesSupplier> xPagesSupplier(mxComponent,
+                                                               uno::UNO_QUERY_THROW);
+    uno::Reference<drawing::XShapes> xShapes(xPagesSupplier->getDrawPages()->getByIndex(0),
+                                             uno::UNO_QUERY_THROW);
+    uno::Reference<lang::XMultiServiceFactory> xFactory(mxComponent, uno::UNO_QUERY_THROW);
+    uno::Reference<drawing::XShape> xShape(
+        xFactory->createInstance(u"com.sun.star.drawing.TextShape"_ustr), uno::UNO_QUERY_THROW);
+    xShape->setPosition(awt::Point(1000, 1000));
+    xShape->setSize(awt::Size(8000, 3000));
+    xShapes->add(xShape);
+    uno::Reference<beans::XPropertySet> xShapeProperties(xShape, uno::UNO_QUERY_THROW);
+    xShapeProperties->setPropertyValue(u"Name"_ustr, uno::Any(u"Spoken"_ustr));
+    uno::Reference<text::XText> xText(xShape, uno::UNO_QUERY_THROW);
+    xText->setString(u"Spellbook"_ustr);
+    const auto aWholeText = [](const uno::Reference<text::XText>& xBody) {
+        uno::Reference<text::XTextCursor> xCursor = xBody->createTextCursor();
+        xCursor->gotoStart(false);
+        xCursor->gotoEnd(true);
+        return uno::Reference<beans::XPropertySet>(xCursor, uno::UNO_QUERY_THROW);
+    };
+    // A Korean language on Latin text is what PowerPoint stores on the run.
+    aWholeText(xText)->setPropertyValue(
+        u"CharLocale"_ustr, uno::Any(lang::Locale(u"ko"_ustr, u"KR"_ustr, OUString())));
+
+    saveAndReloadSdImpressDocModelOnly(u"Impress Office Open XML"_ustr);
+    xmlDocUniquePtr pSlideXml = parseExport(u"ppt/slides/slide1.xml"_ustr);
+    assertXPath(pSlideXml, "//*[*/p:cNvPr/@name='Spoken']/p:txBody/a:p/a:r/a:rPr", "lang",
+                u"ko-KR"_ustr);
+
+    // Reading the run's language back into the locale of the language's own
+    // script would leave Latin text at the document default, and the next save
+    // would write that default over the language PowerPoint shows.
+    uno::Reference<container::XIndexAccess> xPage(
+        uno::Reference<drawing::XDrawPagesSupplier>(mxComponent, uno::UNO_QUERY_THROW)
+            ->getDrawPages()
+            ->getByIndex(0),
+        uno::UNO_QUERY_THROW);
+    for (sal_Int32 nShape = 0; nShape < xPage->getCount(); ++nShape)
+    {
+        uno::Reference<beans::XPropertySet> xReloaded(xPage->getByIndex(nShape),
+                                                      uno::UNO_QUERY_THROW);
+        if (xReloaded->getPropertyValue(u"Name"_ustr).get<OUString>() != u"Spoken"_ustr)
+            continue;
+        uno::Reference<text::XText> xReloadedText(xPage->getByIndex(nShape), uno::UNO_QUERY_THROW);
+        CPPUNIT_ASSERT_EQUAL(u"Spellbook"_ustr, xReloadedText->getString());
+        const lang::Locale aLocale
+            = aWholeText(xReloadedText)->getPropertyValue(u"CharLocale"_ustr).get<lang::Locale>();
+        CPPUNIT_ASSERT_EQUAL(u"ko"_ustr, aLocale.Language);
+        CPPUNIT_ASSERT_EQUAL(u"KR"_ustr, aLocale.Country);
+        return;
+    }
+    CPPUNIT_FAIL("spoken text not found");
+}
