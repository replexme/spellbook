+CPPUNIT_TEST_FIXTURE(SdUiImpressTest, testSpellbookAutoAdvanceKeepsTransitionEffectOnReload)
+{
+    createSdImpressDocModelOnly();
+    uno::Reference<drawing::XDrawPagesSupplier> xPagesSupplier(mxComponent,
+                                                               uno::UNO_QUERY_THROW);
+    uno::Reference<beans::XPropertySet> xPageProperties(
+        xPagesSupplier->getDrawPages()->getByIndex(0), uno::UNO_QUERY_THROW);
+    xPageProperties->setPropertyValue("TransitionType", uno::Any(sal_Int16(37)));
+    xPageProperties->setPropertyValue("TransitionSubtype", uno::Any(sal_Int16(101)));
+    xPageProperties->setPropertyValue("HighResDuration", uno::Any(5.0));
+    xPageProperties->setPropertyValue("Change", uno::Any(sal_Int32(1)));
+
+    // advTm and the visual effect share one p:transition; reloading must keep both.
+    saveAndReloadSdImpressDocModelOnly("Impress Office Open XML");
+    xPagesSupplier.set(mxComponent, uno::UNO_QUERY_THROW);
+    xPageProperties.set(xPagesSupplier->getDrawPages()->getByIndex(0), uno::UNO_QUERY_THROW);
+    sal_Int16 nValue = 0;
+    double fValue = 0.0;
+    sal_Int32 nChange = 0;
+    CPPUNIT_ASSERT(xPageProperties->getPropertyValue("TransitionType") >>= nValue);
+    CPPUNIT_ASSERT_EQUAL(sal_Int16(37), nValue);
+    CPPUNIT_ASSERT(xPageProperties->getPropertyValue("TransitionSubtype") >>= nValue);
+    CPPUNIT_ASSERT_EQUAL(sal_Int16(101), nValue);
+    CPPUNIT_ASSERT(xPageProperties->getPropertyValue("HighResDuration") >>= fValue);
+    CPPUNIT_ASSERT_DOUBLES_EQUAL(5.0, fValue, 0.001);
+    CPPUNIT_ASSERT(xPageProperties->getPropertyValue("Change") >>= nChange);
+    CPPUNIT_ASSERT_EQUAL(sal_Int32(1), nChange);
+}
