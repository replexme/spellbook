+
+// Duplicates the object directly above itself with one native Undo action.
+// The browser runtime has no system clipboard, so Copy and Paste inserted
+// nothing there.
+void applySpellbookObjectDuplication(SdrObject* pObject, SdDrawDocument* pDocument,
+                                     const uno::Any& rValue)
+{
+    bool bDuplicate = false;
+    if (!(rValue >>= bDuplicate) || !bDuplicate)
+        throw lang::IllegalArgumentException(u"Invalid duplicate request"_ustr, nullptr, 0);
+    SdrObjList* pList = pObject ? pObject->getParentSdrObjListFromSdrObject() : nullptr;
+    if (!pObject || !pDocument || !pList)
+        throw lang::IllegalArgumentException(u"Duplicate target is unavailable"_ustr, nullptr, 0);
+    rtl::Reference<SdrObject> pClone(pObject->CloneSdrObject(pObject->getSdrModelFromSdrObject()));
+    if (!pClone)
+        throw lang::IllegalArgumentException(u"Object cannot be duplicated"_ustr, nullptr, 0);
+    std::unordered_set<OUString> aNameSet;
+    pList->InsertObjectThenMakeNameUnique(pClone.get(), aNameSet, pObject->GetOrdNum() + 1);
+    if (pDocument->IsUndoEnabled())
+        pDocument->AddUndo(pDocument->GetSdrUndoFactory().CreateUndoNewObject(*pClone));
+}
 }
 
