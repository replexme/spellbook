+/** The a:prstDash value of a relative MS Office dash, or null. Import tweaks
+    the lengths of a preset dash for the line cap; this reverts that. */
+const char* lcl_GetPresetDash(const LineDash& rLineDash, LineCap eLineCap)
+{
+    const bool bIsRelative(rLineDash.Style == DashStyle_RECTRELATIVE
+                           || rLineDash.Style == DashStyle_ROUNDRELATIVE);
+    if (!bIsRelative || rLineDash.Dots != 1)
+        return nullptr;
+    sal_uInt32 nDotLen = rLineDash.DotLen;
+    sal_uInt32 nDashLen = rLineDash.DashLen;
+    sal_uInt32 nDistance = rLineDash.Distance;
+    if (eLineCap != LineCap_BUTT && nDistance >= 99)
+    {
+        nDistance -= 99;
+        nDotLen += 99;
+        if (nDashLen > 0)
+            nDashLen += 99;
+    }
+    // LO uses length 0 for 100%, if the attribute is missing in ODF.
+    // Other applications might write 100%. Make is unique for the conditions.
+    if (nDotLen == 0)
+        nDotLen = 100;
+    if (nDashLen == 0 && rLineDash.Dashes > 0)
+        nDashLen = 100;
+    if (nDotLen == 100 && rLineDash.Dashes == 0 && nDashLen == 0 && nDistance == 300)
+        return "dot";
+    if (nDotLen == 400 && rLineDash.Dashes == 0 && nDashLen == 0 && nDistance == 300)
+        return "dash";
+    if (nDotLen == 400 && rLineDash.Dashes == 1 && nDashLen == 100 && nDistance == 300)
+        return "dashDot";
+    if (nDotLen == 800 && rLineDash.Dashes == 0 && nDashLen == 0 && nDistance == 300)
+        return "lgDash";
+    if (nDotLen == 800 && rLineDash.Dashes == 1 && nDashLen == 100 && nDistance == 300)
+        return "lgDashDot";
+    if (nDotLen == 800 && rLineDash.Dashes == 2 && nDashLen == 100 && nDistance == 300)
+        return "lgDashDotDot";
+    if (nDotLen == 100 && rLineDash.Dashes == 0 && nDashLen == 0 && nDistance == 100)
+        return "sysDot";
+    if (nDotLen == 300 && rLineDash.Dashes == 0 && nDashLen == 0 && nDistance == 100)
+        return "sysDash";
+    if (nDotLen == 300 && rLineDash.Dashes == 1 && nDashLen == 100 && nDistance == 100)
+        return "sysDashDot";
+    if (nDotLen == 300 && rLineDash.Dashes == 2 && nDashLen == 100 && nDistance == 100)
+        return "sysDashDotDot";
+    return nullptr;
+}
+}
+
+OUString DrawingML::GetPresetLineDash(const Reference<XPropertySet>& rXPropSet)
+{
+    drawing::LineStyle eLineStyle = drawing::LineStyle_NONE;
+    rXPropSet->getPropertyValue(u"LineStyle"_ustr) >>= eLineStyle;
+    if (eLineStyle == drawing::LineStyle_NONE)
+        return OUString();
+    if (eLineStyle != drawing::LineStyle_DASH)
+        return u"solid"_ustr;
+    LineDash aLineDash;
+    rXPropSet->getPropertyValue(u"LineDash"_ustr) >>= aLineDash;
+    LineCap eLineCap = LineCap_BUTT;
+    rXPropSet->getPropertyValue(u"LineCap"_ustr) >>= eLineCap;
+    const char* pPresetDash = lcl_GetPresetDash(aLineDash, eLineCap);
+    return pPresetDash ? OUString::createFromAscii(pPresetDash) : u"custom"_ustr;
+}
+
+OUString DrawingML::GetPresetLineArrow(const Reference<XPropertySet>& rXPropSet, bool bLineStart)
+{
+    ESCHER_LineEnd eLineEnd;
+    sal_Int32 nArrowLength;
+    sal_Int32 nArrowWidth;
+    if (!EscherPropertyContainer::GetLineArrow(bLineStart, rXPropSet, eLineEnd, nArrowLength,
+                                               nArrowWidth)
+        || eLineEnd == ESCHER_LineNoEnd)
+        return u"none"_ustr;
+    const LineArrowTokens aTokens = lcl_GetLineArrowTokens(eLineEnd, nArrowLength, nArrowWidth);
+    return OUString::createFromAscii(aTokens.pType) + " "
+           + OUString::createFromAscii(aTokens.pWidth) + " "
+           + OUString::createFromAscii(aTokens.pLength);
+}
