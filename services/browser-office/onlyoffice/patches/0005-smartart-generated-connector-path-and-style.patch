+++ b/test/unit/smartart-line-path.test.ts
@@ -0,0 +1,84 @@
+import { readFileSync } from 'node:fs';
+import vm from 'node:vm';
+import { describe, expect, it } from 'vitest';
+import { patchSmartArtLinePathFill } from '../../scripts/patch-onlyoffice-smartart-line-path.mjs';
+
+const source = readFileSync('public/sdkjs/slide/sdk-all.js', 'utf8');
+function generatedLine(text: string) {
+  class ShadowShape {}
+  const history: string[] = [];
+  const paths: { fill: string; commands: unknown[][]; setFill: (value: string) => void }[] = [];
+  const geometry = {
+    pathLst: paths,
+    AddPathCommand(...command: unknown[]) {
+      if (command[0] === 0) {
+        const path = {
+          fill: 'norm',
+          commands: [] as unknown[][],
+          setFill(value: string) {
+            this.fill = value;
+            history.push(value);
+          },
+        };
+        paths.push(path);
+      } else paths.at(-1)!.commands.push(command);
+    },
+  };
+  const noop = () => {};
+  const shape = {
+    spPr: { geometry, setFill: noop, setLn: noop, xfrm: { setExtX: noop, setExtY: noop } },
+    setBDeleted: noop,
+    setParent: noop,
+    setWorksheet: noop,
+  };
+  class NewShapeTrack {
+    track() {}
+    getShape() {
+      return shape;
+    }
+  }
+  const context = vm.createContext({ ShadowShape, AscFormat: { NewShapeTrack } });
+  const start = text.indexOf('ShadowShape.prototype.getEditorLine=function(');
+  vm.runInContext(text.slice(start, text.indexOf('ShadowShape.prototype.getEditorShape=', start)), context);
+  const shadow = new ShadowShape() as any;
+  Object.assign(shadow, {
+    x: 0,
+    y: 0,
+    width: 30,
+    height: 50,
+    // An open orthogonal connector encloses an unintended triangle when filled.
+    customGeom: [[0], [1, 0, 0], [2, 0, 900000], [2, 1080000, 900000]],
+    applyPostEditorSettings: () => {},
+  });
+  shadow.getEditorLine({});
+  return { paths, history };
+}
+
+describe('SmartArt generated connector path fill', () => {
+  it('reproduces the filled open path in the pinned SDK', () => {
+    expect(generatedLine(source).paths[0].fill).toBe('norm');
+  });
+  it('uses native path history to preserve the open stroke without a filled polygon', () => {
+    const { paths, history } = generatedLine(patchSmartArtLinePathFill(source));
+    expect(paths[0].fill).toBe('none');
+    expect(history).toEqual(['none']);
+    expect(paths[0].commands).toEqual([
+      [1, '0', '0'],
+      [2, '0', '900000'],
+      [2, '1080000', '900000'],
+    ]);
+  });
+  it('leaves all non-line shape generation unchanged', () => {
+    const boundary = source.indexOf('ShadowShape.prototype.getEditorShape=');
+    const patched = patchSmartArtLinePathFill(source);
+    expect(patched.slice(patched.indexOf('ShadowShape.prototype.getEditorShape='))).toBe(source.slice(boundary));
+  });
+  it('is idempotent and refuses unknown native boundaries', () => {
+    const patched = patchSmartArtLinePathFill(source);
+    expect(patchSmartArtLinePathFill(patched)).toBe(patched);
+    expect(() => patchSmartArtLinePathFill('unknown SDK')).toThrow();
+    expect(() =>
+      patchSmartArtLinePathFill(source.replace('geometry.AddPathCommand.apply(geometry,custCommand)', 'unknown()')),
+    ).toThrow();
+  });
+});
diff --git a/test/unit/smartart-transition-style.test.ts b/test/unit/smartart-transition-style.test.ts
