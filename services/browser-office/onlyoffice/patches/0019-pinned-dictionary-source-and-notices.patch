+  const root = fs.mkdtempSync(path.join(os.tmpdir(), 'office-dictionary-notices-'));
+  try {
+    const source = path.join(root, 'source/dictionaries/en_US'), output = path.join(root, 'dist/dictionaries/en_US');
+    fs.mkdirSync(source, { recursive: true }); fs.mkdirSync(output, { recursive: true });
+    for (const [name, value] of Object.entries({ 'en_US.aff': 'SET UTF-8', 'en_US.dic': '1\nword', 'hyph_en_US.dic': 'UTF-8\n.wo1rd', 'README_en_US.txt': 'Original author and permission', 'license.txt': 'Original terms' })) fs.writeFileSync(path.join(source, name), value);
