+CPPUNIT_TEST_FIXTURE(SdUiImpressTest, testFreeformIsPptxCustomGeometry)
+{
+    createSdImpressDoc();
+    uno::Reference<drawing::XDrawPagesSupplier> xPagesSupplier(mxComponent,
+                                                               uno::UNO_QUERY_THROW);
+    uno::Reference<drawing::XShapes> xShapes(xPagesSupplier->getDrawPages()->getByIndex(0),
+                                             uno::UNO_QUERY_THROW);
+    uno::Reference<lang::XMultiServiceFactory> xFactory(mxComponent, uno::UNO_QUERY_THROW);
+    const auto customShapeType = [](const uno::Reference<beans::XPropertySet>& xProperties) {
+        cpo::uno::Sequence<beans::PropertyValue> aGeometry;
+        xProperties->getPropertyValue(u"CustomShapeGeometry"_ustr) >>= aGeometry;
+        OUString aType;
+        for (const beans::PropertyValue& rProperty : aGeometry)
+            if (rProperty.Name == "Type")
+                rProperty.Value >>= aType;
+        return aType;
+    };
+    const auto addFreeform = [&](const OUString& rName, const OUString& rProperty,
+                                 sal_Int32 nY) {
+        uno::Reference<drawing::XShape> xShape(
+            xFactory->createInstance(u"com.sun.star.drawing.CustomShape"_ustr),
+            uno::UNO_QUERY_THROW);
+        xShape->setPosition(awt::Point(15000, nY));
+        xShape->setSize(awt::Size(2600, 1800));
+        xShapes->add(xShape);
+        uno::Reference<beans::XPropertySet> xProperties(xShape, uno::UNO_QUERY_THROW);
+        xProperties->setPropertyValue(u"Name"_ustr, cpo::uno::Any(rName));
+        xProperties->setPropertyValue(
+            rProperty,
+            cpo::uno::Any(cpo::uno::Sequence<cpo::uno::Sequence<awt::Point>>{
+                { awt::Point(0, 1700), awt::Point(1200, 0), awt::Point(2500, 1700) } }));
+        return xProperties;
+    };
+    uno::Reference<beans::XPropertySet> xClosed
+        = addFreeform(u"Closed"_ustr, u"SpellbookFreeformPolygon"_ustr, 1000);
+    addFreeform(u"Open"_ustr, u"SpellbookFreeformPolyline"_ustr, 5000);
+    CPPUNIT_ASSERT_EQUAL(u"ooxml-non-primitive"_ustr, customShapeType(xClosed));
+
+    // A freeform is the custom geometry PPTX import creates for a:custGeom,
+    // so saving and reopening keeps the same kind of object.
+    saveAndReload(TestFilter::PPTX);
+    xmlDocUniquePtr pSlideXml = parseExport(u"ppt/slides/slide1.xml"_ustr);
+    assertXPath(pSlideXml,
+                "//p:sp[p:nvSpPr/p:cNvPr/@name='Closed']/p:spPr/a:custGeom/a:pathLst/a:path/a:lnTo",
+                2);
+    assertXPath(pSlideXml,
+                "//p:sp[p:nvSpPr/p:cNvPr/@name='Closed']/p:spPr/a:custGeom/a:pathLst/a:path/a:close",
+                1);
+    assertXPath(pSlideXml,
+                "//p:sp[p:nvSpPr/p:cNvPr/@name='Open']/p:spPr/a:custGeom/a:pathLst/a:path/a:close",
+                0);
+    uno::Reference<drawing::XDrawPagesSupplier> xReloaded(mxComponent, uno::UNO_QUERY_THROW);
+    uno::Reference<container::XIndexAccess> xPage(xReloaded->getDrawPages()->getByIndex(0),
+                                                  uno::UNO_QUERY_THROW);
+    for (sal_Int32 nShape = 0; nShape < xPage->getCount(); ++nShape)
+    {
+        uno::Reference<drawing::XShape> xShape(xPage->getByIndex(nShape), uno::UNO_QUERY_THROW);
+        uno::Reference<beans::XPropertySet> xProperties(xShape, uno::UNO_QUERY_THROW);
+        OUString aName;
+        xProperties->getPropertyValue(u"Name"_ustr) >>= aName;
+        if (aName != u"Closed"_ustr)
+            continue;
+        CPPUNIT_ASSERT_EQUAL(u"com.sun.star.drawing.CustomShape"_ustr, xShape->getShapeType());
+        CPPUNIT_ASSERT_EQUAL(u"ooxml-non-primitive"_ustr, customShapeType(xProperties));
+        return;
+    }
+    CPPUNIT_FAIL("freeform not found");
+}
