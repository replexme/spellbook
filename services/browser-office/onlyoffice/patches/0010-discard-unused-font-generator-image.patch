+
+test('failed generation removes its unused Docker image and staged inputs', () => {
+  const input = makeTempDir();
+  const output = makeTempDir();
+  const commands = path.join(input, 'docker-commands.log');
+  const executable = path.join(input, 'docker');
+  fs.writeFileSync(path.join(input, 'font.ttf'), 'input');
+  fs.writeFileSync(executable, '#!/bin/sh\nprintf "%s\\n" "$*" >> "' + commands + '"\n');
+  fs.chmodSync(executable, 0o755);
+  const originalPath = process.env.PATH;
+  process.env.PATH = input + path.delimiter + originalPath;
+  try {
+    expect(() =>
+      generateOnlyOfficeFontAssets(
+        parseGenerateFontAssetsArgs(['--input', input, '--output', output, '--font-set', 'full'], {}),
+      ),
+    ).toThrow('Generated asset is missing');
+    expect(fs.readFileSync(commands, 'utf8')).toContain('image rm ' + DEFAULT_FONT_GENERATOR_IMAGE);
+    expect(
+      fs.readdirSync(path.dirname(output)).some((name) => name.startsWith('.onlyoffice-browser-font-input-')),
+    ).toBe(false);
+  } finally {
+    process.env.PATH = originalPath;
+  }
+});
