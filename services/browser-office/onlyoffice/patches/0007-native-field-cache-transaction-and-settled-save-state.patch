+// SPDX-License-Identifier: AGPL-3.0-only
+// Pinned sdkjs 9.3: generated presentation fields must participate in an open
+// native action group, so cancellation and Undo cannot leave warmed layout
+// caches behind. Ordinary rendering retains the upstream no-history behavior.
+import assert from 'node:assert/strict';
+import { createHash } from 'node:crypto';
+import { readFile, writeFile } from 'node:fs/promises';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { brotliCompressSync, constants } from 'node:zlib';
+const inputHash = '15ff9dd1544b118854b92208957de7b524de4e167ed597b9aa68c59eeed8d016';
+const anchor = 'CPresentationField.prototype.private_CalculateContent=function(){';
+const addition = '/* spellbook-field-cache-history-v1 */if(Asc.editor&&Asc.editor.isGroupActions&&Asc.editor.isGroupActions()&&!AscCommon.History.UndoRedoInProgress){var value=this.private_GetString();if(typeof value!=="string"||this.GetText()===value)return;var selected=this.IsSelectionUse(),selection=this.State.Selection,direction=selection.EndPos-selection.StartPos,allow=this.CanAddToContent,history=AscCommon.History,depth=history.TurnOffHistory;for(var i=0;i<depth;i++)history.TurnOn();try{if(!history.CanAddChanges())throw new Error("field_cache_history_unavailable");this.CanAddToContent=true;ParaRun.prototype.Remove_FromContent.call(this,0,this.Content.length,true);this.AddText(value,-1);if(selected)this.SelectAll(direction)}finally{this.CanAddToContent=allow;for(var i=0;i<depth;i++)history.TurnOff()}return;}';
+const contextAnchor = 'MasterSlide.prototype.drawNoPlaceholders=function(graphics,slide){';
+const contextHelper = '/* spellbook-field-context-history-v1 */AscFormat.spellbookRestoreFieldContext=function(target,next){target.lastRecalcSlideIndex=next};AscFormat.spellbookSetFieldContext=function(object,value){var h=AscCommon.History;if(Asc.editor&&Asc.editor.isGroupActions&&Asc.editor.isGroupActions()&&!h.UndoRedoInProgress&&object.lastRecalcSlideIndex!==value){var type=object.getObjectType()|65500;if(!AscDFH.changesFactory[type]&&!AscDFH.drawingsChangesMap[type]){AscDFH.changesFactory[type]=AscDFH.CChangesDrawingsDouble2;AscDFH.drawingsChangesMap[type]=AscFormat.spellbookRestoreFieldContext}else if(AscDFH.changesFactory[type]!==AscDFH.CChangesDrawingsDouble2||AscDFH.drawingsChangesMap[type]!==AscFormat.spellbookRestoreFieldContext)throw new Error("field_context_history_collision");var depth=h.TurnOffHistory;for(var i=0;i<depth;i++)h.TurnOn();try{if(!h.CanAddChanges())throw new Error("field_context_history_unavailable");h.Add(new AscDFH.CChangesDrawingsDouble2(object,type,object.lastRecalcSlideIndex,value))}finally{for(var i=0;i<depth;i++)h.TurnOff()}}object.lastRecalcSlideIndex=value;};';
+const contextReplacements = [
+ ['this.lastRecalcSlideIndex=slide.num;this.cSld.refreshAllContentsFields(true)', 'AscFormat.spellbookSetFieldContext(this,slide.num);this.cSld.refreshAllContentsFields(true)'],
+ ['this.lastRecalcSlideIndex=-1;this.cSld.refreshAllContentsFields(true)', 'AscFormat.spellbookSetFieldContext(this,-1);this.cSld.refreshAllContentsFields(true)'],
+];
+export function unpatchFieldCacheHistory(source) {
+ source=source.replace(addition,'').replace(contextHelper,'');
+ for(const [before,after] of contextReplacements)source=source.split(after).join(before);
+ return source;
+}
+export function patchFieldCacheHistory(source) {
+  assert(source.split(anchor).length === 2, 'Pinned presentation field boundary changed');
+  if(source.includes(addition)) {
+    assert(source.includes(anchor+addition),'Misplaced native field cache history');
+    assert(source.includes(contextHelper),'Missing field context history');
+    return source;
+  }
+  const start=source.indexOf(anchor),end=source.indexOf('CPresentationField.prototype.GetFieldType=',start);
+  assert(end>start && source.slice(start,end).includes('this.Content.length=0;this.AddText(sStr,-1);'),'Pinned generated-field calculation changed');
+  assert(source.split(contextAnchor).length===2,'Pinned master drawing boundary changed');
+  for(const [before,after] of contextReplacements){assert(source.split(before).length===7,'Pinned six master/layout drawing contexts changed');source=source.split(before).join(after)}
+  return source.replace(contextAnchor,contextHelper+contextAnchor).replace(anchor,anchor+addition);
+}
+
+if (process.argv[1] && path.resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
+  const root = path.resolve(process.argv[2] || '');
+  assert(path.basename(root) === 'dist', 'Only generated dist assets may be patched');
+  const target = path.join(root, 'sdkjs/slide/sdk-all.js');
+  const source = await readFile(target, 'utf8');
+  const hash = (text) => createHash('sha256').update(text).digest('hex');
+  assert(hash(unpatchFieldCacheHistory(source)) === inputHash, 'Unexpected SDK asset');
+  const patched = patchFieldCacheHistory(source);
+  await writeFile(target, patched);
+  await writeFile(target + '.br', brotliCompressSync(Buffer.from(patched), { params: { [constants.BROTLI_PARAM_QUALITY]: 5 } }));
+  console.log(JSON.stringify({ patch: 'spellbook-field-cache-history-v1', before: hash(source), after: hash(patched) }));
+}
