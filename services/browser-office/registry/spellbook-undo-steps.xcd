<?xml version="1.0" encoding="UTF-8"?>
<!-- Every edit, the AI's included, is one native Undo step, and the shared
     operation program confirms an edit by the Undo list growing. At
     LibreOffice's default of 100 steps the list stops growing once full, so
     from about the hundredth edit of a session every edit was refused as
     unrecorded. 1000 is the largest value LibreOffice's options offer. -->
<oor:data xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:oor="http://openoffice.org/2001/registry">
  <dependency file="main"/>
  <oor:component-data oor:name="Common" oor:package="org.openoffice.Office">
    <node oor:name="Undo">
      <prop oor:name="Steps" oor:op="fuse">
        <value>1000</value>
      </prop>
    </node>
  </oor:component-data>
</oor:data>
