+namespace
+{
+// Applying an item set to a text object also copies the first paragraph's
+// attributes into the object item set (TextProperties::ItemSetChanged).
+// Undo and Redo apply the saved set while the object still holds the other
+// state's text, so a character attribute the saved set does not contain
+// (for example the shadow added with the object selected) was copied back and
+// survived at object level. Once the saved text is back, the saved set is
+// authoritative for the text items.
+void lcl_RestoreSavedTextItems(SdrObject& rObject, const SfxItemSet& rSaved)
+{
+    std::vector<sal_uInt16> aStale;
+    const SfxItemSet& rCurrent = rObject.GetMergedItemSet();
+    for (sal_uInt16 nWhich = EE_ITEMS_START; nWhich <= EE_ITEMS_END; ++nWhich)
+        if (rSaved.GetItemState(nWhich, false) != SfxItemState::SET
+            && rCurrent.GetItemState(nWhich, false) == SfxItemState::SET)
+            aStale.push_back(nWhich);
+    for (const sal_uInt16 nWhich : aStale)
+        rObject.GetProperties().ClearObjectItemDirect(nWhich);
+}
+}
