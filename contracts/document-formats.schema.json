{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spellbook.replex.me/contracts/document-formats.schema.json",
  "title": "Spellbook document format registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "formats"],
  "properties": {
    "contractVersion": { "const": "1.0" },
    "formats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "availability",
          "extensions",
          "mimeTypes",
          "maxBytes",
          "editor",
          "semantics"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
          "label": { "type": "string", "minLength": 1 },
          "availability": {
            "enum": ["beta", "experimental", "planned", "unsupported"]
          },
          "extensions": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^\\.[a-z0-9]+$" }
          },
          "mimeTypes": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 3 }
          },
          "maxBytes": { "type": "integer", "minimum": 1 },
          "editor": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind"],
            "properties": {
              "kind": {
                "enum": ["browser", "native", "none"],
                "description": "browser: opened in the browser document view; native: a planned Spellbook editor; none: no editor yet."
              }
            }
          },
          "semantics": {
            "type": "object",
            "additionalProperties": false,
            "required": ["unit", "rootCollection", "outputKind"],
            "properties": {
              "unit": { "type": "string", "minLength": 1 },
              "rootCollection": { "type": "string", "minLength": 1 },
              "outputKind": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
