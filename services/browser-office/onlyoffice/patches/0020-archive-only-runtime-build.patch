+++ b/scripts/wrapper-source-files.test.mjs
@@ -0,0 +1,46 @@
+// SPDX-License-Identifier: AGPL-3.0-only
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import { execFileSync } from 'node:child_process';
+import { isWrapperSourceFile, wrapperSourceFiles, packageWrapperSource, WRAPPER_SOURCE_MANIFEST } from './wrapper-source-files.mjs';
+
+test('wrapper excludes every generated third-party runtime tree including dictionaries', () => {
+  for (const directory of ['sdkjs', 'web-apps', 'wasm', 'fonts', 'fixtures', 'dictionaries'])
+    assert.equal(isWrapperSourceFile('public/' + directory + '/old-data'), false);
+  for (const file of ['../secret', '/secret', 'a/../../secret', 'a\\..\\secret', ''])
+    assert.equal(isWrapperSourceFile(file), false);
+  assert.equal(isWrapperSourceFile('scripts/rebuild-preferred-sdk.mjs'), true);
+});
+test('source archive rebuild uses its packaged manifest without a Git checkout', () => {
+  const root = fs.mkdtempSync(path.join(os.tmpdir(), 'wrapper-source-'));
+  try {
+    fs.writeFileSync(path.join(root, 'build.sh'), 'build');
+    fs.writeFileSync(path.join(root, WRAPPER_SOURCE_MANIFEST), JSON.stringify(['build.sh']));
+    assert.deepEqual(wrapperSourceFiles(root), ['build.sh']);
+    fs.writeFileSync(path.join(root, WRAPPER_SOURCE_MANIFEST), JSON.stringify(['public/dictionaries/old.dic']));
+    assert.throws(() => wrapperSourceFiles(root), /Invalid wrapper/);
+    fs.writeFileSync(path.join(root, WRAPPER_SOURCE_MANIFEST), JSON.stringify(['missing.sh']));
+    assert.throws(() => wrapperSourceFiles(root), /Missing wrapper/);
+    fs.symlinkSync('build.sh', path.join(root, 'link.sh'));
+    fs.writeFileSync(path.join(root, WRAPPER_SOURCE_MANIFEST), JSON.stringify(['link.sh']));
+    assert.throws(() => wrapperSourceFiles(root), /Non-file wrapper/);
+  } finally { fs.rmSync(root, { recursive: true, force: true }); }
+});
+
+test('packaged source archive preserves files and can package itself without Git', () => {
+  const root = fs.mkdtempSync(path.join(os.tmpdir(), 'wrapper-package-'));
+  try {
+    const source = path.join(root, 'source'), materials = path.join(root, 'materials'), extracted = path.join(root, 'extracted');
+    for (const dir of [source, materials, extracted]) fs.mkdirSync(dir);
+    fs.writeFileSync(path.join(source, 'build.sh'), 'actual source bytes');
+    fs.writeFileSync(path.join(source, WRAPPER_SOURCE_MANIFEST), JSON.stringify(['build.sh']));
+    const archive = path.join(root, 'source.tar.gz'); packageWrapperSource(source, archive, materials);
+    execFileSync('tar', ['-xzf', archive, '-C', extracted]);
+    assert.equal(fs.readFileSync(path.join(extracted, 'build.sh'), 'utf8'), 'actual source bytes');
+    assert.deepEqual(wrapperSourceFiles(extracted), ['build.sh']);
+    packageWrapperSource(extracted, path.join(root, 'rebuilt.tar.gz'), materials);
+  } finally { fs.rmSync(root, { recursive: true, force: true }); }
+});
