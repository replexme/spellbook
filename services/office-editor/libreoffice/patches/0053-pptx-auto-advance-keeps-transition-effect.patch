+CPPUNIT_TEST_FIXTURE(SdUiImpressTest, testAutoAdvanceKeepsTransitionEffectOnReload)
+{
+    createSdImpressDoc();
+    auto pImpressDocument = dynamic_cast<SdXImpressDocument*>(mxComponent.get());
+    CPPUNIT_ASSERT(pImpressDocument);
+    SdPage* pPage = pImpressDocument->GetDoc()->GetSdPage(0, PageKind::Standard);
+    CPPUNIT_ASSERT(pPage);
+    uno::Reference<beans::XPropertySet> xPageProperties(pPage->getUnoPage(),
+                                                        uno::UNO_QUERY_THROW);
+    xPageProperties->setPropertyValue(u"TransitionType"_ustr, uno::Any(sal_Int16(37)));
+    xPageProperties->setPropertyValue(u"TransitionSubtype"_ustr, uno::Any(sal_Int16(101)));
+    xPageProperties->setPropertyValue(u"HighResDuration"_ustr, uno::Any(5.0));
+    xPageProperties->setPropertyValue(u"Change"_ustr, uno::Any(sal_Int32(1)));
+
+    // advTm and the visual effect share one p:transition; reloading must keep both.
+    saveAndReload(TestFilter::PPTX);
+    pImpressDocument = dynamic_cast<SdXImpressDocument*>(mxComponent.get());
+    CPPUNIT_ASSERT(pImpressDocument);
+    pPage = pImpressDocument->GetDoc()->GetSdPage(0, PageKind::Standard);
+    CPPUNIT_ASSERT(pPage);
+    xPageProperties.set(pPage->getUnoPage(), uno::UNO_QUERY_THROW);
+    sal_Int16 nValue = 0;
+    CPPUNIT_ASSERT(xPageProperties->getPropertyValue(u"TransitionType"_ustr) >>= nValue);
+    CPPUNIT_ASSERT_EQUAL(sal_Int16(37), nValue);
+    CPPUNIT_ASSERT(xPageProperties->getPropertyValue(u"TransitionSubtype"_ustr) >>= nValue);
+    CPPUNIT_ASSERT_EQUAL(sal_Int16(101), nValue);
+    CPPUNIT_ASSERT_DOUBLES_EQUAL(5.0, pPage->GetTime(), 0.001);
+    CPPUNIT_ASSERT(pPage->GetPresChange() == PresChange::Auto);
+}
