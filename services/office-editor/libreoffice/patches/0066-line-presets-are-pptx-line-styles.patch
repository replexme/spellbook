+    assertXPath(pSlideXml, "//*[*/p:cNvPr/@name='Styled']/p:spPr/a:ln/a:headEnd", "type",
+                u"triangle"_ustr);
+    assertXPath(pSlideXml, "//*[*/p:cNvPr/@name='Styled']/p:spPr/a:ln/a:headEnd", "w",
+                u"med"_ustr);
+    assertXPath(pSlideXml, "//*[*/p:cNvPr/@name='Styled']/p:spPr/a:ln/a:headEnd", "len",
+                u"lg"_ustr);
+    assertXPath(pSlideXml, "//*[*/p:cNvPr/@name='Styled']/p:spPr/a:ln/a:tailEnd", "type",
+                u"oval"_ustr);
+    assertXPath(pSlideXml, "//*[*/p:cNvPr/@name='Styled']/p:spPr/a:ln/a:tailEnd", "w",
+                u"sm"_ustr);
+    assertXPath(pSlideXml, "//*[*/p:cNvPr/@name='Styled']/p:spPr/a:ln/a:tailEnd", "len",
+                u"sm"_ustr);
+    uno::Reference<container::XIndexAccess> xPage(
+        uno::Reference<drawing::XDrawPagesSupplier>(mxComponent, uno::UNO_QUERY_THROW)
+            ->getDrawPages()
+            ->getByIndex(0),
+        uno::UNO_QUERY_THROW);
+    for (sal_Int32 nShape = 0; nShape < xPage->getCount(); ++nShape)
+    {
+        uno::Reference<beans::XPropertySet> xStyled(xPage->getByIndex(nShape),
+                                                    uno::UNO_QUERY_THROW);
+        if (xStyled->getPropertyValue(u"Name"_ustr).get<OUString>() != u"Styled"_ustr)
+            continue;
+        CPPUNIT_ASSERT_EQUAL(u"lgDashDot|triangle med lg|oval sm sm"_ustr, presets(xStyled));
+        // A solid line and no line end clear them.
+        xStyled->setPropertyValue(u"SpellbookLineDash"_ustr, cpo::uno::Any(u"solid"_ustr));
+        xStyled->setPropertyValue(u"SpellbookLineStartArrow"_ustr, cpo::uno::Any(u"none"_ustr));
+        CPPUNIT_ASSERT_EQUAL(u"solid|none|oval sm sm"_ustr, presets(xStyled));
+        return;
+    }
+    CPPUNIT_FAIL("styled line not found");
+}
