+CPPUNIT_TEST_FIXTURE(SdUiImpressTest, testSpellbookPptxConnectorKeepsItsEndPoints)
+{
+    createSdImpressDocModelOnly();
+    uno::Reference<drawing::XDrawPagesSupplier> xPagesSupplier(mxComponent,
+                                                               uno::UNO_QUERY_THROW);
+    uno::Reference<drawing::XShapes> xShapes(xPagesSupplier->getDrawPages()->getByIndex(0),
+                                             uno::UNO_QUERY_THROW);
+    uno::Reference<lang::XMultiServiceFactory> xFactory(mxComponent, uno::UNO_QUERY_THROW);
+    const auto addConnector = [&](const OUString& rName, drawing::ConnectorType eType,
+                                  const awt::Point& rStart, const awt::Point& rEnd) {
+        uno::Reference<drawing::XShape> xShape(
+            xFactory->createInstance("com.sun.star.drawing.ConnectorShape"),
+            uno::UNO_QUERY_THROW);
+        xShapes->add(xShape);
+        uno::Reference<beans::XPropertySet> xProperties(xShape, uno::UNO_QUERY_THROW);
+        xProperties->setPropertyValue("Name", uno::Any(rName));
+        xProperties->setPropertyValue("EdgeKind", uno::Any(eType));
+        xProperties->setPropertyValue("StartPosition", uno::Any(rStart));
+        xProperties->setPropertyValue("EndPosition", uno::Any(rEnd));
+    };
+    addConnector(u"Standard"_ustr, drawing::ConnectorType_STANDARD, awt::Point(9000, 7600),
+                 awt::Point(14500, 8800));
+    addConnector(u"Straight back"_ustr, drawing::ConnectorType_LINE, awt::Point(8000, 3000),
+                 awt::Point(2000, 1000));
+
+    // The box was written from the closed rectangle between the end points,
+    // one unit larger each way on every save.
+    saveAndReloadSdImpressDocModelOnly("Impress Office Open XML");
+    xmlDocUniquePtr pSlideXml = parseExport("ppt/slides/slide1.xml");
+    assertXPath(pSlideXml,
+                "//p:cxnSp[p:nvCxnSpPr/p:cNvPr/@name='Straight back']/p:spPr/a:xfrm"
+                "[@flipH='1' and @flipV='1']/a:ext[@cx='2160000' and @cy='720000']",
+                1);
+    uno::Reference<container::XIndexAccess> xPage(
+        uno::Reference<drawing::XDrawPagesSupplier>(mxComponent, uno::UNO_QUERY_THROW)
+            ->getDrawPages()
+            ->getByIndex(0),
+        uno::UNO_QUERY_THROW);
+    for (sal_Int32 nShape = 0; nShape < xPage->getCount(); ++nShape)
+    {
+        uno::Reference<beans::XPropertySet> xShape(xPage->getByIndex(nShape),
+                                                   uno::UNO_QUERY_THROW);
+        if (xShape->getPropertyValue("Name").get<OUString>() != u"Standard"_ustr)
+            continue;
+        const awt::Point aStart = xShape->getPropertyValue("StartPosition").get<awt::Point>();
+        const awt::Point aEnd = xShape->getPropertyValue("EndPosition").get<awt::Point>();
+        CPPUNIT_ASSERT_EQUAL(sal_Int32(9000), aStart.X);
+        CPPUNIT_ASSERT_EQUAL(sal_Int32(7600), aStart.Y);
+        CPPUNIT_ASSERT_EQUAL(sal_Int32(14500), aEnd.X);
+        CPPUNIT_ASSERT_EQUAL(sal_Int32(8800), aEnd.Y);
+        return;
+    }
+    CPPUNIT_FAIL("connector not found");
+}
