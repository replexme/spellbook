@@ -0,0 +1,59 @@
+import { readFileSync } from 'node:fs';
+import vm from 'node:vm';
+import { describe, expect, it } from 'vitest';
+import { patchSmartArtTransitionStyle } from '../../scripts/patch-onlyoffice-smartart-transition-style.mjs';
+const source = readFileSync('public/sdkjs/slide/sdk-all.js', 'utf8');
+function style(text: string, kind: string, authored?: string) {
+  class SmartArtAlgorithm {
+    getNewGUID() {
+      return 'native-point';
+    }
+  }
+  class PrSet {
+    presStyleLbl = '';
+    setPresName() {}
+    setPresStyleLbl(value: string) {
+      this.presStyleLbl = value;
+    }
+  }
+  class Point {
+    prSet?: PrSet;
+    setType() {}
+    setPrSet(value: PrSet) {
+      this.prSet = value;
+    }
+    setModelId() {}
+  }
+  class PresNode {
+    constructor(public point: Point) {}
+  }
+  const context = vm.createContext({ SmartArtAlgorithm, Point, PresNode, AscFormat: { PrSet, Point_type_pres: 4 } });
+  const start = text.indexOf('SmartArtAlgorithm.prototype.createPresNode=function(');
+  vm.runInContext(text.slice(start, text.indexOf('SmartArtAlgorithm.prototype.forEachContentNode=', start)), context);
+  const algorithm = new SmartArtAlgorithm() as any;
+  return algorithm.createPresNode('layout-node', authored, {
+    isParNode: () => kind === 'parent-transition',
+    isSibNode: () => kind === 'sibling-transition',
+  }).point.prSet.presStyleLbl;
+}
+describe('SmartArt new transition presentation styles', () => {
+  it('reproduces the generic node style which prevents native line style selection', () => {
+    expect(style(source, 'parent-transition')).toBe('node1');
+  });
+  it.each(['parent-transition', 'sibling-transition'])('defers %s style to its native routing algorithm', (kind) => {
+    expect(style(patchSmartArtTransitionStyle(source), kind)).toBe('');
+  });
+  it.each(['parent-transition', 'sibling-transition', 'content'])(
+    'retains explicitly authored styles for %s',
+    (kind) => {
+      expect(style(patchSmartArtTransitionStyle(source), kind, 'authored-custom-style')).toBe('authored-custom-style');
+    },
+  );
+  it('retains the content node fallback and refuses changed boundaries', () => {
+    const patched = patchSmartArtTransitionStyle(source);
+    expect(style(patched, 'content')).toBe('node1');
+    expect(patchSmartArtTransitionStyle(patched)).toBe(patched);
+    expect(() => patchSmartArtTransitionStyle('unknown')).toThrow();
+    expect(() => patchSmartArtTransitionStyle(source.replace('styleLbl||"node1"', 'unknown'))).toThrow();
+  });
+});
