diff --git a/scripts/patch-preferred-ui-source.mjs b/scripts/patch-preferred-ui-source.mjs
new file mode 100644
index 0000000..3e8a2a2
--- /dev/null
+++ b/scripts/patch-preferred-ui-source.mjs
@@ -0,0 +1,44 @@
+// SPDX-License-Identifier: AGPL-3.0-only
+import fs from 'node:fs';
+import path from 'node:path';
+import { createHash } from 'node:crypto';
+
+export function patchPreferredUiSource(sourceRoot, overridesRoot) {
+  const modify = (name, expected, transform) => {
+    const file = path.join(sourceRoot, name);
+    const bytes = fs.readFileSync(file);
+    if (createHash('sha256').update(bytes).digest('hex') !== expected)
+      throw new Error('Preferred UI patch input changed: ' + name);
+    fs.writeFileSync(file, transform(bytes.toString('utf8')));
+  };
+  const templates = {
+    documenteditor: '5a9afcc3b0c8c05b868ec555b186e2b85016dd3676fe6eb25e8dccc70d11c95a',
+    spreadsheeteditor: '822e3acb19e1c3fe445ddd93e9fcce9d9583ebec834ac46df1f4a21e1b249245',
+    presentationeditor: '63ab7c70f1a10346b3c0081e34729586830689950011af84a87b23084b32a2a8',
+  };
+  const bootstrap = fs.readFileSync(path.join(overridesRoot, 'main-application-bootstrap.html'), 'utf8');
+  for (const [editor, expected] of Object.entries(templates))
+    modify(`web-apps/apps/${editor}/main/index.html.deploy`, expected, (text) => {
+      const start = text.indexOf('<script src="../../../vendor/requirejs/require.js"');
+      const call = text.indexOf('isIEBrowser === true ? require', start);
+      const end = text.indexOf('</script>', call) + '</script>'.length;
+      if (start < 0 || call < 0 || end < call || text.slice(end, end + 2) !== '\r\n')
+        throw new Error('Preferred UI bootstrap boundary changed: ' + editor);
+      const patched = text.slice(0, start) + bootstrap + text.slice(end + 2);
+      return editor === 'spreadsheeteditor' && !patched.endsWith('\n') ? patched + '\n' : patched;
+    });
+  modify(
+    'web-apps/apps/common/main/lib/util/htmlutils.js',
+    'c7e5562b403f74363f13d0838e7ab24dd8f8e414eab5526691ab5940cc5bf8b6',
+    (text) => {
+      if (text.split('template.content.firstChild').length !== 3)
+        throw new Error('Preferred HTML element source boundary changed');
+      return text.replaceAll('template.content.firstChild', 'template.content.firstElementChild');
+    },
+  );
+  modify('web-apps/build/Gruntfile.js', 'ba833e17bb9ad65c942744621d625eea93215357bac031e72c13bb5f5028f4fb', (text) => {
+    const banner = 'Version: <%= pkg.version %> (build:<%= pkg.build %>)';
+    if (text.split(banner).length !== 2) throw new Error('UI banner boundary changed');
+    return text.replace(banner, 'Version: 9.3.0 (build:140)');
+  });
+}
