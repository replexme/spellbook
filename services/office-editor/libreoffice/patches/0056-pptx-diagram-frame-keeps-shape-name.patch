+CPPUNIT_TEST_FIXTURE(SdUiImpressTest, testPptxDiagramFrameKeepsShapeName)
+{
+    createSdImpressDoc("pptx/smartart-hierarchy3-two-parents.pptx");
+    const auto diagram = [this]() {
+        auto pImpressDocument = dynamic_cast<SdXImpressDocument*>(mxComponent.get());
+        CPPUNIT_ASSERT(pImpressDocument);
+        SdrObject* pDiagram
+            = pImpressDocument->GetDoc()->GetSdPage(0, PageKind::Standard)->GetObj(0);
+        CPPUNIT_ASSERT(pDiagram);
+        CPPUNIT_ASSERT(pDiagram->isDiagram());
+        return pDiagram;
+    };
+    uno::Reference<beans::XPropertySet> xProperties(diagram()->getUnoShape(),
+                                                    uno::UNO_QUERY_THROW);
+    xProperties->setPropertyValue(u"Name"_ustr, cpo::uno::Any(u"Reporting lines"_ustr));
+    xProperties->setPropertyValue(u"Title"_ustr, cpo::uno::Any(u"Team"_ustr));
+    xProperties->setPropertyValue(u"Description"_ustr,
+                                  cpo::uno::Any(u"Who reports to whom"_ustr));
+
+    // The frame was written as "Diagram1" whatever the shape was called, and
+    // without its alternative text.
+    saveAndReload(TestFilter::PPTX);
+    xmlDocUniquePtr pSlideXml = parseExport(u"ppt/slides/slide1.xml"_ustr);
+    assertXPath(pSlideXml, "//p:graphicFrame/p:nvGraphicFramePr/p:cNvPr", "name",
+                u"Reporting lines");
+    assertXPath(pSlideXml, "//p:graphicFrame/p:nvGraphicFramePr/p:cNvPr", "title", u"Team");
+    assertXPath(pSlideXml, "//p:graphicFrame/p:nvGraphicFramePr/p:cNvPr", "descr",
+                u"Who reports to whom");
+    CPPUNIT_ASSERT_EQUAL(u"Reporting lines"_ustr, diagram()->GetName());
+}
