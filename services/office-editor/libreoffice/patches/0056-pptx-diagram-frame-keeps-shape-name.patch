+    // A frame written for a shape keeps the shape's own name and alternative
+    // text. It was always named "Diagram" plus the diagram number and lost its
+    // alternative text; that name remains only for an unnamed frame.
+    OUString sShapeName;
+    OUString sDescription;
+    OUString sTitle;
+    uno::Reference<beans::XPropertySet> xShapeProperties(rXShape, uno::UNO_QUERY);
+    if (nShapeId != -1 && xShapeProperties.is())
+    {
+        if (GetProperty(xShapeProperties, u"Name"_ustr))
+            mAny >>= sShapeName;
+        if (GetProperty(xShapeProperties, u"Description"_ustr))
+            mAny >>= sDescription;
+        if (GetProperty(xShapeProperties, u"Title"_ustr))
+            mAny >>= sTitle;
+    }
+    pDocPrAttrList->add(XML_name, sShapeName.isEmpty()
+                                      ? OString("Diagram" + OString::number(nDiagramId))
+                                      : sShapeName.toUtf8());
+    if (!sDescription.isEmpty())
+        pDocPrAttrList->add(XML_descr, sDescription.toUtf8());
+    if (!sTitle.isEmpty())
+        pDocPrAttrList->add(XML_title, sTitle.toUtf8());
 
