+        CPPUNIT_ASSERT(pDocument);
+        SdrObject* pDiagram = pDocument->GetDoc()->GetSdPage(0, PageKind::Standard)->GetObj(0);
+        CPPUNIT_ASSERT(pDiagram);
+        CPPUNIT_ASSERT(pDiagram->isDiagram());
+        return pDiagram;
+    };
+    const auto hasNodeText = [&](const OUString& rExpected) {
+        const auto xHelper = diagram()->getDiagramHelper();
+        std::vector<OUString> aParents{ OUString() };
+        for (size_t nParent = 0; nParent < aParents.size() && nParent < 1000; ++nParent)
+            for (const auto& [rId, rText] : xHelper->getChildren(aParents[nParent]))
+            {
+                if (rText == rExpected)
+                    return true;
+                aParents.push_back(rId);
+            }
+        return false;
+    };
+    const auto mutate = [&](const OUString& rMutation) {
+        uno::Reference<beans::XPropertySet> xProperties(diagram()->getUnoShape(),
+                                                        uno::UNO_QUERY_THROW);
+        xProperties->setPropertyValue("SpellbookDiagramMutation", uno::Any(rMutation));
+    };
+    static constexpr OUString aFormat = u"Impress Office Open XML"_ustr;
+
+    // An unedited diagram is written back as it was imported.
+    CPPUNIT_ASSERT(hasNodeText(u"b"_ustr));
+    saveAndReloadSdImpressDocModelOnly(aFormat);
+    CPPUNIT_ASSERT(hasNodeText(u"b"_ustr));
+
+    // Without the export following the model, the saved data model still held
+    // the imported text and the reloaded diagram lost every semantic edit.
+    mutate(uR"json({"Action":"set","ExpectedText":"b","Occurrence":0,"Text":"Updated child"})json"_ustr);
+    mutate(uR"json({"Action":"add","ExpectedText":"","Occurrence":0,"Text":"Added top"})json"_ustr);
+    saveAndReloadSdImpressDocModelOnly(aFormat);
+    CPPUNIT_ASSERT(hasNodeText(u"Updated child"_ustr));
+    CPPUNIT_ASSERT(hasNodeText(u"Added top"_ustr));
+    CPPUNIT_ASSERT(!hasNodeText(u"b"_ustr));
+
+    mutate(uR"json({"Action":"delete","ExpectedText":"Added top","Occurrence":0,"Text":""})json"_ustr);
+    saveAndReloadSdImpressDocModelOnly(aFormat);
+    CPPUNIT_ASSERT(!hasNodeText(u"Added top"_ustr));
+    CPPUNIT_ASSERT(hasNodeText(u"Updated child"_ustr));
+
+    // Undo returns the model to its baseline, so the saved data is unchanged.
+    mutate(uR"json({"Action":"set","ExpectedText":"Updated child","Occurrence":0,"Text":"Undone"})json"_ustr);
+    auto pDocument = dynamic_cast<SdXImpressDocument*>(mxComponent.get());
+    CPPUNIT_ASSERT(pDocument);
+    pDocument->GetDoc()->GetDocSh()->GetUndoManager()->Undo();
+    saveAndReloadSdImpressDocModelOnly(aFormat);
+    CPPUNIT_ASSERT(hasNodeText(u"Updated child"_ustr));
+    CPPUNIT_ASSERT(!hasNodeText(u"Undone"_ustr));
+}
