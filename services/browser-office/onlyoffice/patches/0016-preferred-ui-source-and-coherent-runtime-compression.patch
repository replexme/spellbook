+// SPDX-License-Identifier: AGPL-3.0-only
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { uiBuildInputPaths, verifyUiRebuildEvidence } from './ui-rebuild-evidence.mjs';
+const fixture = () => {
+  const lock = {
+    sources: [
+      { id: 'ui', commit: 'commit', archiveSha256: 'archive' },
+      { id: 'sdk', archiveSha256: 'sdk-archive' },
+    ],
+    uiRebuild: { sourceId: 'ui', dependencySourceIds: ['sdk'] },
+  };
+  const inputs = uiBuildInputPaths().map((path) => ({ path, sha256: 'input-' + path }));
+  const outputs = [
+    { path: 'web-apps/main.js', sha256: 'code' },
+    { path: 'web-apps/main.js.br', sha256: 'compressed' },
+  ];
+  const evidence = {
+    schemaVersion: 1,
+    status: 'deployed-ui-assets-reproduced',
+    sourceCommit: 'commit',
+    sourceArchiveSha256: 'archive',
+    dependencies: [{ id: 'sdk', archiveSha256: 'sdk-archive' }],
+    buildInputs: structuredClone(inputs),
+    outputs: outputs.map((file) => ({ ...file, exactMatch: true })),
+  };
+  return { lock, inputs, outputs, evidence };
+};
+test('complete matching UI proof remains scoped below whole editor reproduction', () => {
+  const f = fixture();
+  assert.deepEqual(verifyUiRebuildEvidence(f.lock, f.evidence, f.inputs, f.outputs), {
+    uiAssetRebuildVerified: true,
+    upstreamEditorRebuildVerified: false,
+  });
+});
+for (const [name, change] of [
+  ['missing dependency source', (f) => f.evidence.dependencies.pop()],
+  ['different dependency archive', (f) => (f.evidence.dependencies[0].archiveSha256 = 'wrong')],
+  ['different source', (f) => (f.evidence.sourceCommit = 'different')],
+  ['different archive', (f) => (f.evidence.sourceArchiveSha256 = 'different')],
+  ['incomplete input', (f) => f.evidence.buildInputs.pop()],
+  ['duplicate input', (f) => (f.evidence.buildInputs[1] = f.evidence.buildInputs[0])],
+  ['changed recipe', (f) => (f.inputs[1].sha256 = 'changed')],
+  ['missing output', (f) => f.evidence.outputs.pop()],
+  ['duplicate output', (f) => (f.evidence.outputs[1] = f.evidence.outputs[0])],
+  ['added deployment output', (f) => f.outputs.push({ path: 'web-apps/extra.js', sha256: 'extra' })],
+  ['changed deployed compressed output', (f) => (f.outputs[1].sha256 = 'changed')],
+  ['unverified output', (f) => (f.evidence.outputs[0].exactMatch = false)],
+])
+  test('rejects ' + name, () => {
+    const f = fixture();
+    change(f);
+    assert.throws(() => verifyUiRebuildEvidence(f.lock, f.evidence, f.inputs, f.outputs));
+  });
