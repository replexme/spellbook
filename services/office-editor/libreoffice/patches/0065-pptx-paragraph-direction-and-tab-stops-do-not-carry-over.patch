+CPPUNIT_TEST_FIXTURE(SdUiImpressTest, testPptxParagraphDirectionAndTabStopsDoNotCarryOver)
+{
+    createSdImpressDoc();
+    uno::Reference<drawing::XDrawPagesSupplier> xPagesSupplier(mxComponent,
+                                                               uno::UNO_QUERY_THROW);
+    uno::Reference<drawing::XShapes> xShapes(xPagesSupplier->getDrawPages()->getByIndex(0),
+                                             uno::UNO_QUERY_THROW);
+    uno::Reference<lang::XMultiServiceFactory> xFactory(mxComponent, uno::UNO_QUERY_THROW);
+    uno::Reference<drawing::XShape> xShape(
+        xFactory->createInstance(u"com.sun.star.drawing.TextShape"_ustr), uno::UNO_QUERY_THROW);
+    xShape->setPosition(awt::Point(1000, 1000));
+    xShape->setSize(awt::Size(10000, 3000));
+    xShapes->add(xShape);
+    uno::Reference<text::XText> xText(xShape, uno::UNO_QUERY_THROW);
+    xText->setString(u"First paragraph\nSecond paragraph"_ustr);
+    const auto paragraphs = [this]() {
+        uno::Reference<drawing::XDrawPagesSupplier> xSupplier(mxComponent,
+                                                              uno::UNO_QUERY_THROW);
+        uno::Reference<container::XIndexAccess> xPageShapes(
+            xSupplier->getDrawPages()->getByIndex(0), uno::UNO_QUERY_THROW);
+        std::vector<uno::Reference<beans::XPropertySet>> aParagraphs;
+        for (sal_Int32 nShape = 0; nShape < xPageShapes->getCount() && aParagraphs.empty();
+             ++nShape)
+        {
+            uno::Reference<text::XText> xCandidate(xPageShapes->getByIndex(nShape),
+                                                   uno::UNO_QUERY);
+            if (!xCandidate.is() || !xCandidate->getString().startsWith("First paragraph"))
+                continue;
+            uno::Reference<container::XEnumerationAccess> xAccess(xCandidate,
+                                                                  uno::UNO_QUERY_THROW);
+            uno::Reference<container::XEnumeration> xParagraphs = xAccess->createEnumeration();
+            while (xParagraphs->hasMoreElements())
+                aParagraphs.emplace_back(xParagraphs->nextElement(), uno::UNO_QUERY_THROW);
+        }
+        return aParagraphs;
+    };
+    auto aParagraphs = paragraphs();
+    CPPUNIT_ASSERT_EQUAL(size_t(2), aParagraphs.size());
+    style::TabStop aTabStop;
+    aTabStop.Position = 5000;
+    aParagraphs[0]->setPropertyValue(u"WritingMode"_ustr,
+                                     cpo::uno::Any(sal_Int16(text::WritingMode2::RL_TB)));
+    aParagraphs[0]->setPropertyValue(u"ParaLeftMargin"_ustr, cpo::uno::Any(sal_Int32(1200)));
+    aParagraphs[0]->setPropertyValue(u"ParaFirstLineIndent"_ustr,
+                                     cpo::uno::Any(sal_Int32(-600)));
+    aParagraphs[0]->setPropertyValue(u"ParaTabStops"_ustr,
+                                     cpo::uno::Any(uno::Sequence<style::TabStop>{ aTabStop }));
+
+    // Import replaced the tab stop of a paragraph with an indent by one at
+    // zero, and gave the second paragraph, which sets neither, the first
+    // paragraph's direction and tab stops.
+    saveAndReload(TestFilter::PPTX);
+    aParagraphs = paragraphs();
+    CPPUNIT_ASSERT_EQUAL(size_t(2), aParagraphs.size());
+    const auto direction = [&aParagraphs](size_t nParagraph) {
+        return aParagraphs[nParagraph]->getPropertyValue(u"WritingMode"_ustr).get<sal_Int16>();
+    };
+    const auto tabStops = [&aParagraphs](size_t nParagraph) {
+        return aParagraphs[nParagraph]
+            ->getPropertyValue(u"ParaTabStops"_ustr)
+            .get<uno::Sequence<style::TabStop>>();
+    };
+    CPPUNIT_ASSERT_EQUAL(sal_Int16(text::WritingMode2::RL_TB), direction(0));
+    CPPUNIT_ASSERT_EQUAL(sal_Int32(1), tabStops(0).getLength());
+    CPPUNIT_ASSERT_EQUAL(sal_Int32(5000), tabStops(0)[0].Position);
+    CPPUNIT_ASSERT_EQUAL(sal_Int16(text::WritingMode2::LR_TB), direction(1));
+    CPPUNIT_ASSERT_EQUAL(sal_Int32(0), tabStops(1).getLength());
+}
