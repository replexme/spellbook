+CPPUNIT_TEST_FIXTURE(SdUiImpressTest, testSpellbookPptxEmptyTextKeepsShapeAlignment)
+{
+    createSdImpressDocModelOnly();
+    uno::Reference<drawing::XDrawPagesSupplier> xPagesSupplier(mxComponent,
+                                                               uno::UNO_QUERY_THROW);
+    uno::Reference<drawing::XShapes> xShapes(xPagesSupplier->getDrawPages()->getByIndex(0),
+                                             uno::UNO_QUERY_THROW);
+    uno::Reference<lang::XMultiServiceFactory> xFactory(mxComponent, uno::UNO_QUERY_THROW);
+    const auto addShape = [&](const OUString& rName, sal_Int32 nX, sal_Int16 nAdjust) {
+        uno::Reference<drawing::XShape> xShape(
+            xFactory->createInstance("com.sun.star.drawing.RectangleShape"),
+            uno::UNO_QUERY_THROW);
+        xShape->setPosition(awt::Point(nX, 1000));
+        xShape->setSize(awt::Size(4000, 3000));
+        xShapes->add(xShape);
+        uno::Reference<beans::XPropertySet> xProperties(xShape, uno::UNO_QUERY_THROW);
+        xProperties->setPropertyValue("Name", uno::Any(rName));
+        xProperties->setPropertyValue("ParaAdjust", uno::Any(nAdjust));
+    };
+    addShape(u"Centered"_ustr, 1000, sal_Int16(style::ParagraphAdjust_CENTER));
+    addShape(u"Right"_ustr, 6000, sal_Int16(style::ParagraphAdjust_RIGHT));
+    const auto alignment = [this](const OUString& rName) {
+        uno::Reference<drawing::XDrawPagesSupplier> xSupplier(mxComponent,
+                                                              uno::UNO_QUERY_THROW);
+        uno::Reference<container::XIndexAccess> xPageShapes(
+            xSupplier->getDrawPages()->getByIndex(0), uno::UNO_QUERY_THROW);
+        for (sal_Int32 nShape = 0; nShape < xPageShapes->getCount(); ++nShape)
+        {
+            uno::Reference<beans::XPropertySet> xShape(xPageShapes->getByIndex(nShape),
+                                                       uno::UNO_QUERY_THROW);
+            if (xShape->getPropertyValue("Name").get<OUString>() == rName)
+                return xShape->getPropertyValue("ParaAdjust").get<sal_Int16>();
+        }
+        CPPUNIT_FAIL("shape not found");
+        return sal_Int16(-1);
+    };
+
+    // A shape without text lost its alignment: its empty paragraph was
+    // written without one, and import kept only a centered alignment.
+    saveAndReloadSdImpressDocModelOnly("Impress Office Open XML");
+    xmlDocUniquePtr pSlideXml = parseExport("ppt/slides/slide1.xml");
+    assertXPath(pSlideXml,
+                "//p:sp[p:nvSpPr/p:cNvPr/@name='Centered']/p:txBody/a:p/a:pPr[@algn='ctr']", 1);
+    assertXPath(pSlideXml,
+                "//p:sp[p:nvSpPr/p:cNvPr/@name='Right']/p:txBody/a:p/a:pPr[@algn='r']", 1);
+    CPPUNIT_ASSERT_EQUAL(sal_Int16(style::ParagraphAdjust_CENTER), alignment(u"Centered"_ustr));
+    CPPUNIT_ASSERT_EQUAL(sal_Int16(style::ParagraphAdjust_RIGHT), alignment(u"Right"_ustr));
+}
