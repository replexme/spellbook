+// SPDX-License-Identifier: AGPL-3.0-only
+// Local candidate for ONLYOFFICE sdkjs v9.3.0.140 after the SmartArt patches.
+import assert from 'node:assert/strict';
+import { createHash } from 'node:crypto';
+import { readFile, writeFile } from 'node:fs/promises';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { brotliCompressSync, constants } from 'node:zlib';
+
+const inputHash = '7a5ea043eca4e9d594554037fadf72eb7061c3be0ccc4aa21b565ca5b1294cb1';
+const anchor = 'InitClass(CNumericPoint,CBaseChartObject,AscDFH.historyitem_type_NumericPoint);';
+const addition = '/* spellbook-chart-point-history-recalc-v1 */CNumericPoint.prototype.Refresh_RecalcData=function(data){if(data.Type===AscDFH.historyitem_NumericPoint_SetVal){var chart=this.getChartSpace();if(chart)chart.onDataUpdateRecalc()}};';
+
+export function patchChartPointRecalc(source) {
+  assert(source.split(anchor).length === 2, 'Pinned numeric chart point boundary changed');
+  if (source.includes(addition)) {
+    assert(source.includes(anchor + addition), 'Misplaced chart history recalculation');
+    return source;
+  }
+  const start = source.indexOf(anchor);
+  const end = source.indexOf('InitClass(CNumFmt,', start);
+  assert(end > start, 'Pinned numeric chart point implementation missing');
+  assert(!source.slice(start, end).includes('CNumericPoint.prototype.Refresh_RecalcData'), 'Upstream chart point recalculation changed');
+  return source.replace(anchor, anchor + addition);
+}
+
+if (process.argv[1] && path.resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
+  const root = path.resolve(process.argv[2] || '');
+  assert(path.basename(root) === 'dist', 'Only generated dist assets may be patched');
+  const target = path.join(root, 'sdkjs/slide/sdk-all.js');
+  const source = await readFile(target, 'utf8');
+  const hash = (text) => createHash('sha256').update(text).digest('hex');
+  assert(hash(source.replace(addition, '')) === inputHash, 'Unexpected SDK asset');
+  const patched = patchChartPointRecalc(source);
+  await writeFile(target, patched);
+  await writeFile(target + '.br', brotliCompressSync(Buffer.from(patched), { params: { [constants.BROTLI_PARAM_QUALITY]: 5 } }));
+  console.log(JSON.stringify({ patch: 'spellbook-chart-point-history-recalc-v1', before: hash(source), after: hash(patched) }));
+}
diff --git a/test/unit/chart-point-recalc.test.ts b/test/unit/chart-point-recalc.test.ts
