SPELLBOOK_PUBLIC_URL=http://localhost:3000
# The document view's public address (services/document-view).
SPELLBOOK_DOCUMENT_VIEW_PUBLIC_URL=http://localhost:4173
SPELLBOOK_LOCAL_EMAIL=owner@spellbook.local
# Reuse the Codex CLI/IDE login by default. Choose isolated for a separate login.
SPELLBOOK_CODEX_AUTH_MODE=shared
SPELLBOOK_LOCAL_PASSWORD_HASH=scrypt:replace-with-generated-value
SPELLBOOK_SESSION_SECRET=replace-with-at-least-32-random-bytes
# Signs the AI job capability tokens (historical name).
SPELLBOOK_WOPI_SECRET=replace-with-at-least-32-random-bytes
SPELLBOOK_INTERNAL_TOKEN=replace-with-at-least-32-random-bytes
SPELLBOOK_POSTGRES_PASSWORD=replace-with-a-random-password
SPELLBOOK_DB_POOL_MAX=4
SPELLBOOK_JOB_REDELIVERY_SECONDS=15
# Preserve this much free space so uploads and render receipts fail cleanly.
SPELLBOOK_STORAGE_RESERVE_BYTES=536870912
SPELLBOOK_AI_CONNECTOR_MODE=internal
SPELLBOOK_LOCAL_CONNECTOR_ORIGIN=http://127.0.0.1:43127
