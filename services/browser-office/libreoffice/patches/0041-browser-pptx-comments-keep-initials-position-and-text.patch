+CPPUNIT_TEST_FIXTURE(SdUiImpressTest, testSpellbookPptxCommentKeepsInitialsPositionAndText)
+{
+    createSdImpressDocModelOnly();
+    uno::Reference<drawing::XDrawPagesSupplier> xPagesSupplier(mxComponent,
+                                                               uno::UNO_QUERY_THROW);
+    uno::Reference<office::XAnnotationAccess> xAccess(
+        xPagesSupplier->getDrawPages()->getByIndex(0), uno::UNO_QUERY_THROW);
+    uno::Reference<office::XAnnotation> xAnnotation(xAccess->createAndInsertAnnotation());
+    xAnnotation->setAuthor(u"Spellbook AI"_ustr);
+    xAnnotation->setInitials(u"AI"_ustr);
+    xAnnotation->setPosition(geometry::RealPoint2D(8.0, 8.0));
+    xAnnotation->getTextRange()->setString(u"a < b & c"_ustr);
+
+    // Export made the initials up from the name, wrote the missing date as
+    // zeros and the text unescaped; import rounded the position to whole
+    // 1/100 mm steps of 15.87 mm.
+    saveAndReloadSdImpressDocModelOnly("Impress Office Open XML");
+    xmlDocUniquePtr pAuthors = parseExport("ppt/commentAuthors.xml");
+    assertXPath(pAuthors, "//p:cmAuthor[@name='Spellbook AI' and @initials='AI']", 1);
+    xmlDocUniquePtr pComments = parseExport("ppt/comments/comment1.xml");
+    assertXPath(pComments, "//p:cm[not(@dt)]/p:pos[@x='181' and @y='181']", 1);
+    xAccess.set(uno::Reference<drawing::XDrawPagesSupplier>(mxComponent, uno::UNO_QUERY_THROW)
+                    ->getDrawPages()
+                    ->getByIndex(0),
+                uno::UNO_QUERY_THROW);
+    uno::Reference<office::XAnnotationEnumeration> xAnnotations(
+        xAccess->createAnnotationEnumeration());
+    // The deck carries a comment of its own, which stays beside this one.
+    xAnnotation.clear();
+    while (xAnnotations->hasMoreElements())
+    {
+        uno::Reference<office::XAnnotation> xCandidate(xAnnotations->nextElement());
+        if (xCandidate->getAuthor() == u"Spellbook AI"_ustr)
+            xAnnotation = xCandidate;
+    }
+    CPPUNIT_ASSERT(xAnnotation.is());
+    CPPUNIT_ASSERT_EQUAL(u"AI"_ustr, xAnnotation->getInitials());
+    CPPUNIT_ASSERT_EQUAL(u"a < b & c"_ustr, xAnnotation->getTextRange()->getString());
+    // One PPTX master unit is 1/576 inch, 0.044 mm.
+    CPPUNIT_ASSERT_DOUBLES_EQUAL(8.0, xAnnotation->getPosition().X, 0.05);
+    CPPUNIT_ASSERT_DOUBLES_EQUAL(8.0, xAnnotation->getPosition().Y, 0.05);
+}
