+CPPUNIT_TEST_FIXTURE(SdUiImpressTest, testSpellbookFontworkShapeTypeIsObservable)
+{
+    createSdImpressDocModelOnly();
+    uno::Reference<drawing::XDrawPagesSupplier> xPagesSupplier(mxComponent,
+                                                               uno::UNO_QUERY_THROW);
+    uno::Reference<drawing::XShapes> xShapes(xPagesSupplier->getDrawPages()->getByIndex(0),
+                                             uno::UNO_QUERY_THROW);
+    uno::Reference<lang::XMultiServiceFactory> xFactory(mxComponent, uno::UNO_QUERY_THROW);
+    uno::Reference<drawing::XShape> xShape(
+        xFactory->createInstance("com.sun.star.drawing.CustomShape"), uno::UNO_QUERY_THROW);
+    xShapes->add(xShape);
+    uno::Reference<beans::XPropertySet> xProperties(xShape, uno::UNO_QUERY_THROW);
+    CPPUNIT_ASSERT_EQUAL(OUString(),
+                         xProperties->getPropertyValue("SpellbookFontworkShapeType").get<OUString>());
+
+    xProperties->setPropertyValue(
+        "CustomShapeGeometry",
+        uno::Any(comphelper::InitPropertySequence(
+            { { "Type", uno::Any(u"fontwork-arch-up-curve"_ustr) },
+              { "TextPath", uno::Any(comphelper::InitPropertySequence(
+                                { { "TextPath", uno::Any(true) } })) } })));
+    CPPUNIT_ASSERT_EQUAL(u"fontwork-arch-up-curve"_ustr,
+                         xProperties->getPropertyValue("SpellbookFontworkShapeType").get<OUString>());
+}
