 }
 
+CPPUNIT_TEST_FIXTURE(SdUiImpressTest, testPptxConnectorKeepsALinkedShapeConnection)
+{
+    createSdImpressDoc();
+    uno::Reference<drawing::XDrawPagesSupplier> xPagesSupplier(mxComponent,
+                                                               uno::UNO_QUERY_THROW);
+    uno::Reference<drawing::XShapes> xShapes(xPagesSupplier->getDrawPages()->getByIndex(0),
+                                             uno::UNO_QUERY_THROW);
+    uno::Reference<lang::XMultiServiceFactory> xFactory(mxComponent, uno::UNO_QUERY_THROW);
+    uno::Reference<drawing::XShape> xConnector(
+        xFactory->createInstance(u"com.sun.star.drawing.ConnectorShape"_ustr),
+        uno::UNO_QUERY_THROW);
+    xShapes->add(xConnector);
+    uno::Reference<drawing::XShape> xTarget(
+        xFactory->createInstance(u"com.sun.star.drawing.RectangleShape"_ustr),
+        uno::UNO_QUERY_THROW);
+    xTarget->setPosition(awt::Point(9000, 6000));
+    xTarget->setSize(awt::Size(4000, 2000));
+    xShapes->add(xTarget);
+    uno::Reference<beans::XPropertySet> xTargetProperties(xTarget, uno::UNO_QUERY_THROW);
+    xTargetProperties->setPropertyValue(u"Name"_ustr, cpo::uno::Any(u"Target"_ustr));
+    uno::Reference<beans::XPropertySet> xConnectorProperties(xConnector, uno::UNO_QUERY_THROW);
+    xConnectorProperties->setPropertyValue(u"Name"_ustr, cpo::uno::Any(u"Link"_ustr));
+    xConnectorProperties->setPropertyValue(u"StartPosition"_ustr,
+                                           cpo::uno::Any(awt::Point(2000, 2000)));
+    xConnectorProperties->setPropertyValue(u"EndPosition"_ustr, cpo::uno::Any(awt::Point(9000, 6000)));
+    // The connector is written before the shape it links, so the shape's id is
+    // assigned by the connection.
+    xConnectorProperties->setPropertyValue(u"EndShape"_ustr, cpo::uno::Any(xTarget));
+    xConnectorProperties->setPropertyValue(u"EndGluePointIndex"_ustr, cpo::uno::Any(sal_Int32(0)));
+
+    saveAndReload(TestFilter::PPTX);
+    xmlDocUniquePtr pSlideXml = parseExport(u"ppt/slides/slide1.xml"_ustr);
+    const OUString aTargetId
+        = getXPath(pSlideXml, "//p:sp[p:nvSpPr/p:cNvPr/@name='Target']/p:nvSpPr/p:cNvPr", "id");
+    // Writing a second id for the linked shape left the connection pointing at
+    // no shape at all.
+    assertXPath(pSlideXml,
+                "//p:cxnSp[p:nvCxnSpPr/p:cNvPr/@name='Link']/p:nvCxnSpPr/p:cNvCxnSpPr/a:endCxn",
+                "id", aTargetId);
+    uno::Reference<container::XIndexAccess> xPage(
+        uno::Reference<drawing::XDrawPagesSupplier>(mxComponent, uno::UNO_QUERY_THROW)
+            ->getDrawPages()
+            ->getByIndex(0),
+        uno::UNO_QUERY_THROW);
+    for (sal_Int32 nShape = 0; nShape < xPage->getCount(); ++nShape)
+    {
+        uno::Reference<beans::XPropertySet> xReloaded(xPage->getByIndex(nShape),
+                                                      uno::UNO_QUERY_THROW);
+        if (xReloaded->getPropertyValue(u"Name"_ustr).get<OUString>() != u"Link"_ustr)
+            continue;
+        uno::Reference<drawing::XShape> xLinked(
+            xReloaded->getPropertyValue(u"EndShape"_ustr).get<uno::Reference<drawing::XShape>>());
+        CPPUNIT_ASSERT(xLinked.is());
+        uno::Reference<beans::XPropertySet> xLinkedProperties(xLinked, uno::UNO_QUERY_THROW);
+        CPPUNIT_ASSERT_EQUAL(u"Target"_ustr,
+                             xLinkedProperties->getPropertyValue(u"Name"_ustr).get<OUString>());
+        return;
+    }
+    CPPUNIT_FAIL("connector not found");
+}
