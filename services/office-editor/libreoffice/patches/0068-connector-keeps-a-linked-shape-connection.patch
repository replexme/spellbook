 namespace oox::drawingml {
 
+namespace
+{
+// A connector writes its connections with the ids of the shapes it links,
+// which assigns those ids before the shapes themselves are written. Writing a
+// second id for such a shape left the connection pointing at no shape at all,
+// so PowerPoint and a reopened deck showed the connector detached. Every shape
+// keeps the id it was given.
+sal_Int32 lclShapeID(ShapeExport& rExport, const css::uno::Reference<css::drawing::XShape>& rXShape)
+{
+    const sal_Int32 nID = rExport.GetShapeID(rXShape);
+    return nID == -1 ? rExport.GetNewShapeID(rXShape) : nID;
+}
+}
