+// SPDX-License-Identifier: AGPL-3.0-only
+// Local candidate for ONLYOFFICE sdkjs v9.3.0.140, after the group and SmartArt relation patches.
+import assert from 'node:assert/strict';
+import { createHash } from 'node:crypto';
+import { readFile, writeFile } from 'node:fs/promises';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { brotliCompressSync, constants } from 'node:zlib';
+
+const marker = 'spellbook-smartart-line-path-no-fill-v1';
+const inputHash = '2c302a894f67b77361424b908358b23de38cd340d2bf5d84f3baa7dc15f4cf5e';
+const oldGuard = 'geometry.AddPathCommand.apply(geometry,custCommand)}this.applyPostEditorSettings(shape);return shape';
+const newGuard = `geometry.AddPathCommand.apply(geometry,custCommand)}/* ${marker} */for(var p=0;p<geometry.pathLst.length;p++)geometry.pathLst[p].setFill("none");this.applyPostEditorSettings(shape);return shape`;
+
+export function patchSmartArtLinePathFill(source) {
+  const start = source.indexOf('ShadowShape.prototype.getEditorLine=function(');
+  const end = source.indexOf('ShadowShape.prototype.getEditorShape=', start);
+  assert(start >= 0 && end > start, 'Pinned SmartArt connector boundary missing');
+  const body = source.slice(start, end);
+  if (body.includes(newGuard)) {
+    assert(!body.includes(oldGuard), 'Mixed SmartArt connector implementation');
+    return source;
+  }
+  assert(body.split(oldGuard).length === 2, 'Pinned SmartArt connector path changed');
+  return source.slice(0, start) + body.replace(oldGuard, newGuard) + source.slice(end);
+}
+
+if (process.argv[1] && path.resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
+  const root = path.resolve(process.argv[2] || '');
+  assert(path.basename(root) === 'dist', 'Only generated dist assets may be patched');
+  const target = path.join(root, 'sdkjs/slide/sdk-all.js');
+  const source = await readFile(target, 'utf8');
+  const before = createHash('sha256').update(source).digest('hex');
+  // Even an already patched input must reconstruct the exact pinned input.
+  const unpatched = source.replace(newGuard, oldGuard);
+  assert(createHash('sha256').update(unpatched).digest('hex') === inputHash, 'Unexpected SDK asset');
+  const patched = patchSmartArtLinePathFill(source);
+  await writeFile(target, patched);
+  await writeFile(
+    target + '.br',
+    brotliCompressSync(Buffer.from(patched), {
+      params: { [constants.BROTLI_PARAM_QUALITY]: 5 },
+    }),
+  );
+  console.log(JSON.stringify({ patch: marker, before, after: createHash('sha256').update(patched).digest('hex') }));
+}
