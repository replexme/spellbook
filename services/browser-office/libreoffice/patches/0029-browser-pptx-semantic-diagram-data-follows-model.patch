+// The export writes the diagram data captured at import, while a semantic
+// edit changes the live data model (node text, added and removed nodes).
+// Apply every model change since the baseline recorded before the first edit
+// to a copy of the imported data. Returns an empty reference when the model
+// is back at that baseline, so an unedited diagram is written unchanged.
+uno::Reference<xml::dom::XDocument>
+lcl_spellbookDiagramData(const uno::Reference<xml::dom::XDocument>& xImported,
+                         const uno::Sequence<beans::PropertyValue>& rBaselinePoints,
+                         const uno::Sequence<OUString>& rBaselineConnections,
+                         svx::diagram::DiagramDataState& rState)
+{
+    std::map<OUString, OUString> aBaselineTexts;
+    for (const auto& rPoint : rBaselinePoints)
+    {
+        OUString aText;
+        rPoint.Value >>= aText;
+        aBaselineTexts[rPoint.Name] = aText;
+    }
+    const std::set<OUString> aBaselineConnections(rBaselineConnections.begin(),
+                                                  rBaselineConnections.end());
+    const uno::Reference<xml::dom::XDocument> xDocument(xImported->cloneNode(true),
+                                                        uno::UNO_QUERY);
+    if (!xDocument.is())
+        return {};
+    const uno::Reference<xml::dom::XElement> xRoot = xDocument->getDocumentElement();
+    if (!xRoot.is())
+        return {};
+    const uno::Reference<xml::dom::XElement> xPointList
+        = lcl_spellbookDiagramChild(xRoot, gaSpellbookDiagramNamespace, u"ptLst"_ustr);
+    if (!xPointList.is())
+        return {};
+
+    bool bChanged = false;
+    std::map<OUString, uno::Reference<xml::dom::XElement>> aPointElements;
+    for (const auto& xPoint :
+         lcl_spellbookDiagramChildren(xPointList, gaSpellbookDiagramNamespace, u"pt"_ustr))
+        aPointElements.emplace(xPoint->getAttribute(u"modelId"_ustr), xPoint);
+    std::set<OUString> aCurrentPoints;
+    for (const svx::diagram::Point& rPoint : rState.getPoints())
+    {
+        aCurrentPoints.insert(rPoint.msModelId);
+        const OUString aText = rPoint.msTextBody ? rPoint.msTextBody->msText : OUString();
+        const bool bTextPoint = rPoint.mnXMLType == svx::diagram::TypeConstant::XML_node
+                                || rPoint.mnXMLType == svx::diagram::TypeConstant::XML_asst;
+        const auto aBaseline = aBaselineTexts.find(rPoint.msModelId);
+        const auto aElement = aPointElements.find(rPoint.msModelId);
+        if (aBaseline == aBaselineTexts.end())
+        {
+            if (aElement == aPointElements.end())
+            {
+                lcl_appendSpellbookDiagramPoint(xDocument, xPointList, rPoint, bTextPoint, aText);
+                bChanged = true;
+            }
+        }
+        else if (bTextPoint && aBaseline->second != aText && aElement != aPointElements.end())
+        {
+            lcl_setSpellbookDiagramPointText(xDocument, aElement->second, aText);
+            bChanged = true;
+        }
+    }
+    for (const auto& rBaseline : aBaselineTexts)
+    {
+        if (aCurrentPoints.contains(rBaseline.first))
+            continue;
+        if (const auto aElement = aPointElements.find(rBaseline.first);
+            aElement != aPointElements.end())
+        {
+            xPointList->removeChild(aElement->second);
+            bChanged = true;
+        }
+    }
+
+    if (const uno::Reference<xml::dom::XElement> xConnectionList
+        = lcl_spellbookDiagramChild(xRoot, gaSpellbookDiagramNamespace, u"cxnLst"_ustr);
+        xConnectionList.is())
+    {
+        std::map<OUString, uno::Reference<xml::dom::XElement>> aConnectionElements;
+        for (const auto& xConnection : lcl_spellbookDiagramChildren(
+                 xConnectionList, gaSpellbookDiagramNamespace, u"cxn"_ustr))
+            aConnectionElements.emplace(xConnection->getAttribute(u"modelId"_ustr), xConnection);
+        std::set<OUString> aCurrentConnections;
+        for (const svx::diagram::Connection& rConnection : rState.getConnections())
+        {
+            const OUString aId = lcl_spellbookDiagramConnectionId(rConnection);
+            aCurrentConnections.insert(aId);
+            if (aBaselineConnections.contains(aId) || aConnectionElements.contains(aId))
+                continue;
+            lcl_appendSpellbookDiagramConnection(xDocument, xPointList, xConnectionList,
+                                                 rConnection, aId);
+            bChanged = true;
+        }
+        for (const OUString& rId : aBaselineConnections)
+        {
+            if (aCurrentConnections.contains(rId))
+                continue;
+            if (const auto aElement = aConnectionElements.find(rId);
+                aElement != aConnectionElements.end())
+            {
+                xConnectionList->removeChild(aElement->second);
+                bChanged = true;
+            }
+        }
+    }
+    if (!bChanged)
+        return {};
+
+    // The cached drawing still shows the old content and PowerPoint would
+    // display it instead of laying the diagram out again; the drawing is not
+    // written, so remove the data model's pointer to it as well.
+    const uno::Reference<xml::dom::XNodeList> xReferences = xDocument->getElementsByTagNameNS(
+        gaSpellbookDiagramDrawingNamespace, u"dataModelExt"_ustr);
+    std::vector<uno::Reference<xml::dom::XNode>> aReferences;
+    for (sal_Int32 nIndex = 0; xReferences.is() && nIndex < xReferences->getLength(); ++nIndex)
+        aReferences.push_back(xReferences->item(nIndex));
+    for (const auto& xReference : aReferences)
+    {
+        const uno::Reference<xml::dom::XNode> xExtension = xReference->getParentNode();
+        const uno::Reference<xml::dom::XNode> xExtensionList
+            = xExtension.is() ? xExtension->getParentNode() : uno::Reference<xml::dom::XNode>();
+        if (xExtensionList.is())
+            xExtensionList->removeChild(xExtension);
+    }
+    return xDocument;
+}
+}
