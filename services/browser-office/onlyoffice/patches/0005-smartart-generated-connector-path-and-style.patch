+// SPDX-License-Identifier: AGPL-3.0-only
+// Local candidate for ONLYOFFICE sdkjs v9.3.0.140, after the group, relation and connector path patches.
+import assert from 'node:assert/strict';
+import { createHash } from 'node:crypto';
+import { readFile, writeFile } from 'node:fs/promises';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { brotliCompressSync, constants } from 'node:zlib';
+
+const marker = 'spellbook-smartart-transition-default-style-v1';
+const inputHash = '9f0ffa814c45d92b450bd32737602cd9fadf48f8686c053d1f1ba75ca15ddd28';
+const oldGuard = 'prSet.setPresStyleLbl(styleLbl||"node1");';
+const newGuard = `/* ${marker} */prSet.setPresStyleLbl(styleLbl||(contentNode&&(contentNode.isParNode()||contentNode.isSibNode())?"":"node1"));`;
+
+export function patchSmartArtTransitionStyle(source) {
+  const start = source.indexOf('SmartArtAlgorithm.prototype.createPresNode=function(');
+  const end = source.indexOf('SmartArtAlgorithm.prototype.forEachContentNode=', start);
+  assert(start >= 0 && end > start, 'Pinned SmartArt presentation node boundary missing');
+  const body = source.slice(start, end);
+  if (body.includes(newGuard)) {
+    assert(!body.includes(oldGuard), 'Mixed SmartArt style implementation');
+    return source;
+  }
+  assert(body.split(oldGuard).length === 2, 'Pinned SmartArt default style changed');
+  return source.slice(0, start) + body.replace(oldGuard, newGuard) + source.slice(end);
+}
+
+if (process.argv[1] && path.resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
+  const root = path.resolve(process.argv[2] || '');
+  assert(path.basename(root) === 'dist', 'Only generated dist assets may be patched');
+  const target = path.join(root, 'sdkjs/slide/sdk-all.js');
+  const source = await readFile(target, 'utf8');
+  const before = createHash('sha256').update(source).digest('hex');
+  // Even an already patched input must reconstruct the exact pinned input.
+  const unpatched = source.replace(newGuard, oldGuard);
+  assert(createHash('sha256').update(unpatched).digest('hex') === inputHash, 'Unexpected SDK asset');
+  const patched = patchSmartArtTransitionStyle(source);
+  await writeFile(target, patched);
+  await writeFile(
+    target + '.br',
+    brotliCompressSync(Buffer.from(patched), {
+      params: { [constants.BROTLI_PARAM_QUALITY]: 5 },
+    }),
+  );
+  console.log(JSON.stringify({ patch: marker, before, after: createHash('sha256').update(patched).digest('hex') }));
+}
diff --git a/test/unit/smartart-line-path.test.ts b/test/unit/smartart-line-path.test.ts
new file mode 100644
index 0000000..627ba25
