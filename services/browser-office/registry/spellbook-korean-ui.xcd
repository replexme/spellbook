<?xml version="1.0" encoding="UTF-8"?>
<!-- Spellbook is a Korean product: the editor shows its menus and dialogs in
     Korean whatever the browser's language. LibreOffice picks the interface
     language from Linguistic/General/UILocale (Setup/L10N/ooLocale only
     records the result). Text typed without a language of its own is Korean
     rather than the engine's Chinese fallback for East Asian text, which is
     what the server editor does too. Documents keep their own languages. -->
<oor:data xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:oor="http://openoffice.org/2001/registry">
  <dependency file="main"/>
  <oor:component-data oor:name="Linguistic" oor:package="org.openoffice.Office">
    <node oor:name="General">
      <prop oor:name="UILocale" oor:op="fuse">
        <value>ko</value>
      </prop>
      <prop oor:name="DefaultLocale_CJK" oor:op="fuse">
        <value>ko-KR</value>
      </prop>
    </node>
  </oor:component-data>
</oor:data>
