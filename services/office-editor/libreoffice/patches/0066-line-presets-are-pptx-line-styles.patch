 // box, closed or open.
+// A PowerPoint dash or line end, set the way PPTX import reads a:prstDash,
+// a:headEnd and a:tailEnd, as one attribute Undo step.
+void applySpellbookLinePreset(SvxShape& rShape, SdXImpressDocument* pModel,
+                              std::u16string_view rPropertyName, const cpo::uno::Any& rValue)
+{
+    OUString aPreset;
+    SdrObject* pObject = rShape.GetSdrObject();
+    SdDrawDocument* pDocument = pModel ? pModel->GetDoc() : nullptr;
+    if (!pObject || !pDocument || !(rValue >>= aPreset))
+        throw lang::IllegalArgumentException(u"Invalid line preset"_ustr, nullptr, 0);
+    // The Undo action records the attributes before the change; it is added
+    // only once the preset applied.
+    std::unique_ptr<SdrUndoAction> pUndo;
+    if (pDocument->IsUndoEnabled())
+        pUndo = pDocument->GetSdrUndoFactory().CreateUndoAttrObject(*pObject);
+    const uno::Reference<beans::XPropertySet> xShape(&rShape);
+    const uno::Reference<lang::XMultiServiceFactory> xModelFactory(pModel);
+    if (rPropertyName == u"SpellbookLineDash")
+        oox::drawingml::setPresetLineDash(xShape, xModelFactory, aPreset);
+    else
+        oox::drawingml::setPresetLineArrow(xShape, xModelFactory,
+                                           rPropertyName == u"SpellbookLineEndArrow", aPreset);
+    if (pUndo)
+        pDocument->AddUndo(std::move(pUndo));
+}
