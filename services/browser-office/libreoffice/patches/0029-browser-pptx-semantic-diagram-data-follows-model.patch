+// PPTX export writes the diagram data captured at import. Remember the model
+// as it was before the first semantic edit so that the export applies exactly
+// the changes made since then (DrawingML::WriteDiagram), and nothing when an
+// Undo has returned to it.
+void rememberSpellbookDiagramBaseline(SdrObject& rObject,
+                                      const svx::diagram::DiagramDataStatePtr& rState)
+{
+    if (!rState)
+        return;
+    uno::Any aGrabBag;
+    rObject.GetGrabBagItem(aGrabBag);
+    uno::Sequence<beans::PropertyValue> aEntries;
+    aGrabBag >>= aEntries;
+    for (const auto& rEntry : aEntries)
+        if (rEntry.Name == "SpellbookDiagramBaselinePoints")
+            return;
+    std::vector<beans::PropertyValue> aPoints;
+    for (const auto& rPoint : rState->getPoints())
+        aPoints.push_back(comphelper::makePropertyValue(
+            rPoint.msModelId, rPoint.msTextBody ? rPoint.msTextBody->msText : OUString()));
+    std::vector<OUString> aConnections;
+    for (const auto& rConnection : rState->getConnections())
+        if (!rConnection.msModelId.isEmpty())
+            aConnections.push_back(rConnection.msModelId);
+    std::vector<beans::PropertyValue> aNewEntries(aEntries.begin(), aEntries.end());
+    aNewEntries.push_back(comphelper::makePropertyValue(
+        u"SpellbookDiagramBaselinePoints"_ustr, comphelper::containerToSequence(aPoints)));
+    aNewEntries.push_back(comphelper::makePropertyValue(
+        u"SpellbookDiagramBaselineConnections"_ustr,
+        comphelper::containerToSequence(aConnections)));
+    rObject.SetGrabBagItem(uno::Any(comphelper::containerToSequence(aNewEntries)));
+}
