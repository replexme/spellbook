+test('download persistence resolves the public save promise with the exact downloaded PPTX', async ({ page }) => {
+  const failures = collectPageFailures(page);
+  await page.goto('/');
+  await page
+    .locator('#file-input')
+    .setInputFiles(path.resolve('public/fixtures/regressions/office-preview-showcase.pptx'));
+  await page.waitForFunction(
+    () => {
+      const api = (
+        window as Window & { __officeDemo?: { records: Array<{ instance: { getState: () => { status: string } } }> } }
+      ).__officeDemo;
+      return api?.records[0]?.instance.getState().status === 'ready';
+    },
+    null,
+    { timeout: 90_000 },
+  );
+  const downloaded = page.waitForEvent('download');
+  const saved = await page.evaluate(async () => {
+    const api = (
+      window as Window & {
+        __officeDemo?: { records: Array<{ instance: { save: (format: string) => Promise<File> } }> };
+      }
+    ).__officeDemo;
+    if (!api) throw new Error('Demo controller unavailable');
+    const file = await api.records[0].instance.save('PPTX');
+    const bytes = new Uint8Array(await file.arrayBuffer());
+    const hash = new Uint8Array(await crypto.subtle.digest('SHA-256', bytes));
+    return {
+      name: file.name,
+      size: file.size,
+      header: Array.from(bytes.slice(0, 4)),
+      hash: Array.from(hash)
+        .map((n) => n.toString(16).padStart(2, '0'))
+        .join(''),
+    };
+  });
+  const download = await downloaded;
+  const filePath = await download.path();
+  if (!filePath) throw new Error('Download has no readable artifact');
+  const bytes = await readFile(filePath);
+  const { createHash } = await import('node:crypto');
+  expect(saved.name).toBe(download.suggestedFilename());
+  expect(saved.size).toBe(bytes.length);
+  expect(saved.hash).toBe(createHash('sha256').update(bytes).digest('hex'));
+  expect(saved.header).toEqual([0x50, 0x4b, 0x03, 0x04]);
+  expect(failures).toEqual([]);
+});
