+    // EMF+ angles are clockwise in the SVG y-down plane. A complete ellipse
+    // needs two arcs because coincident SVG arc endpoints draw nothing.
+    static std::wstring CreateEmfPlusPiePath(double start, double sweep, const TEmfPlusRectF& rect)
+    {
+        if (!std::isfinite(start) || !std::isfinite(sweep) ||
+            !std::isfinite(rect.dX) || !std::isfinite(rect.dY) ||
+            !std::isfinite(rect.dWidth) || !std::isfinite(rect.dHeight) ||
+            rect.dWidth <= 0 || rect.dHeight <= 0 || sweep == 0) return L"";
+        sweep = std::max(-360., std::min(360., sweep));
+        const double radians = std::acos(-1.) / 180.;
+        const double rx = rect.dWidth / 2, ry = rect.dHeight / 2;
+        const double cx = rect.dX + rx, cy = rect.dY + ry;
+        const double angle = std::fmod(start, 360.) * radians;
+        const double sx = cx + rx * std::cos(angle), sy = cy + ry * std::sin(angle);
+        const auto point = [](double x, double y) { return ConvertToWString(x) + L"," + ConvertToWString(y); };
+        const std::wstring arc = L" A " + point(rx, ry) + L" 0 ";
+        const std::wstring direction = sweep > 0 ? L"1 " : L"0 ";
+        if (std::fabs(sweep) == 360.)
+            return L"M " + point(sx, sy) + arc + L"0 " + direction + point(2 * cx - sx, 2 * cy - sy) +
+                arc + L"0 " + direction + point(sx, sy) + L" Z";
+        const double end = angle + sweep * radians;
+        return L"M " + point(cx, cy) + L" L " + point(sx, sy) + arc +
+            (std::fabs(sweep) > 180 ? L"1 " : L"0 ") + direction +
+            point(cx + rx * std::cos(end), cy + ry * std::sin(end)) + L" Z";
+    }
