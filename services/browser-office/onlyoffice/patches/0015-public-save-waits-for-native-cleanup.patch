index 404324b..51f227b 100644
--- a/test/e2e/save.spec.ts
+++ b/test/e2e/save.spec.ts
@@ -313,3 +313,70 @@ test('download persistence resolves the public save promise with the exact downl
   expect(saved.header).toEqual([0x50, 0x4b, 0x03, 0x04]);
   expect(failures).toEqual([]);
 });
+
+test('public save waits for native cleanup before allowing the next save', async ({ page }) => {
+  const failures = collectPageFailures(page);
+  await page.goto('/save-e2e.html?scenario=local-file&type=pptx');
+  await waitForReady(page);
+  const host = page.frames().find((frame) => new URL(frame.url()).pathname === '/office-host.html');
+  expect(host).toBeTruthy();
+
+  // Hold the second read of the saved File: the first transports its bytes to
+  // the parent; the second updates the native snapshot after persistence ACK.
+  await host!.evaluate(() => {
+    const state = { entered: false, release: () => {} };
+    (window as Window & { __saveCleanupGate?: typeof state }).__saveCleanupGate = state;
+    const original = File.prototype.arrayBuffer;
+    const reads = new WeakMap<File, number>();
+    File.prototype.arrayBuffer = async function () {
+      const count = (reads.get(this) || 0) + 1;
+      reads.set(this, count);
+      if (count === 2) {
+        File.prototype.arrayBuffer = original;
+        await new Promise<void>((resolve) => {
+          state.release = resolve;
+          state.entered = true;
+        });
+      }
+      return original.call(this);
+    };
+  });
+  await page.evaluate(() => {
+    const api = window.__ONLYOFFICE_SAVE_E2E__!;
+    const state = { settled: false, promise: Promise.resolve<SaveE2EResult | null>(null) };
+    state.promise = api.save('pptx').then((result) => {
+      state.settled = true;
+      return result;
+    });
+    (window as Window & { __saveCleanupResult?: typeof state }).__saveCleanupResult = state;
+  });
+  try {
+    await host!.waitForFunction(
+      () => (window as Window & { __saveCleanupGate?: { entered: boolean } }).__saveCleanupGate?.entered,
+    );
+    expect((await getStatus(page)).writeCount).toBe(1);
+    // Cross a browser task boundary while the gate stays closed. A parent that
+    // resolves on ACK alone incorrectly reports success here.
+    const settled = await page.evaluate(async () => {
+      await new Promise<void>((resolve) => requestAnimationFrame(() => resolve()));
+      return (window as Window & { __saveCleanupResult?: { settled: boolean } }).__saveCleanupResult!.settled;
+    });
+    expect(settled).toBe(false);
+  } finally {
+    await host!.evaluate(() =>
+      (window as Window & { __saveCleanupGate?: { release: () => void } }).__saveCleanupGate!.release(),
+    );
+  }
+  const results = await page.evaluate(async () => {
+    const first = await (
+      window as Window & {
+        __saveCleanupResult?: { promise: Promise<SaveE2EResult> };
+      }
+    ).__saveCleanupResult!.promise;
+    const second = await window.__ONLYOFFICE_SAVE_E2E__!.save('pptx');
+    return [first, second];
+  });
+  expect(results.every((result) => result.size > 0)).toBe(true);
+  expect((await getStatus(page)).writeCount).toBe(2);
+  expect(failures).toEqual([]);
+});
