+CPPUNIT_TEST_FIXTURE(SdUiImpressTest, testSpellbookObjectTextAttributeUndoRestoresObjectItems)
+{
+    createSdImpressDocModelOnly();
+    uno::Reference<drawing::XDrawPagesSupplier> xPagesSupplier(mxComponent,
+                                                               uno::UNO_QUERY_THROW);
+    uno::Reference<drawing::XShapes> xShapes(xPagesSupplier->getDrawPages()->getByIndex(0),
+                                             uno::UNO_QUERY_THROW);
+    uno::Reference<lang::XMultiServiceFactory> xFactory(mxComponent, uno::UNO_QUERY_THROW);
+    uno::Reference<drawing::XShape> xShape(
+        xFactory->createInstance("com.sun.star.drawing.CustomShape"), uno::UNO_QUERY_THROW);
+    xShape->setPosition(awt::Point(1000, 1000));
+    xShape->setSize(awt::Size(10000, 3000));
+    xShapes->add(xShape);
+    uno::Reference<text::XText>(xShape, uno::UNO_QUERY_THROW)->setString("Object text");
+    uno::Reference<beans::XPropertySet> xProperties(xShape, uno::UNO_QUERY_THROW);
+    uno::Reference<beans::XPropertyState> xState(xShape, uno::UNO_QUERY_THROW);
+    CPPUNIT_ASSERT_EQUAL(beans::PropertyState_DEFAULT_VALUE,
+                         xState->getPropertyState("CharShadowed"));
+
+    // What a character attribute applied to the selected object records: one
+    // attribute Undo that also saves the text, then the item on the object.
+    SdrObject* pObject = SdrObject::getSdrObjectFromXShape(xShape);
+    CPPUNIT_ASSERT(dynamic_cast<SdrObjCustomShape*>(pObject));
+    SdrUndoAttrObj aUndo(*pObject, false, true);
+    SfxItemSetFixed<EE_CHAR_SHADOW, EE_CHAR_SHADOW> aShadow(
+        pObject->getSdrModelFromSdrObject().GetItemPool());
+    aShadow.Put(SvxShadowedItem(true, EE_CHAR_SHADOW));
+    pObject->SetMergedItemSetAndBroadcast(aShadow);
+    CPPUNIT_ASSERT(xProperties->getPropertyValue("CharShadowed").get<bool>());
+
+    // Undo copied the edited text's first-paragraph shadow back into the
+    // object before restoring the text, leaving a shadow no Undo removed.
+    aUndo.Undo();
+    CPPUNIT_ASSERT_EQUAL(beans::PropertyState_DEFAULT_VALUE,
+                         xState->getPropertyState("CharShadowed"));
+    CPPUNIT_ASSERT(!xProperties->getPropertyValue("CharShadowed").get<bool>());
+
+    aUndo.Redo();
+    CPPUNIT_ASSERT_EQUAL(beans::PropertyState_DIRECT_VALUE,
+                         xState->getPropertyState("CharShadowed"));
+    CPPUNIT_ASSERT(xProperties->getPropertyValue("CharShadowed").get<bool>());
+}
