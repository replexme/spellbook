+// SPDX-License-Identifier: AGPL-3.0-only
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import { createHash } from 'node:crypto';
+import { spawnSync } from 'node:child_process';
+
+test('stale rebuilt regression input cannot fall back to a valid warm SDK', () => {
+  const root = fs.mkdtempSync(path.join(os.tmpdir(), 'base-sdk-input-'));
+  try {
+    const relative = 'sdkjs/slide/sdk-all.js';
+    const warm = path.join(root, 'public', relative), rebuilt = path.join(root, '.temp/licensing/sdk-base-runtime', relative);
+    for (const file of [warm, rebuilt]) fs.mkdirSync(path.dirname(file), { recursive: true });
+    const valid = 'pinned SDK input'; fs.writeFileSync(warm, valid); fs.writeFileSync(rebuilt, 'stale rebuilt bytes');
+    fs.writeFileSync(path.join(root, 'runtime-source-lock.json'), JSON.stringify({ sdkRebuild: { baseOutputs: [{ path: relative, sha256: createHash('sha256').update(valid).digest('hex') }] } }));
+    const run = () => spawnSync(process.execPath, ['--input-type=module', '-e',
+      `import { readPinnedBaseSlideSdk } from ${JSON.stringify(new URL('./base-slide-sdk-test-input.mjs', import.meta.url).href)}; process.stdout.write(readPinnedBaseSlideSdk());`],
+      { cwd: root, encoding: 'utf8', env: { ...process.env, ONLYOFFICE_LICENSE_MATERIALS_DIR: path.join(root, '.temp/licensing') } });
+    const stale = run(); assert.notEqual(stale.status, 0); assert.match(stale.stderr, /exact pinned pre-patch/);
+    fs.writeFileSync(rebuilt, valid); fs.writeFileSync(warm, 'wrong warm bytes');
+    const verified = run(); assert.equal(verified.status, 0); assert.equal(verified.stdout, valid);
+  } finally { fs.rmSync(root, { recursive: true, force: true }); }
+});
