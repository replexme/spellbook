diff --git a/test/unit/native-save-identity.test.ts b/test/unit/native-save-identity.test.ts
new file mode 100644
index 0000000..2dbcb63
--- /dev/null
+++ b/test/unit/native-save-identity.test.ts
@@ -0,0 +1,59 @@
+import { describe, expect, it } from 'vitest';
+import { nativeSaveContentIdentity } from '../../src/lib/native-save-identity';
+
+function native(clock: string, title = 'Title', created = '2020-01-01T00:00:00Z') {
+  const string = (tag: number, value: string) => {
+    const result = new Uint8Array(5 + value.length * 2);
+    const view = new DataView(result.buffer);
+    result[0] = tag;
+    view.setUint32(1, value.length, true);
+    for (let i = 0; i < value.length; i++) view.setUint16(5 + i * 2, value.charCodeAt(i), true);
+    return result;
+  };
+  const fields = [string(0, title), string(4, created), string(5, clock)];
+  const size = fields.reduce((n, bytes) => n + bytes.length, 0);
+  const result = new Uint8Array(161 + 5 + 1 + size + 1 + 4);
+  result.set(new TextEncoder().encode('PPTY;v10;0;'));
+  result[11] = 2;
+  const view = new DataView(result.buffer);
+  view.setUint32(12, 161, true);
+  result[161] = 2;
+  view.setUint32(162, 1 + size + 1, true);
+  result[166] = 250;
+  let at = 167;
+  for (const field of fields) { result.set(field, at); at += field.length; }
+  result[at] = 251;
+  result.set([1, 2, 3, 4], at + 1); // unrelated document bytes
+  return result;
+}
+
+describe('pinned presentation native export identity', () => {
+  it('ignores only the generated clock in both binary and base64 input, without modifying either', () => {
+    const first = native('2026-10-01T01:01:01Z');
+    const later = native('2026-10-01T01:02:02Z');
+    const original = first.slice();
+    const encoded = new TextEncoder().encode(btoa(String.fromCharCode(...later)));
+    expect(nativeSaveContentIdentity(first)).toEqual(nativeSaveContentIdentity(encoded));
+    expect(first).toEqual(original);
+  });
+  it('retains authored title, creation date and unrelated native bytes', () => {
+    const first = native('2026-10-01T01:01:01Z');
+    for (const different of [
+      native('2026-10-01T01:02:02Z', 'Other'),
+      native('2026-10-01T01:02:02Z', 'Title', '2021-01-01T00:00:00Z'),
+    ]) expect(nativeSaveContentIdentity(first)).not.toEqual(nativeSaveContentIdentity(different));
+    const changed = first.slice(); changed[changed.length - 1]++;
+    expect(nativeSaveContentIdentity(first)).not.toEqual(nativeSaveContentIdentity(changed));
+  });
+  it('rejects unknown presentation versions, attributes and malformed clock/record lengths', () => {
+    const version = native('2026-10-01T01:01:01Z'); version[7] = 49;
+    const attribute = native('2026-10-01T01:01:01Z'); attribute[167] = 9;
+    const length = native('2026-10-01T01:01:01Z'); new DataView(length.buffer).setUint32(162, 0xffffffff, true);
+    for (const bytes of [version, attribute, length, native('2026-99-01T01:01:01Z')])
+      expect(() => nativeSaveContentIdentity(bytes)).toThrow();
+  });
+  it('keeps non-presentation binary evidence exact', () => {
+    const bytes = new Uint8Array([9, 8, 7]);
+    expect(nativeSaveContentIdentity(bytes)).toEqual(bytes);
+  });
+});
