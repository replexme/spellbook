+++ b/scripts/runtime-compressed-assets.mjs
@@ -0,0 +1,43 @@
+// SPDX-License-Identifier: AGPL-3.0-only
+import fs from 'node:fs';
+import path from 'node:path';
+import { brotliCompressSync, brotliDecompressSync, constants } from 'node:zlib';
+
+export const compressRuntimeAsset = (bytes) =>
+  brotliCompressSync(bytes, {
+    params: { [constants.BROTLI_PARAM_QUALITY]: 11, [constants.BROTLI_PARAM_LGWIN]: 22 },
+  });
+
+export function syncRuntimeCompressedAssets(root) {
+  let pairs = 0,
+    updated = 0;
+  const walk = (directory) => {
+    for (const entry of fs.readdirSync(directory, { withFileTypes: true })) {
+      const file = path.join(directory, entry.name);
+      if (entry.isDirectory()) walk(file);
+      else if (!entry.isFile()) throw new Error('Non-file compressed runtime input: ' + file);
+      else if (entry.name.endsWith('.br')) {
+        const plain = file.slice(0, -3);
+        if (!fs.existsSync(plain) || !fs.lstatSync(plain).isFile())
+          throw new Error('Compressed asset lacks a regular plain counterpart: ' + file);
+        const bytes = fs.readFileSync(plain);
+        // UI compression is reproduced with the same canonical encoder as its
+        // preferred-source build. Other components retain an equal encoding.
+        const previous = fs.readFileSync(file);
+        const encoded = path.relative(root, file).startsWith('web-apps' + path.sep)
+          ? compressRuntimeAsset(bytes)
+          : brotliDecompressSync(previous).equals(bytes)
+            ? previous
+            : compressRuntimeAsset(bytes);
+        if (!brotliDecompressSync(encoded).equals(bytes)) throw new Error('Invalid compressed runtime output: ' + file);
+        if (!previous.equals(encoded)) {
+          fs.writeFileSync(file, encoded);
+          updated++;
+        }
+        pairs++;
+      }
+    }
+  };
+  walk(root);
+  return { pairs, updated };
+}
