diff --git a/vcl/qt5/QtGraphics_Text.cxx b/vcl/qt5/QtGraphics_Text.cxx
--- a/vcl/qt5/QtGraphics_Text.cxx
+++ b/vcl/qt5/QtGraphics_Text.cxx
@@ -39,6 +39,8 @@
 
 #ifdef EMSCRIPTEN
 #include <set>
+#include <QtGui/QFont>
+#include <QtWidgets/QApplication>
 #endif
 
 void QtGraphics::SetTextColor(Color nColor) { m_aTextColor = nColor; }
@@ -128,6 +130,36 @@ void QtGraphics::GetDevFontList(vcl::font::PhysicalFontCollection* pPFC)
 #endif
     }
 
+#ifdef EMSCRIPTEN
+    // Spellbook: Qt draws the menu bar and its own widgets with the
+    // application font and, in WebAssembly, falls back only to the fonts it
+    // bundles, none of which has Korean, Japanese or Chinese glyphs, so a
+    // Korean interface showed empty boxes. Let the application font fall back
+    // to a font registered above for each of those scripts, whatever the
+    // interface language; QApplication also updates widgets that exist.
+    {
+        QFont aFont = QApplication::font();
+        QStringList aFamilies = aFont.families();
+        if (aFamilies.isEmpty())
+            aFamilies.append(aFont.family());
+        const QStringList aOriginalFamilies = aFamilies;
+        const QFontDatabase aDatabase;
+        for (const QFontDatabase::WritingSystem eSystem :
+             { QFontDatabase::Korean, QFontDatabase::Japanese, QFontDatabase::SimplifiedChinese,
+               QFontDatabase::TraditionalChinese })
+        {
+            const QStringList aCandidates = aDatabase.families(eSystem);
+            if (!aCandidates.isEmpty() && !aFamilies.contains(aCandidates.first()))
+                aFamilies.append(aCandidates.first());
+        }
+        if (aFamilies != aOriginalFamilies)
+        {
+            aFont.setFamilies(aFamilies);
+            QApplication::setFont(aFont);
+        }
+    }
+#endif
+
     if (bUseFontconfig)
         SalGenericInstance::RegisterFontSubstitutors(pPFC);
 
