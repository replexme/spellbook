+CPPUNIT_TEST_FIXTURE(SdUiImpressTest, testSpellbookPptxDiagramFrameKeepsShapeIdentity)
+{
+    createSdImpressDocModelOnly("pptx/smartart-children.pptx");
+    const auto diagram = [this]() {
+        auto pDocument = dynamic_cast<SdXImpressDocument*>(mxComponent.get());
+        CPPUNIT_ASSERT(pDocument);
+        SdrObject* pDiagram = pDocument->GetDoc()->GetSdPage(0, PageKind::Standard)->GetObj(0);
+        CPPUNIT_ASSERT(pDiagram);
+        CPPUNIT_ASSERT(pDiagram->isDiagram());
+        return pDiagram;
+    };
+    uno::Reference<beans::XPropertySet> xProperties(diagram()->getUnoShape(),
+                                                    uno::UNO_QUERY_THROW);
+    xProperties->setPropertyValue("Name", uno::Any(u"Reporting lines"_ustr));
+    xProperties->setPropertyValue("Title", uno::Any(u"Team"_ustr));
+    xProperties->setPropertyValue("Description", uno::Any(u"Who reports to whom"_ustr));
+
+    // The frame was written as "Diagram1" with id 1, the shape tree's own id,
+    // and without its alternative text.
+    saveAndReloadSdImpressDocModelOnly(u"Impress Office Open XML"_ustr);
+    xmlDocUniquePtr pSlideXml = parseExport("ppt/slides/slide1.xml");
+    assertXPath(pSlideXml, "//p:graphicFrame/p:nvGraphicFramePr/p:cNvPr", "name",
+                u"Reporting lines"_ustr);
+    assertXPath(pSlideXml, "//p:graphicFrame/p:nvGraphicFramePr/p:cNvPr", "title",
+                u"Team"_ustr);
+    assertXPath(pSlideXml, "//p:graphicFrame/p:nvGraphicFramePr/p:cNvPr", "descr",
+                u"Who reports to whom"_ustr);
+    assertXPath(pSlideXml, "//p:cNvPr[@id='1']", 1);
+    CPPUNIT_ASSERT_EQUAL(u"Reporting lines"_ustr, diagram()->GetName());
+}
