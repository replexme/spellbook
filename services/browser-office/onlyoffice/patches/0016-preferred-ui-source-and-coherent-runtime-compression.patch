+++ b/scripts/ui-rebuild-evidence.mjs
@@ -0,0 +1,59 @@
+// SPDX-License-Identifier: AGPL-3.0-only
+export const uiBuildInputPaths = () => [
+  'runtime-source-lock.json',
+  'scripts/rebuild-preferred-ui.mjs',
+  'scripts/ui-rebuild-evidence.mjs',
+  'scripts/patch-preferred-ui-source.mjs',
+  'scripts/patch-onlyoffice-print-fallback.mjs',
+  'scripts/runtime-compressed-assets.mjs',
+  'scripts/build-onlyoffice-runtime-assets.mjs',
+  'source-overrides/browser-api.js',
+  'source-overrides/main-application-bootstrap.html',
+];
+export function verifyUiRebuildEvidence(lock, evidence, currentInputs, currentOutputs) {
+  const source = lock.sources.find((value) => value.id === lock.uiRebuild?.sourceId);
+  if (
+    !source ||
+    evidence?.schemaVersion !== 1 ||
+    evidence.status !== 'deployed-ui-assets-reproduced' ||
+    evidence.sourceCommit !== source.commit ||
+    evidence.sourceArchiveSha256 !== source.archiveSha256
+  )
+    throw new Error('Matching preferred-source UI rebuild evidence required');
+  const dependencies = lock.uiRebuild.dependencySourceIds.map((id) => lock.sources.find((source) => source.id === id));
+  if (
+    evidence.dependencies?.length !== dependencies.length ||
+    dependencies.some(
+      (source) =>
+        !source ||
+        evidence.dependencies.filter((value) => value.id === source.id && value.archiveSha256 === source.archiveSha256)
+          .length !== 1,
+    )
+  )
+    throw new Error('Matching UI dependency source archives required');
+  const paths = uiBuildInputPaths();
+  for (const inputs of [evidence.buildInputs, currentInputs])
+    if (inputs?.length !== paths.length || new Set(inputs.map((file) => file.path)).size !== paths.length)
+      throw new Error('Complete UI build source identity required');
+  for (const name of paths) {
+    const original = evidence.buildInputs.find((file) => file.path === name);
+    const current = currentInputs.find((file) => file.path === name);
+    if (!original || !current || original.sha256 !== current.sha256)
+      throw new Error('UI build source changed: ' + name);
+  }
+  const outputs = evidence.outputs;
+  if (
+    !currentOutputs?.length ||
+    outputs?.length !== currentOutputs.length ||
+    new Set(outputs.map((file) => file.path)).size !== outputs.length ||
+    new Set(currentOutputs.map((file) => file.path)).size !== currentOutputs.length
+  )
+    throw new Error('Complete deployed UI output identity required');
+  for (const file of currentOutputs) {
+    if (!file.path.startsWith('web-apps/')) throw new Error('Unexpected UI output path');
+    const rebuilt = outputs.find((value) => value.path === file.path);
+    if (rebuilt?.exactMatch !== true || rebuilt.sha256 !== file.sha256)
+      throw new Error('UI rebuild output mismatch: ' + file.path);
+  }
+  return { uiAssetRebuildVerified: true, upstreamEditorRebuildVerified: false };
+}
